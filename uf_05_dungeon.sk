# ============================================================
# uf_05_dungeon.sk : 15号館ダンジョン（2階〜9階を通しで進む）
#
# 流れ（1 回の挑戦 = 1 回の「通し」）
#   1 階の受付で開始する階を選ぶ（最初は 2 階。以後は突破した階の次の階からも選べる）
#   偶数階は西の階段から入って東の階段へ、奇数階は東の階段から入って西の階段へ進む
#   → 階の途中の「中ボスの壁」（泣く黒曜石）をクリック → 全員が上空の中ボス闘技場へ
#   → 勝つとそれぞれ元の場所に戻り、中ボスの壁が消える
#   → 出口側の上り階段をふさぐ「ボスの壁」（強化深層岩）をクリック → 全員がボス闘技場へ
#   → 勝つと突破報酬・次の階の解放。元の場所に戻り、階段の壁が消える
#   → 階段を歩いて上り、次の階のフロアに入るとその階が始まる（9 階のボスで制覇 → 1 階へ）
#   使わない側の上り階段は白コンクリートでずっとふさいである（別の階段から先へ進めないように）
#   全員が倒れる（全滅）・時間切れ・全員不在で、その回の挑戦は終了して 1 階へ戻る。
#   解放と、それまでに得た報酬は残る。
#   1 つの階を同時に使えるのは 1 パーティーだけ（闘技場も階ごとに別）。
#   上の階がほかのパーティーで使用中なら、階段の壁は空くまで開かない。
#
# 保存される変数
#   {uf::unlock::<uuid>}            挑戦を始められる最上階（初期値 2）
#   {uf::clear::<uuid>::<階>}       初回クリア済み（初回報酬の二重取得防止）
#   {uf::floor::<階>::start|cp|p1|p2}            開始・復帰地点、フロアの範囲
#   {uf::gatecells::<階>::mid|exit|block::*}      壁（ゲート）のブロックの場所 / {uf::gatekind::<場所>} 逆引き
#   {uf::gatestate::<階>::<種類>} / {uf::gateorig::<場所>}  開閉状態と、ふさぐ前のブロック
#   {uf::floor::<階>::marena::player|boss}       中ボス闘技場（入口・中ボスの出現地点）
#   {uf::floor::<階>::barena::player|boss}       ボス闘技場（入口・ボスの出現地点）
#   {uf::floor::<階>::spawn::*} / {uf::floor::<階>::chest::*}
#   闘技場が未設定のときは、フロアの {uf::floor::<階>::mid|boss} で戦う
# メモリのみ
#   {-uf::sess::<階>::...}   挑戦中のセッション（phase: explore / mid / midwin / boss / bosswin / waiting / cleared）
#   {-uf::insess::<uuid>}    挑戦中の階
#   {-uf::down::<uuid>}      倒れている（蘇生待ち）
#   {-uf::tolobby::<uuid>}   復活したら 1 階へ戻す
# ============================================================

function uf_unlock(p: player) :: number:
    set {_v} to {uf::unlock::%uuid of {_p}%}
    if {_v} is not set:
        return 2
    return {_v}

function uf_bossname(f: number) :: text:
    if {_f} is 2:
        return "&4◆ 受付に残る影"
    if {_f} is 3:
        return "&4◆ 図書の番人"
    if {_f} is 4:
        return "&4◆ 実験室の異形"
    if {_f} is 5:
        return "&4◆ サーバールームの主"
    if {_f} is 6:
        return "&4◆ 非常階段の門番"
    if {_f} is 7:
        return "&4◆ 影の教授"
    if {_f} is 8:
        return "&4◆ 忘れられた研究者"
    return "&4◆ 15号館の主"

# ------------------------------------------------------------
# 受付（フロアマップ右クリック または /dungeon）
# ------------------------------------------------------------
command /dungeon [<text>]:
    description: ダンジョンの受付（leave で退出）
    aliases: /dg
    executable by: players
    trigger:
        if uf_on("dungeon") is false:
            uf_msg(player, "&cダンジョンは現在停止中です")
            stop
        if arg-1 is "leave":
            uf_dleave(player)
            stop
        uf_floorgui(player)

on right click:
    uf_id(player's tool) is "map"
    cancel event
    if uf_on("dungeon") is false:
        uf_msg(player, "&cダンジョンは現在停止中です")
        stop
    uf_floorgui(player)

function uf_floorgui(p: player):
    set {_g} to chest inventory with 3 rows named "&8受付：開始する階を選ぶ"
    uf_guiclear({_p})
    set {_u} to uuid of {_p}
    loop integers between 2 and 9:
        set {_f} to loop-value
        set {_s} to {_f} + 8
        delete {_lore::*}
        if {uf::floor::%{_f}%::start} is not set:
            set {_icon} to gray stained glass pane
            add "&8準備中" to {_lore::*}
        else if {_f} > uf_unlock({_p}):
            set {_icon} to iron bars
            add "&c%{_f} - 1%階を突破すると、ここから始められる" to {_lore::*}
        else:
            set {_icon} to oak door
            if {uf::clear::%{_u}%::%{_f}%} is true:
                add "&a突破済み" to {_lore::*}
            add "&7ここから始めて、9階まで上へ進む" to {_lore::*}
            if {-uf::sess::%{_f}%::on} is true:
                add "&c現在ほかのパーティーが挑戦中" to {_lore::*}
            else:
                add "&eクリックで%{_f}%階から挑戦" to {_lore::*}
        set slot {_s} of {_g} to ({_icon} named "&f%{_f}%階から") with lore {_lore::*}
        set {-uf::guictx::%{_u}%::%{_s}%} to {_f}
    if {-uf::insess::%{_u}%} is set:
        set slot 22 of {_g} to barrier named "&cダンジョンから退出する"
    uf_gui({_p}, "floor", {_g})

on inventory click:
    {-uf::gui::%uuid of player%} is "floor"
    cancel event
    event-inventory is {-uf::guiinv::%uuid of player%}
    set {_s} to index of event-slot
    if {_s} is 22:
        wait 1 tick
        close inventory of player
        uf_dleave(player)
        stop
    set {_f} to {-uf::guictx::%uuid of player%::%{_s}%}
    {_f} is set
    wait 1 tick
    close inventory of player
    uf_dstart(player, {_f})

# ------------------------------------------------------------
# 挑戦の開始（受付）と、各階の開始
# ------------------------------------------------------------
function uf_dstart(p: player, f: number):
    if uf_on("dungeon") is false:
        stop
    # 受付の区域の中か、受付の NPC に話しかけてから 3 分以内（uf_17_npc.sk）
    if uf_canuse({_p}, "reception") is false:
        uf_msg({_p}, "&cダンジョンへの挑戦は 1 階の受付で行ってください")
        stop
    if {uf::floor::%{_f}%::start} is not set:
        uf_msg({_p}, "&cこの階は準備中です")
        stop
    if size of {uf::floor::%{_f}%::spawn::*} < 1:
        uf_msg({_p}, "&cこの階は準備中です（敵の出現地点が未設定）")
        stop
    if {-uf::insess::%uuid of {_p}%} is set:
        uf_msg({_p}, "&cすでにダンジョンに挑戦中です（/dungeon leave で退出）")
        stop
    if {-uf::sess::%{_f}%::on} is true:
        uf_msg({_p}, "&cこの階は現在ほかのパーティーが挑戦中です")
        stop
    if uf_isleader({_p}) is false:
        uf_msg({_p}, "&c挑戦を開始できるのはパーティーリーダーだけです")
        stop
    set {_mem::*} to uf_members({_p})
    loop {_mem::*}:
        if loop-value is not online:
            uf_msg({_p}, "&cオフラインのメンバーがいます")
            stop
        if uf_unlock(loop-value) < {_f}:
            uf_msg({_p}, "&c%loop-value% はまだ %{_f}%階 から始められません")
            stop
        if {-uf::insess::%uuid of loop-value%} is set:
            uf_msg({_p}, "&c%loop-value% はすでに挑戦中です")
            stop
    uf_log("dungeon", "run start f=%{_f}% leader=%{_p}% members=%{_mem::*}%")
    uf_dbegin({_f}, {_mem::*})

# 階を始める
#   teleport = true : 受付から（全員を開始地点へ）
#   teleport = false: 階段を上って来た（まだ前の階にいる人だけ開始地点へ合流させる）
function uf_dbegin(f: number, mem: players, teleport: boolean = true):
    set {-uf::sess::%{_f}%::on} to true
    set {-uf::sess::%{_f}%::phase} to "explore"
    delete {-uf::sess::%{_f}%::middone}
    set {-uf::sess::%{_f}%::t0} to {-uf::tick}
    set {-uf::sess::%{_f}%::tphase} to {-uf::tick}
    set {-uf::sess::%{_f}%::seen} to {-uf::tick}
    set {-uf::sess::%{_f}%::alive} to 0
    uf_gateclose({_f}, "mid")
    uf_gateclose({_f}, "exit")
    loop {_mem::*}:
        if loop-value is online:
            set {-uf::sess::%{_f}%::mem::%uuid of loop-value%} to loop-value
            set {-uf::insess::%uuid of loop-value%} to {_f}
            delete {-uf::down::%uuid of loop-value%}
            if {_teleport} is true:
                teleport loop-value to {uf::floor::%{_f}%::start}
            else if uf_inbox(location of loop-value, {uf::floor::%{_f}%::p1}, {uf::floor::%{_f}%::p2}) is false:
                teleport loop-value to {uf::floor::%{_f}%::start}
                uf_msg(loop-value, "&7パーティーに合流しました")
            send title "&c%{_f}%階" with subtitle "&7中ボスの壁を突破し、反対側の階段を目指せ" to loop-value for 3 seconds
    uf_log("dungeon", "floor start f=%{_f}%")
    uf_placechests({_f})
    uf_spawnwave({_f})

# 階ごとの出現数（/ufd count で上書き可能）
function uf_dcount(f: number, tier: text) :: number:
    set {_v} to {uf::floor::%{_f}%::count::%{_tier}%}
    if {_v} is set:
        return {_v}
    if {_tier} is "normal":
        return 4 + {_f}
    if {_tier} is "strong":
        return {_f} - 1
    if {_tier} is "elite":
        return floor({_f} / 3)
    return 0

function uf_spawnwave(f: number):
    loop "normal", "strong" and "elite":
        set {_tier} to loop-value
        loop uf_dcount({_f}, {_tier}) times:
            set {_l} to random element out of {uf::floor::%{_f}%::spawn::*}
            uf_spawnmob({_f}, {_tier}, {_l})

# 敵の顔ぶれ・見た目・技は uf_18_mobs.sk（uf_mobmake）
#   tier: normal / strong / elite（フロアの敵）、mid / boss、minion（ボスが呼ぶ手下。全滅の数には入れない）
function uf_spawnmob(f: number, tier: text, l: location):
    set {_e} to uf_mobmake({_f}, {_tier}, {_l})
    set metadata value "uf_tier" of {_e} to {_tier}
    set metadata value "uf_floor" of {_e} to {_f}
    add 1 to {-uf::mobseq}
    set metadata value "uf_mid" of {_e} to {-uf::mobseq}
    add {_e} to {-uf::sess::%{_f}%::mobs::*}
    if {_tier} is "normal" or "strong" or "elite":
        add 1 to {-uf::sess::%{_f}%::alive}
    else if {_tier} is "minion":
        add 1 to {-uf::sess::%{_f}%::minions}
    else:
        uf_bbstart({_f}, {_e}, {_tier})

function uf_dloc(f: number, k: text) :: location:
    if {uf::floor::%{_f}%::%{_k}%} is set:
        return {uf::floor::%{_f}%::%{_k}%}
    return random element out of {uf::floor::%{_f}%::spawn::*}

function uf_dsay(f: number, t: text):
    loop {-uf::sess::%{_f}%::mem::*}:
        if loop-value is online:
            send title " " with subtitle colored {_t} to loop-value for 2 seconds
            uf_msg(loop-value, {_t})

function uf_dsetphase(f: number, ph: text):
    set {-uf::sess::%{_f}%::phase} to {_ph}
    set {-uf::sess::%{_f}%::tphase} to {-uf::tick}

# 挑戦中のメンバー全員を移動させる（倒れている人も一緒に移動し、蘇生待ちは解除）
function uf_dmoveall(f: number, l: location):
    loop {-uf::sess::%{_f}%::mem::*}:
        set {_p} to loop-value
        if {_p} is online:
            if {_p} is alive:
                uf_soulclear({_p})
                delete {-uf::down::%uuid of {_p}%}
                teleport {_p} to {_l}

# ------------------------------------------------------------
# 壁（ゲート）
#   mid   = 階の途中にある中ボスの壁（クリック → 中ボス闘技場 → 勝つと消える）
#   exit  = 出口側の上り階段をふさぐボスの壁（中ボスを倒した後にクリック → ボス闘技場 → 勝つと階段が戻る）
#   block = 使わない上り階段をふさぐ壁（ずっと閉じたまま）
#   閉じるときに元のブロックを {uf::gateorig::<場所>} に保存し、開くときに戻す
# ------------------------------------------------------------
function uf_gateblock(kind: text) :: item:
    if {_kind} is "mid":
        return crying obsidian
    if {_kind} is "exit":
        return reinforced deepslate
    return white concrete

function uf_gateclose(f: number, kind: text):
    if {uf::gatestate::%{_f}%::%{_kind}%} is "closed":
        stop
    set {_b} to uf_gateblock({_kind})
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        set {_k} to uf_lockey(loop-value)
        if block at loop-value is not {_b}:
            set {uf::gateorig::%{_k}%} to "%block data of block at loop-value%"
        set block at loop-value to {_b}
    set {uf::gatestate::%{_f}%::%{_kind}%} to "closed"

function uf_gateopen(f: number, kind: text):
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        set {_k} to uf_lockey(loop-value)
        if {uf::gateorig::%{_k}%} is set:
            set block at loop-value to ({uf::gateorig::%{_k}%} parsed as block data)
        else:
            set block at loop-value to air
    set {uf::gatestate::%{_f}%::%{_kind}%} to "open"

# 壁のそばに人がいるか（閉じるときに人を埋めないため）
function uf_gatenear(f: number, kind: text) :: boolean:
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        loop all players:
            if "%world of loop-player%" is "%world of loop-value-1%":
                if distance between loop-player and loop-value-1 < 2.5:
                    return true
    return false

on click on crying obsidian or reinforced deepslate or white concrete:
    set {_g} to {uf::gatekind::%uf_lockey(location of event-block)%}
    {_g} is set
    cancel event
    set {_x::*} to split {_g} at ":"
    set {_f} to {_x::1} parsed as number
    set {_kind} to {_x::2}
    if {_kind} is "block":
        uf_msg(player, "&7この階段は崩れていて通れない。反対側の階段を探そう")
        stop
    if uf_on("dungeon") is false:
        stop
    if {-uf::sess::%{_f}%::mem::%uuid of player%} is not set:
        uf_msg(player, "&cこの壁は、挑戦中のパーティーだけが調べられる。1 階の受付から挑戦しよう")
        stop
    set {_ph} to {-uf::sess::%{_f}%::phase}
    if {_kind} is "mid":
        if {_ph} is "explore":
            if {-uf::sess::%{_f}%::middone} is not true:
                uf_dmidstart({_f})
    else if {_kind} is "exit":
        if {-uf::sess::%{_f}%::middone} is not true:
            uf_msg(player, "&7固く閉ざされている…。この階の途中にある中ボスの壁を先に突破しよう")
        else if {_ph} is "explore":
            uf_dbossstart({_f})
        else if {_ph} is "waiting":
            uf_msg(player, "&e上の階はほかのパーティーが挑戦中。空くまで待とう")

# 壁は壊せない
on break:
    {uf::gatekind::%uf_lockey(location of event-block)%} is set
    cancel event

# 戻り先として、全員の今いる場所を覚える
function uf_dsaveret(f: number):
    loop {-uf::sess::%{_f}%::mem::*}:
        if loop-value is online:
            if loop-value is alive:
                set {-uf::sess::%{_f}%::ret::%uuid of loop-value%} to location of loop-value

# 全員を覚えておいた場所へ戻す（覚えていなければ開始地点）
function uf_dreturnall(f: number):
    loop {-uf::sess::%{_f}%::mem::*}:
        set {_p} to loop-value
        if {_p} is online:
            if {_p} is alive:
                uf_soulclear({_p})
                set {_r} to {-uf::sess::%{_f}%::ret::%uuid of {_p}%}
                if {_r} is set:
                    teleport {_p} to {_r}
                else:
                    teleport {_p} to {uf::floor::%{_f}%::start}
    delete {-uf::sess::%{_f}%::ret::*}

# ------------------------------------------------------------
# 中ボス戦（中ボスの壁をクリック）
# ------------------------------------------------------------
function uf_dmidstart(f: number):
    if {-uf::sess::%{_f}%::phase} is not "explore":
        stop
    uf_dsetphase({_f}, "mid")
    uf_dsaveret({_f})
    uf_dsay({_f}, "&6壁の向こうから何かが来る…！")
    if {uf::floor::%{_f}%::marena::player} is set:
        uf_dmoveall({_f}, {uf::floor::%{_f}%::marena::player})
        uf_spawnmob({_f}, "mid", {uf::floor::%{_f}%::marena::boss})
    else:
        uf_spawnmob({_f}, "mid", uf_dloc({_f}, "mid"))
    uf_log("dungeon", "mid start f=%{_f}%")

function uf_dmidwin(f: number):
    if {-uf::sess::%{_f}%::phase} is not "mid":
        stop
    set {-uf::sess::%{_f}%::middone} to true
    uf_dsetphase({_f}, "midwin")
    uf_dsay({_f}, "&a中ボス撃破！ まもなく元の場所に戻ります")
    wait 3 seconds
    uf_dmidreturn({_f})

function uf_dmidreturn(f: number):
    if {-uf::sess::%{_f}%::phase} is not "midwin":
        stop
    uf_dsetphase({_f}, "explore")
    if {uf::floor::%{_f}%::marena::player} is set:
        uf_dreturnall({_f})
    uf_gateopen({_f}, "mid")
    uf_dsay({_f}, "&a中ボスの壁が消えた！ 階段の壁を目指せ")

# ------------------------------------------------------------
# ボス戦（中ボスを倒した後、出口側の階段の壁をクリック）
# ------------------------------------------------------------
function uf_dbossstart(f: number):
    if {-uf::sess::%{_f}%::phase} is not "explore":
        stop
    if {-uf::sess::%{_f}%::middone} is not true:
        stop
    uf_dsetphase({_f}, "boss")
    uf_dsaveret({_f})
    uf_dsay({_f}, "&4%uncolored uf_bossname({_f})% が現れた！")
    if {uf::floor::%{_f}%::barena::player} is set:
        uf_dmoveall({_f}, {uf::floor::%{_f}%::barena::player})
        uf_spawnmob({_f}, "boss", {uf::floor::%{_f}%::barena::boss})
    else:
        uf_spawnmob({_f}, "boss", uf_dloc({_f}, "boss"))
    uf_log("dungeon", "boss start f=%{_f}%")

function uf_dbosswin(f: number):
    if {-uf::sess::%{_f}%::phase} is not "boss":
        stop
    uf_dsetphase({_f}, "bosswin")
    uf_log("dungeon", "clear f=%{_f}%")
    loop {-uf::sess::%{_f}%::mem::*}:
        set {_p} to loop-value
        if {_p} is online:
            if {-uf::sess::%{_f}%::active::%uuid of {_p}%} is true:
                uf_dreward({_p}, {_f})
            else:
                uf_msg({_p}, "&7戦闘への参加が確認できなかったため、突破報酬はありません")
    if {_f} < 9:
        uf_dsay({_f}, "&a%{_f}%階 突破！ まもなく元の場所に戻ります")
    else:
        uf_dsay({_f}, "&615号館 制覇！ おめでとう！")
    wait 3 seconds
    uf_dbossreturn({_f})

function uf_dbossreturn(f: number):
    if {-uf::sess::%{_f}%::phase} is not "bosswin":
        stop
    if {_f} >= 9:
        uf_dsetphase({_f}, "cleared")
        uf_dend({_f}, "complete")
        stop
    if {uf::floor::%{_f}%::barena::player} is set:
        uf_dreturnall({_f})
    uf_dopenexit({_f})

# 次の階が空いていれば階段の壁を開ける。使用中なら待つ（定期チェックで再試行）
function uf_dopenexit(f: number):
    set {_nf} to {_f} + 1
    if {uf::floor::%{_nf}%::start} is not set:
        uf_dsay({_f}, "&e%{_nf}%階は準備中です。ここで挑戦を終了します")
        uf_dend({_f}, "nextnotready")
        stop
    if {-uf::sess::%{_nf}%::on} is true:
        if {-uf::sess::%{_f}%::phase} is not "waiting":
            uf_dsetphase({_f}, "waiting")
            uf_dsay({_f}, "&e%{_nf}%階はほかのパーティーが挑戦中。空き次第、階段の壁が開きます")
        stop
    uf_gateopen({_f}, "exit")
    uf_dsetphase({_f}, "cleared")
    uf_dsay({_f}, "&a階段の壁が消えた！ 階段を上って%{_nf}%階へ進め")

# 次の階のフロアに誰かが入ったら、その階を始める（遅れている人は合流させる）
function uf_dadvance(f: number):
    if {-uf::sess::%{_f}%::phase} is not "cleared":
        stop
    set {_nf} to {_f} + 1
    if {-uf::sess::%{_nf}%::on} is true:
        stop
    loop {-uf::sess::%{_f}%::mem::*}:
        if loop-value is online:
            add loop-value to {_mem::*}
    uf_dend({_f}, "advance", false)
    if size of {_mem::*} > 0:
        uf_dbegin({_nf}, {_mem::*}, false)

function uf_dreward(p: player, f: number):
    set {_u} to uuid of {_p}
    set {_pt} to {uf::cfg::clear_pt::%{_f}%}
    if {uf::clear::%{_u}%::%{_f}%} is not true:
        # 先にフラグを立ててから渡す（二重取得防止）
        set {uf::clear::%{_u}%::%{_f}%} to true
        uf_addpt({_p}, {_pt}, "firstclear:%{_f}%")
        if {_f} is 2:
            uf_give({_p}, uf_item("heal_kit"), 3)
            uf_give({_p}, bread, 8)
        else if {_f} is 4:
            uf_give({_p}, uf_item("mat_upgrade"), 3)
        uf_geardrop({_p}, {_f}, "first")
        send title "&6初回突破！" with subtitle "&e+%{_pt}%pt" to {_p} for 3 seconds
        uf_msg({_p}, "&6%{_f}%階 初回突破報酬 &e+%{_pt}%pt")
        if {_f} < 9:
            uf_msg({_p}, "&aショップに新しい商品が並んだかもしれない")
        uf_ach({_p}, "clear_%{_f}%")
    else:
        set {_r} to floor({_pt} * {uf::cfg::repeat_rate})
        uf_addpt({_p}, {_r}, "repeatclear:%{_f}%")
        uf_msg({_p}, "&a%{_f}%階 再突破報酬 &e+%{_r}%pt")
        uf_geardrop({_p}, {_f}, "repeat")
    if uf_unlock({_p}) <= {_f}:
        set {uf::unlock::%{_u}%} to min({_f} + 1, 9)
        if {_f} < 9:
            uf_msg({_p}, "&b%{_f} + 1%階 が解放された（次からは受付で%{_f} + 1%階から始められる）")
    add 1 to {uf::stat::%{_u}%::clears}
    uf_addxp({_p}, {_f} * 20)
    uf_questadd({_p}, "dclear", 1)
    uf_achcheck({_p})
    uf_log("dungeon", "reward %{_p}% (%{_u}%) f=%{_f}%")

# ------------------------------------------------------------
# 討伐への貢献（ダメージを与えた人だけが報酬を受け取る＝放置対策）
# ------------------------------------------------------------
on damage:
    set {_mid} to metadata value "uf_mid" of victim
    {_mid} is set
    set {_a} to attacker
    {_a} is a player
    set {_f} to metadata value "uf_floor" of victim
    # 挑戦中のパーティー以外は攻撃できない（報酬の横取り防止）
    if {-uf::sess::%{_f}%::mem::%uuid of {_a}%} is not set:
        cancel event
        stop
    set {-uf::dmg::%{_mid}%::%uuid of {_a}%} to {_a}
    set {-uf::sess::%{_f}%::active::%uuid of {_a}%} to true

# フロアへの出入りの管理（1 秒ごと）
#   ・階段を上って次の階のフロアに入った → その階を始める
#   ・挑戦中の人がエレベーターなどで別の階に入った → 自分の階の開始地点へ戻す
#   ・挑戦中でない人がフロアに入った → ロビーへ戻す（管理者は除く）
every 1 second:
    uf_on("dungeon") is true
    {uf::cfg::lobby} is set
    loop all players:
        set {_p} to loop-player
        if uf_inworld(location of {_p}, "dungeon") is true:
            set {_mine} to {-uf::insess::%uuid of {_p}%}
            loop integers between 2 and 9:
                set {_f} to loop-value-2
                if {uf::floor::%{_f}%::p1} is set:
                    if {uf::floor::%{_f}%::p2} is set:
                        if uf_inbox(location of {_p}, {uf::floor::%{_f}%::p1}, {uf::floor::%{_f}%::p2}) is true:
                            if {-uf::sess::%{_f}%::mem::%uuid of {_p}%} is not set:
                                if {_mine} is set:
                                    if {_f} is {_mine} + 1:
                                        if {-uf::sess::%{_mine}%::phase} is "cleared":
                                            uf_dadvance({_mine})
                                        else:
                                            teleport {_p} to {uf::floor::%{_mine}%::cp}
                                            uf_msg({_p}, "&cまだ%{_mine}%階を突破していません")
                                    else:
                                        teleport {_p} to {uf::floor::%{_mine}%::cp}
                                        uf_msg({_p}, "&c挑戦中の%{_mine}%階に戻ります")
                                else if uf_admin({_p}) is false:
                                    teleport {_p} to {uf::cfg::lobby}
                                    uf_msg({_p}, "&c%{_f}%階は、挑戦中のパーティーだけが入れます。1 階の受付から挑戦してください")

on death:
    set {_tier} to metadata value "uf_tier" of victim
    {_tier} is set
    clear drops
    set {_f} to metadata value "uf_floor" of victim
    set {_mid} to metadata value "uf_mid" of victim
    if {-uf::sess::%{_f}%::on} is not true:
        delete {-uf::dmg::%{_mid}%::*}
        stop
    if {-uf::sess::%{_f}%::skipping} is true:
        delete {-uf::dmg::%{_mid}%::*}
        stop
    set {_pt} to {uf::cfg::reward::%{_tier}%}
    loop {-uf::dmg::%{_mid}%::*}:
        set {_p} to loop-value
        if {_p} is online:
            uf_addpt({_p}, {_pt}, "kill:%{_tier}%")
            uf_addxp({_p}, ceil({_pt} / 2))
            add 1 to {uf::stat::%uuid of {_p}%::dkills}
            uf_questadd({_p}, "dkill", 1)
            uf_achcheck({_p})
            if {_tier} is "mid" or "boss":
                uf_msg({_p}, "&a討伐報酬 &e+%{_pt}%pt")
            if {_tier} is "mid":
                uf_geardrop({_p}, {_f}, "mid")
    delete {-uf::dmg::%{_mid}%::*}
    if {_tier} is "mid":
        uf_bbclear({_f})
        uf_dmidwin({_f})
    else if {_tier} is "boss":
        uf_bbclear({_f})
        uf_dbosswin({_f})
    else if {_tier} is "minion":
        remove 1 from {-uf::sess::%{_f}%::minions}
    else:
        remove 1 from {-uf::sess::%{_f}%::alive}

# ------------------------------------------------------------
# 全滅（挑戦中のメンバーが全員倒れている）→ その回は終了
#   uf_06_death.sk の死亡処理から呼ばれる
# ------------------------------------------------------------
function uf_dwipecheck(f: number):
    if {-uf::sess::%{_f}%::on} is not true:
        stop
    loop {-uf::sess::%{_f}%::mem::*}:
        if loop-value is online:
            if {-uf::down::%uuid of loop-value%} is not set:
                stop
    uf_dsay({_f}, "&4全滅… 挑戦は終了です。1 階へ戻ります")
    uf_log("dungeon", "wipe f=%{_f}%")
    uf_dend({_f}, "wipe")

# ------------------------------------------------------------
# 終了・退出
# ------------------------------------------------------------
function uf_dend(f: number, reason: text, tolobby: boolean = true):
    if {-uf::sess::%{_f}%::on} is not true:
        stop
    set {-uf::sess::%{_f}%::on} to false
    uf_bbclear({_f})
    loop {-uf::sess::%{_f}%::mobs::*}:
        if loop-value is alive:
            kill loop-value
    loop {-uf::sess::%{_f}%::chestloc::*}:
        set block at loop-value to air
        delete {uf::placedchest::%loop-index%}
    loop {-uf::sess::%{_f}%::mem::*}:
        set {_p} to loop-value
        delete {-uf::insess::%uuid of {_p}%}
        delete {-uf::down::%uuid of {_p}%}
        uf_soulclear({_p})
        if {_tolobby} is true:
            if {_p} is online:
                if {uf::cfg::lobby} is set:
                    if {_p} is alive:
                        teleport {_p} to {uf::cfg::lobby}
                    else:
                        set {-uf::tolobby::%uuid of {_p}%} to true
    uf_log("dungeon", "end f=%{_f}% reason=%{_reason}%")
    delete {-uf::sess::%{_f}%::*}

# 倒れていた人は、復活したら 1 階へ
on respawn:
    {-uf::tolobby::%uuid of player%} is true
    delete {-uf::tolobby::%uuid of player%}
    {uf::cfg::lobby} is set
    wait 1 tick
    if player is online:
        teleport player to {uf::cfg::lobby}

# 管理者用：今の段階を終わらせて次へ（倒した扱い・報酬なし）
function uf_dskip(f: number):
    if {-uf::sess::%{_f}%::on} is not true:
        stop
    set {_ph} to {-uf::sess::%{_f}%::phase}
    set {-uf::sess::%{_f}%::skipping} to true
    loop {-uf::sess::%{_f}%::mobs::*}:
        if loop-value is alive:
            set {_t} to metadata value "uf_tier" of loop-value
            if {_ph} is "explore":
                if {_t} is "normal" or "strong" or "elite":
                    kill loop-value
            else if {_ph} is "mid":
                if {_t} is "mid":
                    kill loop-value
            else if {_ph} is "boss":
                if {_t} is "boss":
                    kill loop-value
    delete {-uf::sess::%{_f}%::skipping}
    if {_ph} is "explore":
        if {-uf::sess::%{_f}%::middone} is not true:
            # 中ボスを倒した扱いにして、中ボスの壁を開ける
            set {-uf::sess::%{_f}%::alive} to 0
            set {-uf::sess::%{_f}%::middone} to true
            uf_gateopen({_f}, "mid")
        else:
            # 中ボスを倒した後なら、ボス戦を始める
            uf_dbossstart({_f})
    else if {_ph} is "mid":
        uf_dmidwin({_f})
    else if {_ph} is "boss":
        uf_dbosswin({_f})

function uf_dleave(p: player):
    set {_f} to {-uf::insess::%uuid of {_p}%}
    if {_f} is not set:
        uf_msg({_p}, "&cダンジョンに挑戦していません")
        stop
    delete {-uf::sess::%{_f}%::mem::%uuid of {_p}%}
    delete {-uf::insess::%uuid of {_p}%}
    delete {-uf::down::%uuid of {_p}%}
    uf_soulclear({_p})
    if {uf::cfg::lobby} is set:
        teleport {_p} to {uf::cfg::lobby}
    uf_msg({_p}, "&eダンジョンから退出しました")
    if size of {-uf::sess::%{_f}%::mem::*} is 0:
        uf_dend({_f}, "allleft")
    else:
        uf_dwipecheck({_f})

on quit:
    if {-uf::insess::%uuid of player%} is set:
        uf_dleave(player)

# 時間切れ・全員不在・待ちの再試行・reload で中断された待ちの復旧・空いた階の壁を閉じ直す
every 5 seconds:
    loop integers between 2 and 9:
        set {_f} to loop-value-1
        if {-uf::sess::%{_f}%::on} is not true:
            # だれも挑戦していない階の壁は、近くに人がいなければ閉じ直す
            loop "mid" and "exit":
                if {uf::gatestate::%{_f}%::%loop-value-2%} is "open":
                    if uf_gatenear({_f}, loop-value-2) is false:
                        uf_gateclose({_f}, loop-value-2)
        if {-uf::sess::%{_f}%::on} is true:
            set {_ph} to {-uf::sess::%{_f}%::phase}
            set {_el} to {-uf::tick} - {-uf::sess::%{_f}%::tphase}
            # 10分ごとの sk reload all で待ち（wait）が中断されても、ここで先へ進める
            if {_ph} is "midwin":
                if {_el} > 100:
                    uf_dmidreturn({_f})
            else if {_ph} is "bosswin":
                if {_el} > 100:
                    uf_dbossreturn({_f})
            else if {_ph} is "waiting":
                uf_dopenexit({_f})
            if {-uf::sess::%{_f}%::on} is true:
                if {-uf::tick} - {-uf::sess::%{_f}%::t0} > {uf::cfg::session_minutes} * 1200:
                    uf_dsay({_f}, "&c時間切れ！ 1 階へ戻ります")
                    uf_dend({_f}, "timeout")
                else:
                    set {_any} to false
                    loop {-uf::sess::%{_f}%::mem::*}:
                        if loop-value-2 is online:
                            set {_any} to true
                    if {_any} is true:
                        set {-uf::sess::%{_f}%::seen} to {-uf::tick}
                    else if {-uf::tick} - {-uf::sess::%{_f}%::seen} > 600:
                        uf_dend({_f}, "empty")

# ------------------------------------------------------------
# 宝箱（候補地点から 1〜3 か所。中身は個人別で、1 セッション 1 回）
# ------------------------------------------------------------
function uf_placechests(f: number):
    set {_c::*} to {uf::floor::%{_f}%::chest::*}
    if size of {_c::*} < 1:
        stop
    set {_n} to random integer between {uf::cfg::chest::min} and {uf::cfg::chest::max}
    set {_n} to min({_n}, size of {_c::*})
    loop {_n} times:
        set {_l} to random element out of {_c::*}
        remove {_l} from {_c::*}
        set block at {_l} to chest
        set {_k} to uf_lockey({_l})
        set {-uf::sess::%{_f}%::chestloc::%{_k}%} to {_l}
        set {uf::placedchest::%{_k}%} to {_l}

on right click on chest:
    set {_k} to uf_lockey(location of event-block)
    loop integers between 2 and 9:
        if {-uf::sess::%loop-value%::chestloc::%{_k}%} is set:
            set {_f} to loop-value
    {_f} is set
    cancel event
    set {_u} to uuid of player
    if {-uf::sess::%{_f}%::mem::%{_u}%} is not set:
        uf_msg(player, "&cこの宝箱は挑戦中のパーティー専用です")
        stop
    if {-uf::sess::%{_f}%::opened::%{_k}%::%{_u}%} is true:
        uf_msg(player, "&7この宝箱はすでに開けた")
        stop
    set {-uf::sess::%{_f}%::opened::%{_k}%::%{_u}%} to true
    uf_chestloot(player, {_f})

function uf_chestloot(p: player, f: number):
    set {_sh} to ({_f} - 2) * {uf::cfg::chest::shift}
    set {_wn} to max(0, {uf::cfg::rarity::normal} - 3 * {_sh})
    set {_wr} to {uf::cfg::rarity::rare} + {_sh}
    set {_we} to {uf::cfg::rarity::epic} + 1.5 * {_sh}
    set {_wl} to {uf::cfg::rarity::legendary} + 0.5 * {_sh}
    set {_r} to random number between 0 and ({_wn} + {_wr} + {_we} + {_wl})
    if {_r} < {_wn}:
        set {_pt} to random integer between 50 and 120
        uf_addpt({_p}, {_pt}, "chest:normal")
        if random integer between 1 and 2 is 1:
            uf_give({_p}, uf_item("heal_kit"))
        uf_msg({_p}, "&f[ノーマル] &e+%{_pt}%pt")
    else if {_r} < {_wn} + {_wr}:
        set {_pt} to random integer between 120 and 250
        uf_addpt({_p}, {_pt}, "chest:rare")
        uf_give({_p}, uf_item("mat_upgrade"))
        uf_msg({_p}, "&9[レア] &e+%{_pt}%pt &7と 武器強化素材")
    else if {_r} < {_wn} + {_wr} + {_we}:
        set {_pt} to random integer between 250 and 400
        uf_addpt({_p}, {_pt}, "chest:epic")
        uf_give({_p}, uf_item("mat_special"))
        uf_msg({_p}, "&5[エピック] &e+%{_pt}%pt &7と 特殊素材")
    else:
        set {_k} to random integer between 1 and 3
        if {_k} is 1:
            uf_give({_p}, uf_item("acc_rare"))
            uf_msg({_p}, "&6[レジェンダリー] &f守護のお守り")
        else if {_k} is 2:
            uf_give({_p}, uf_item("mat_part"))
            uf_msg({_p}, "&6[レジェンダリー] &f武器パーツ")
        else:
            set {_it} to uf_item("dgw_%{_f}%")
            uf_give({_p}, {_it})
            uf_msg({_p}, "&6[レジェンダリー] &f%name of {_it}%")
    uf_log("dungeon", "chest %{_p}% f=%{_f}% roll=%{_r}%")

# ------------------------------------------------------------
# 再起動後の後片付け（挑戦中のセッションがなければ、残った敵と宝箱を消す）
# ------------------------------------------------------------
on load:
    loop integers between 2 and 9:
        if {-uf::sess::%loop-value%::on} is true:
            stop
    loop {uf::placedchest::*}:
        set block at loop-value to air
    delete {uf::placedchest::*}
    loop all entities:
        if loop-entity is not a player:
            if name of loop-entity contains "◆":
                kill loop-entity

# ------------------------------------------------------------
# 管理者用：フロアの設定 /ufd <操作> <階> [種類] [数]
#   （管理者ツールの「ダンジョンの各階」からも同じことができる）
# ------------------------------------------------------------
command /ufd [<text>] [<number>] [<text>] [<number>]:
    description: ダンジョンの設定（管理者）
    permission: univfes.admin
    executable by: players
    trigger:
        set {_a} to arg-1
        if {_a} is not set:
            send "&e/ufd lobby &7: 今いる場所をロビー（1 階・退出先）にする" to player
            send "&e/ufd start|cp|p1|p2 <階> &7: 開始/復帰地点・フロアの範囲" to player
            send "&e/ufd gateopen|gateclose <階> &7: その階の中ボスの壁・階段の壁を開ける/閉じる（点検用）" to player
            send "&e/ufd marena|marenaboss|barena|barenaboss <階> &7: 中ボス/ボス闘技場の入口・出現地点" to player
            send "&e/ufd addspawn|addchest <階> &7: 敵の出現地点/宝箱の候補地点を追加" to player
            send "&e/ufd clearspawn|clearchest <階> &7: 上の地点をすべて消す" to player
            send "&e/ufd count <階> normal|strong|elite <数> &7: 出現数" to player
            send "&e/ufd info|end|skip <階> &7: 設定表示/強制終了/次の段階へ" to player
            stop
        if {_a} is "lobby":
            set {uf::cfg::lobby} to location of player
            uf_msg(player, "&aロビーを設定しました")
            uf_adminlog(player, "ufd lobby %uf_fmtloc(location of player)%")
            stop
        set {_f} to arg-2
        if {_f} is not set:
            uf_msg(player, "&c階（2〜9）を指定してください")
            stop
        if {_f} is not between 2 and 9:
            uf_msg(player, "&c階は 2〜9 です")
            stop
        if {_a} is "start" or "cp" or "mid" or "boss" or "p1" or "p2":
            set {uf::floor::%{_f}%::%{_a}%} to location of player
            uf_msg(player, "&a%{_f}%階 の %{_a}% を設定しました")
        else if {_a} is "gateopen":
            uf_gateopen({_f}, "mid")
            uf_gateopen({_f}, "exit")
            uf_msg(player, "&e%{_f}%階 の壁を開けました（だれも挑戦していなければ、近くに人がいなくなると自動で閉じます）")
        else if {_a} is "gateclose":
            uf_gateclose({_f}, "mid")
            uf_gateclose({_f}, "exit")
            uf_msg(player, "&a%{_f}%階 の壁を閉じました")
        else if {_a} is "marena":
            set {uf::floor::%{_f}%::marena::player} to location of player
            uf_msg(player, "&a%{_f}%階 の中ボス闘技場の入口を設定しました")
        else if {_a} is "marenaboss":
            set {uf::floor::%{_f}%::marena::boss} to location of player
            uf_msg(player, "&a%{_f}%階 の中ボスの出現地点を設定しました")
        else if {_a} is "barena":
            set {uf::floor::%{_f}%::barena::player} to location of player
            uf_msg(player, "&a%{_f}%階 のボス闘技場の入口を設定しました")
        else if {_a} is "barenaboss":
            set {uf::floor::%{_f}%::barena::boss} to location of player
            uf_msg(player, "&a%{_f}%階 のボスの出現地点を設定しました")
        else if {_a} is "addspawn":
            add location of player to {uf::floor::%{_f}%::spawn::*}
            uf_msg(player, "&a出現地点を追加（計 %size of {uf::floor::%{_f}%::spawn::*}%）")
        else if {_a} is "addchest":
            add location of block at location of player to {uf::floor::%{_f}%::chest::*}
            uf_msg(player, "&a宝箱の候補地点を追加（計 %size of {uf::floor::%{_f}%::chest::*}%）")
        else if {_a} is "clearspawn":
            delete {uf::floor::%{_f}%::spawn::*}
            uf_msg(player, "&e出現地点を消去しました")
        else if {_a} is "clearchest":
            delete {uf::floor::%{_f}%::chest::*}
            uf_msg(player, "&e宝箱の候補地点を消去しました")
        else if {_a} is "count":
            if arg-3 is not "normal" or "strong" or "elite":
                uf_msg(player, "&c種類は normal / strong / elite です")
                stop
            if arg-4 is not set:
                uf_msg(player, "&c数を指定してください")
                stop
            if arg-4 is not between 0 and 50:
                uf_msg(player, "&c数は 0〜50 です")
                stop
            set {uf::floor::%{_f}%::count::%arg-3%} to floor(arg-4)
            uf_msg(player, "&a%{_f}%階 の %arg-3% を %floor(arg-4)% 体にしました")
        else if {_a} is "info":
            uf_msg(player, "&e%{_f}%階 の設定")
            loop "start", "cp", "p1", "p2", "marena::player", "marena::boss", "barena::player" and "barena::boss":
                if {uf::floor::%{_f}%::%loop-value%} is set:
                    send "&7%loop-value%: &f%uf_fmtloc({uf::floor::%{_f}%::%loop-value%})%" to player
                else:
                    send "&7%loop-value%: &c未設定" to player
            send "&7出現地点: %size of {uf::floor::%{_f}%::spawn::*}% / 宝箱候補: %size of {uf::floor::%{_f}%::chest::*}%" to player
            set {_cn} to uf_dcount({_f}, "normal")
            set {_cs} to uf_dcount({_f}, "strong")
            set {_ce} to uf_dcount({_f}, "elite")
            send "&7出現数: 通常 %{_cn}% / 強化 %{_cs}% / エリート %{_ce}%" to player
            if {-uf::sess::%{_f}%::on} is true:
                send "&7挑戦中: 段階 %{-uf::sess::%{_f}%::phase}% / 残り %{-uf::sess::%{_f}%::alive}%体" to player
            stop
        else if {_a} is "end":
            uf_dend({_f}, "admin")
            uf_msg(player, "&e%{_f}%階 のセッションを終了しました")
        else if {_a} is "skip":
            if {-uf::sess::%{_f}%::on} is not true:
                uf_msg(player, "&cこの階は挑戦中ではありません")
                stop
            uf_dskip({_f})
            uf_msg(player, "&e次の段階へ進めました")
        else:
            uf_msg(player, "&c不明な操作です（/ufd で一覧）")
            stop
        uf_adminlog(player, "ufd %{_a}% %{_f}% %arg-3% %arg-4%")
