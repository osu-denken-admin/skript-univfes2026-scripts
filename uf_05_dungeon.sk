# ============================================================
# uf_05_dungeon.sk : 15号館ダンジョン（2階〜9階を通しで進む）
#
# 流れ（1 回の挑戦 = 1 回の「通し」）
#   1 階の受付で開始する階を選ぶ（最初は 2 階。以後は突破した階の次の階からも選べる）
#   偶数階は西の階段から入って東の階段へ、奇数階は東の階段から入って西の階段へ進む
#   → 階の途中の「中ボスの壁」（泣く黒曜石）をクリック → 全員が上空の中ボス闘技場へ
#   → 勝つと、クリックした壁の向こう側に出る（壁は消えない。ほかのパーティーには閉じたまま）
#   → 出口側の上り階段をふさぐ「ボスの壁」（強化深層岩）をクリック → 全員がボス闘技場へ
#   → 勝つと突破報酬・次の階の解放。次の階の開始地点へ移って、その階が始まる（9 階のボスで制覇 → 1 階へ）
#   壁はずっと閉じたまま（点検で開けたときだけ開く）。使わない側の上り階段は白コンクリートでふさいである
#   全員が倒れる（全滅）・時間切れ・全員不在で、その回の挑戦は終了して 1 階へ戻る。
#   解放と、それまでに得た報酬は残る。
#
# 同じ階に、最大 floor_parties（4）パーティーが同時に入れる（2026-10-28）
#   挑戦はパーティーごとの「セッション」。番号は 階 × 10 + 枠（0〜）で、階は uf_sf で戻す
#   敵・宝箱はセッションごと。ほかのパーティーの敵は、こちらを狙わず、こちらからも攻撃できない
#   闘技場は階ごとに 1 つ。ほかのパーティーが戦っている間は、空くまで待つ（空いたら知らせる）
#   次の階が満員なら、空くまで待ってから移る
#
# 保存される変数
#   {uf::unlock::<uuid>}            挑戦を始められる最上階（初期値 2）
#   {uf::clear::<uuid>::<階>}       初回クリア済み（初回報酬の二重取得防止）
#   {uf::floor::<階>::start|cp|p1|p2}            開始・復帰地点、フロアの範囲
#   {uf::gatecells::<階>::mid|exit|block::*}      壁（ゲート）のブロックの場所 / {uf::gatekind::<場所>} 逆引き
#   {uf::gatestate::<階>::<種類>} / {uf::gateorig::<場所>}  開閉状態と、ふさぐ前のブロック
#   {uf::floor::<階>::marena::player|boss}       中ボス闘技場（入口・中ボスの出現地点）
#   {uf::floor::<階>::barena::player|boss}       ボス闘技場（入口・ボスの出現地点）
#   {uf::floor::<階>::spawn::*} / {uf::floor::<階>::chest::*}
#   闘技場が未設定のときは、フロアの {uf::floor::<階>::mid|boss} で戦う
# メモリのみ
#   {-uf::sess::<セッション>::...}  挑戦中のセッション（phase: explore / mid / midwin / boss / bosswin / waiting / cleared）
#                                    cp = 復帰地点（中ボスの後は壁の向こう側）
#   {-uf::slist::<セッション>}       挑戦中のセッションの一覧
#   {-uf::insess::<uuid>}            挑戦中のセッション（階は uf_sf）
#   {-uf::arena::<階>::mid|boss}     その闘技場を使っているセッション / {-uf::await::<階>::mid|boss::*} 待っているセッション
#   {-uf::down::<uuid>}              倒れている（蘇生待ち）
#   {-uf::tolobby::<uuid>}           復活したら 1 階へ戻す
# ============================================================

# セッションの階
function uf_sf(s: number) :: number:
    return floor({_s} / 10)

# その階で空いているセッションの番号（満員なら -1）
function uf_sfree(f: number) :: number:
    loop {uf::cfg::floor_parties} times:
        set {_s} to {_f} * 10 + loop-number - 1
        if {-uf::sess::%{_s}%::on} is not true:
            return {_s}
    return -1

# その階で挑戦中のセッション
function uf_fsess(f: number) :: numbers:
    loop {-uf::slist::*}:
        if uf_sf(loop-value) is {_f}:
            add loop-value to {_out::*}
    return {_out::*}

# セッションの復帰地点（中ボスを倒した後は壁の向こう側。なければ階の復帰地点・開始地点）
function uf_scp(s: number) :: location:
    if {-uf::sess::%{_s}%::cp} is set:
        return {-uf::sess::%{_s}%::cp}
    set {_f} to uf_sf({_s})
    if {uf::floor::%{_f}%::cp} is set:
        return {uf::floor::%{_f}%::cp}
    return {uf::floor::%{_f}%::start}

function uf_unlock(p: player) :: number:
    set {_v} to {uf::unlock::%uuid of {_p}%}
    if {_v} is not set:
        return 2
    return {_v}

function uf_bossname(f: number) :: text:
    if {_f} is 2:
        return "&4◆ 受付に残る影"
    if {_f} is 3:
        return "&4◆ 図書の番人"
    if {_f} is 4:
        return "&4◆ 実験室の異形"
    if {_f} is 5:
        return "&4◆ サーバールームの主"
    if {_f} is 6:
        return "&4◆ 非常階段の門番"
    if {_f} is 7:
        return "&4◆ 影の教授"
    if {_f} is 8:
        return "&4◆ 忘れられた研究者"
    return "&4◆ 15号館の主"

# 次の目標（設計書 5.1。main.sk が画面下に出す）。まだ突破していない、いちばん下の階
function uf_nextgoal(p: player) :: text:
    if uf_on("dungeon") is false:
        return ""
    loop integers between 2 and 9:
        if {uf::clear::%uuid of {_p}%::%loop-value%} is not true:
            return "&7次の目標: &b%loop-value%階を突破"
    return "&6&l15号館 制覇！"

# ------------------------------------------------------------
# 受付（フロアマップ右クリック または /dungeon）
# ------------------------------------------------------------
command /dungeon [<text>]:
    description: ダンジョンの受付（leave で退出）
    aliases: /dg
    executable by: players
    trigger:
        if uf_on("dungeon") is false:
            uf_msg(player, "&cダンジョンは現在停止中です")
            stop
        if arg-1 is "leave":
            uf_dleave(player)
            stop
        uf_floorgui(player)

on right click:
    # 帰還の書
    uf_id(player's tool) is "map"
    cancel event
    if uf_on("dungeon") is false:
        uf_msg(player, "&cダンジョンは現在停止中です")
        stop
    uf_floorgui(player)

function uf_floorgui(p: player):
    set {_u} to uuid of {_p}
    if {-uf::insess::%{_u}%} is set:
        set {_g} to chest inventory with 3 rows named "&8帰還の書（%uf_sf({-uf::insess::%{_u}%})%階に挑戦中）"
    else:
        set {_g} to chest inventory with 3 rows named "&8受付：開始する階を選ぶ"
    uf_guiclear({_p})
    loop integers between 2 and 9:
        set {_f} to loop-value
        set {_s} to {_f} + 8
        delete {_lore::*}
        if {uf::floor::%{_f}%::start} is not set:
            set {_icon} to gray stained glass pane
            add "&8準備中" to {_lore::*}
        else if {_f} > uf_unlock({_p}):
            set {_icon} to iron bars
            add "&c%{_f} - 1%階を突破すると、ここから始められる" to {_lore::*}
        else:
            set {_icon} to oak door
            if {uf::clear::%{_u}%::%{_f}%} is true:
                add "&a突破済み" to {_lore::*}
            add "&7ここから始めて、9階まで上へ進む" to {_lore::*}
            set {_n} to size of uf_fsess({_f})
            if {_n} > 0:
                add "&7挑戦中: %{_n}% / %{uf::cfg::floor_parties}% パーティー" to {_lore::*}
            if uf_sfree({_f}) < 0:
                add "&c満員（空くまで待ってね）" to {_lore::*}
            else:
                add "&eクリックで%{_f}%階から挑戦" to {_lore::*}
        set slot {_s} of {_g} to ({_icon} named "&f%{_f}%階から") with lore {_lore::*}
        set {-uf::guictx::%{_u}%::%{_s}%} to {_f}
    if {-uf::insess::%{_u}%} is set:
        set {_left} to uf_dwarpleft({_p})
        if {_left} > 0:
            set {_wl} to "&cあと %{_left}% 秒で使える"
        else:
            set {_wl} to "&eクリックで戻る"
        set slot 20 of {_g} to ender pearl named "&d復帰地点に戻る" with lore "&7挑戦中の階の復帰地点へ戻る", "&7中ボス・ボスとの戦いの間は使えない", "&7一度使うと %{uf::cfg::warp_seconds}% 秒は使えない" and {_wl}
        set slot 22 of {_g} to barrier named "&cダンジョンから退出する" with lore "&7挑戦をやめて 1 階のロビーへ戻る" and "&7突破した階と報酬はそのまま"
    else if uf_on("party") is true:
        # パーティーの画面（uf_04_party.sk）。仲間を招待してから、リーダーが階を選ぶ
        set {_pn} to size of uf_members({_p})
        set slot 26 of {_g} to player head named "&eパーティー（%{_pn}% 人）" with lore "&7近くの人を招待する・招待に参加する・抜ける" and "&7パーティーで挑戦するときは、先に組んでからリーダーが階を選ぶ"
    uf_gui({_p}, "floor", {_g})

# 挑戦中の階の復帰地点（帰還の書・前に売っていた帰還の巻物）。戻れないときは理由を伝えて、何も返さない
#   テレポートは待ちのある処理なので、この関数ではしない（待ちのあとの return はエラーになる）。戻すのは uf_dwarpgo
function uf_dwarppos(p: player) :: location:
    set {_s} to {-uf::insess::%uuid of {_p}%}
    if {_s} is not set:
        uf_msg({_p}, "&c復帰地点に戻るのは、ダンジョンの挑戦中にだけ使えます")
        return {_none}
    if {-uf::sess::%{_s}%::phase} is not "explore" or "cleared" or "waiting":
        uf_msg({_p}, "&c中ボス・ボスとの戦いの間は使えません")
        return {_none}
    return uf_scp({_s})

function uf_dwarpgo(p: player, cp: location):
    play 20 portal at location of {_p}
    teleport {_p} to {_cp}
    play sound "entity.enderman.teleport" with volume 1 at {_p}
    uf_msg({_p}, "&d%uf_sf({-uf::insess::%uuid of {_p}%})%階の復帰地点に戻った")

# 帰還の書で戻れるまでの残りの秒数（0 ならすぐ使える。間隔は設定の warp_seconds）
function uf_dwarpleft(p: player) :: number:
    set {_t} to {-uf::wcd::%uuid of {_p}%}
    if {_t} is not set:
        return 0
    set {_left} to {uf::cfg::warp_seconds} * 20 - ({-uf::tick} - {_t})
    if {_left} <= 0:
        return 0
    return ceil({_left} / 20)

function uf_dbookwarp(p: player):
    set {_left} to uf_dwarpleft({_p})
    if {_left} > 0:
        uf_msg({_p}, "&c復帰地点に戻れるのは、あと %{_left}% 秒後です")
        stop
    set {_cp} to uf_dwarppos({_p})
    if {_cp} is set:
        set {-uf::wcd::%uuid of {_p}%} to {-uf::tick}
        uf_dwarpgo({_p}, {_cp})

on inventory click:
    {-uf::gui::%uuid of player%} is "floor"
    cancel event
    event-inventory is {-uf::guiinv::%uuid of player%}
    set {_s} to index of event-slot
    if {_s} is 22:
        wait 1 tick
        close inventory of player
        uf_dleave(player)
        stop
    if {_s} is 26:
        {-uf::insess::%uuid of player%} is not set
        uf_on("party") is true
        wait 1 tick
        uf_pgui(player)
        stop
    if {_s} is 20:
        {-uf::insess::%uuid of player%} is set
        wait 1 tick
        close inventory of player
        uf_dbookwarp(player)
        stop
    set {_f} to {-uf::guictx::%uuid of player%::%{_s}%}
    {_f} is set
    wait 1 tick
    close inventory of player
    uf_dstart(player, {_f})

# ------------------------------------------------------------
# 挑戦の開始（受付）と、各階の開始
# ------------------------------------------------------------
function uf_dstart(p: player, f: number):
    if uf_on("dungeon") is false:
        stop
    # 受付の区域の中か、受付の NPC に話しかけてから 3 分以内（uf_17_npc.sk）
    if uf_canuse({_p}, "reception") is false:
        uf_msg({_p}, "&cダンジョンへの挑戦は 1 階の受付で行ってください")
        stop
    if {uf::floor::%{_f}%::start} is not set:
        uf_msg({_p}, "&cこの階は準備中です")
        stop
    if size of {uf::floor::%{_f}%::spawn::*} < 1:
        uf_msg({_p}, "&cこの階は準備中です（敵の出現地点が未設定）")
        stop
    if {-uf::insess::%uuid of {_p}%} is set:
        uf_msg({_p}, "&cすでにダンジョンに挑戦中です（/dungeon leave で退出）")
        stop
    set {_s} to uf_sfree({_f})
    if {_s} < 0:
        uf_msg({_p}, "&cこの階は満員です（最大 %{uf::cfg::floor_parties}% パーティー）。少し待ってから試してね")
        stop
    if uf_isleader({_p}) is false:
        uf_msg({_p}, "&c挑戦を開始できるのはパーティーリーダーだけです")
        stop
    set {_mem::*} to uf_members({_p})
    loop {_mem::*}:
        if loop-value is not online:
            uf_msg({_p}, "&cオフラインのメンバーがいます")
            stop
        if uf_unlock(loop-value) < {_f}:
            uf_msg({_p}, "&c%loop-value% はまだ %{_f}%階 から始められません")
            stop
        if {-uf::insess::%uuid of loop-value%} is set:
            uf_msg({_p}, "&c%loop-value% はすでに挑戦中です")
            stop
    uf_log("dungeon", "run start f=%{_f}% s=%{_s}% leader=%{_p}% members=%{_mem::*}%")
    uf_dbegin({_s}, {_mem::*})
    loop {_mem::*}:
        if loop-value is online:
            uf_dexithint(loop-value)

# 階を始める（全員を開始地点へ）。s はセッション（階 × 10 + 枠）
function uf_dbegin(s: number, mem: players):
    set {_f} to uf_sf({_s})
    set {-uf::sess::%{_s}%::on} to true
    set {-uf::slist::%{_s}%} to {_s}
    set {-uf::sess::%{_s}%::phase} to "explore"
    set {-uf::sess::%{_s}%::t0} to {-uf::tick}
    set {-uf::sess::%{_s}%::tphase} to {-uf::tick}
    set {-uf::sess::%{_s}%::seen} to {-uf::tick}
    set {-uf::sess::%{_s}%::alive} to 0
    # 壁はずっと閉じておく（ほかのパーティーがいても通れないように）
    uf_gateclose({_f}, "mid")
    uf_gateclose({_f}, "exit")
    loop {_mem::*}:
        if loop-value is online:
            set {-uf::sess::%{_s}%::mem::%uuid of loop-value%} to loop-value
            set {-uf::insess::%uuid of loop-value%} to {_s}
            delete {-uf::down::%uuid of loop-value%}
            if loop-value is alive:
                teleport loop-value to {uf::floor::%{_f}%::start}
            send title "&c%{_f}%階" with subtitle "&7中ボスの壁を突破し、反対側の階段を目指せ" to loop-value for 3 seconds
    uf_log("dungeon", "floor start f=%{_f}% s=%{_s}%")
    uf_placechests({_s})
    uf_spawnwave({_s})

# 受付から入った人に、帰還の書（復帰地点に戻る・退出のボタンがある）を 1 つ渡して、出かたを伝える
#   帰還の書は挑戦中だけ持つもの。出たとき・挑戦が終わったときに uf_dtakemap で消す
function uf_dexithint(p: player):
    uf_dtakemap({_p})
    uf_give({_p}, uf_item("map"))
    uf_msg({_p}, "&7ダンジョンを出るときは &d帰還の書&7を右クリック →「ダンジョンから退出する」（復帰地点にも戻れる）")

# 帰還の書を持ち物から消す（前に配っていたフロアマップ・コンパスのものも消える。id はどれも map）
function uf_dtakemap(p: player):
    loop all items in inventory of {_p}:
        if uf_id(loop-value) is "map":
            remove loop-value from inventory of {_p}

# 前に配っていて、挑戦していないのに持ったままの帰還の書（フロアマップ）を片付ける
on join:
    wait 1 second
    player is online
    {-uf::insess::%uuid of player%} is not set
    uf_dtakemap(player)

# ダンジョンの中で死んでも、持ち物と経験値は落とさない（失うのはポイントの半分だけ。uf_06_death.sk）
#   15号館はサバイバルと同じワールドにあるので、ワールドのゲームルールではなくここで決める
#   持ち物を残しても、落とす物の一覧はそのまま地面に落ちる（増えてしまう）ので、clear drops で消す（経験値の玉も出なくなる）
on death of player:
    uf_inworld(location of victim, "dungeon") is true
    keep the inventory and experience
    clear drops

# 階ごとの出現数（/ufd count で上書き可能）
function uf_dcount(f: number, tier: text) :: number:
    set {_v} to {uf::floor::%{_f}%::count::%{_tier}%}
    if {_v} is set:
        return {_v}
    if {_tier} is "normal":
        return 4 + {_f}
    if {_tier} is "strong":
        return {_f} - 1
    if {_tier} is "elite":
        return floor({_f} / 3)
    return 0

function uf_spawnwave(s: number):
    set {_f} to uf_sf({_s})
    loop "normal", "strong" and "elite":
        set {_tier} to loop-value
        loop uf_dcount({_f}, {_tier}) times:
            set {_l} to random element out of {uf::floor::%{_f}%::spawn::*}
            uf_spawnmob({_s}, {_tier}, {_l})

# 敵の顔ぶれ・見た目・技は uf_18_mobs.sk（uf_mobmake）
#   tier: normal / strong / elite（フロアの敵）、mid / boss、minion（ボスが呼ぶ手下。全滅の数には入れない）
#   metadata: uf_floor = 階、uf_sid = セッション
function uf_spawnmob(s: number, tier: text, l: location):
    set {_e} to uf_mobmake(uf_sf({_s}), {_tier}, {_l})
    set metadata value "uf_tier" of {_e} to {_tier}
    set metadata value "uf_floor" of {_e} to uf_sf({_s})
    set metadata value "uf_sid" of {_e} to {_s}
    add 1 to {-uf::mobseq}
    set metadata value "uf_mid" of {_e} to {-uf::mobseq}
    add {_e} to {-uf::sess::%{_s}%::mobs::*}
    if {_tier} is "normal" or "strong" or "elite":
        add 1 to {-uf::sess::%{_s}%::alive}
    else if {_tier} is "minion":
        add 1 to {-uf::sess::%{_s}%::minions}
    else:
        uf_bbstart({_s}, {_e}, {_tier})

# ほかのパーティーの敵は、こちらを狙わない（こちらからも攻撃できない。on damage）
on target:
    set {_s} to metadata value "uf_sid" of event-entity
    {_s} is set
    target is a player
    {-uf::sess::%{_s}%::mem::%uuid of target%} is not set
    cancel event

function uf_dloc(f: number, k: text) :: location:
    if {uf::floor::%{_f}%::%{_k}%} is set:
        return {uf::floor::%{_f}%::%{_k}%}
    return random element out of {uf::floor::%{_f}%::spawn::*}

function uf_dsay(s: number, t: text):
    loop {-uf::sess::%{_s}%::mem::*}:
        if loop-value is online:
            send title " " with subtitle colored {_t} to loop-value for 2 seconds
            uf_msg(loop-value, {_t})

function uf_dsetphase(s: number, ph: text):
    set {-uf::sess::%{_s}%::phase} to {_ph}
    set {-uf::sess::%{_s}%::tphase} to {-uf::tick}

# 挑戦中のメンバー全員を移動させる（倒れている人も一緒に移動し、蘇生待ちは解除）
function uf_dmoveall(s: number, l: location):
    loop {-uf::sess::%{_s}%::mem::*}:
        set {_p} to loop-value
        if {_p} is online:
            if {_p} is alive:
                uf_soulclear({_p})
                delete {-uf::down::%uuid of {_p}%}
                teleport {_p} to {_l}

# ------------------------------------------------------------
# 壁（ゲート）
#   mid   = 階の途中にある中ボスの壁（クリック → 中ボス闘技場 → 勝つと消える）
#   exit  = 出口側の上り階段をふさぐボスの壁（中ボスを倒した後にクリック → ボス闘技場 → 勝つと階段が戻る）
#   block = 使わない上り階段をふさぐ壁（ずっと閉じたまま）
#   閉じるときに元のブロックを {uf::gateorig::<場所>} に保存し、開くときに戻す
# ------------------------------------------------------------
function uf_gateblock(kind: text) :: item:
    if {_kind} is "mid":
        return crying obsidian
    if {_kind} is "exit":
        return reinforced deepslate
    return white concrete

function uf_gateclose(f: number, kind: text):
    if {uf::gatestate::%{_f}%::%{_kind}%} is "closed":
        stop
    set {_b} to uf_gateblock({_kind})
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        set {_k} to uf_lockey(loop-value)
        if block at loop-value is not {_b}:
            set {uf::gateorig::%{_k}%} to "%block data of block at loop-value%"
        set block at loop-value to {_b}
    set {uf::gatestate::%{_f}%::%{_kind}%} to "closed"

function uf_gateopen(f: number, kind: text):
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        set {_k} to uf_lockey(loop-value)
        if {uf::gateorig::%{_k}%} is set:
            set block at loop-value to ({uf::gateorig::%{_k}%} parsed as block data)
        else:
            set block at loop-value to air
    set {uf::gatestate::%{_f}%::%{_kind}%} to "open"

# 壁のそばに人がいるか（閉じるときに人を埋めないため）
function uf_gatenear(f: number, kind: text) :: boolean:
    loop {uf::gatecells::%{_f}%::%{_kind}%::*}:
        loop all players:
            if "%world of loop-player%" is "%world of loop-value-1%":
                if distance between loop-player and loop-value-1 < 2.5:
                    return true
    return false

on click on crying obsidian or reinforced deepslate or white concrete:
    set {_g} to {uf::gatekind::%uf_lockey(location of event-block)%}
    {_g} is set
    cancel event
    set {_x::*} to split {_g} at ":"
    set {_f} to {_x::1} parsed as number
    set {_kind} to {_x::2}
    if {_kind} is "block":
        uf_msg(player, "&7この階段は崩れていて通れない。反対側の階段を探そう")
        stop
    if uf_on("dungeon") is false:
        stop
    set {_s} to {-uf::insess::%uuid of player%}
    if {_s} is not set:
        uf_msg(player, "&cこの壁は、挑戦中のパーティーだけが調べられる。1 階の受付から挑戦しよう")
        stop
    if uf_sf({_s}) is not {_f}:
        uf_msg(player, "&cここはあなたが挑戦している階ではない")
        stop
    set {_ph} to {-uf::sess::%{_s}%::phase}
    if {_kind} is "mid":
        if {-uf::sess::%{_s}%::middone} is true:
            uf_msg(player, "&7この壁はもう突破した。階段の壁を目指そう")
        else if {_ph} is "explore":
            uf_dmidstart({_s}, location of event-block, player)
    else if {_kind} is "exit":
        if {-uf::sess::%{_s}%::middone} is not true:
            uf_msg(player, "&7固く閉ざされている…。この階の途中にある中ボスの壁を先に突破しよう")
        else if {_ph} is "explore":
            uf_dbossstart({_s})
        else if {_ph} is "waiting":
            uf_msg(player, "&e上の階が満員。空き次第、移ります")

# ------------------------------------------------------------
# ダンジョンの周りには敵が湧かない（2026-10-29）
#   区域（建物 dungeon1・闘技場 dungeon2）の外側 nospawn_margin ブロックまで、自然に湧く敵を止める（高さは問わない）
#   ダンジョンの敵は Skript が出している（理由が custom）ので影響しない。動物・村人・スライムの分裂・卵や管理者が出したものも止めない
# ------------------------------------------------------------
function uf_nospawnmargin() :: number:
    return 128

function uf_nearddungeon(l: location) :: boolean:
    if {uf::cfg::world::dungeon} is not set:
        return false
    if "%world of {_l}%" is not {uf::cfg::world::dungeon}:
        return false
    set {_m} to uf_nospawnmargin()
    loop "dungeon1" and "dungeon2":
        set {_a} to {uf::area::%loop-value%::a}
        set {_b} to {uf::area::%loop-value%::b}
        if {_a} is set:
            if {_b} is set:
                set {_x} to x-coordinate of {_l}
                set {_z} to z-coordinate of {_l}
                if {_x} >= min(x-coordinate of {_a}, x-coordinate of {_b}) - {_m}:
                    if {_x} <= max(x-coordinate of {_a}, x-coordinate of {_b}) + 1 + {_m}:
                        if {_z} >= min(z-coordinate of {_a}, z-coordinate of {_b}) - {_m}:
                            if {_z} <= max(z-coordinate of {_a}, z-coordinate of {_b}) + 1 + {_m}:
                                return true
    return false

on spawn:
    uf_on("dungeon") is true
    set {_r} to "%spawn reason%"
    {_r} contains "natural" or "patrol" or "raid" or "village invasion" or "trap" or "lightning"
    set {_t} to "%type of event-entity%"
    {_t} contains "zombie" or "skeleton" or "creeper" or "spider" or "enderman" or "witch" or "slime" or "phantom" or "drowned" or "husk" or "stray" or "pillager" or "vindicator" or "evoker" or "ravager" or "silverfish" or "bogged" or "breeze"
    uf_nearddungeon(location of event-entity) is true
    cancel event

# 壁は壊せない
on break:
    {uf::gatekind::%uf_lockey(location of event-block)%} is set
    cancel event

# ------------------------------------------------------------
# 闘技場（階ごとに 1 つ。ほかのパーティーが戦っている間は空くまで待つ）
#   {-uf::arena::<階>::mid|boss} = 使っているセッション
# ------------------------------------------------------------
# 使えれば押さえて true。ほかのパーティーが使っていれば、待ちに入れて false
function uf_arenatake(s: number, kind: text) :: boolean:
    set {_f} to uf_sf({_s})
    set {_o} to {-uf::arena::%{_f}%::%{_kind}%}
    if {_o} is set:
        if {_o} is not {_s}:
            if {-uf::sess::%{_o}%::on} is true:
                set {-uf::await::%{_f}%::%{_kind}%::%{_s}%} to {_s}
                if {_kind} is "mid":
                    uf_dsay({_s}, "&e中ボスの闘技場はほかのパーティーが戦っている。空いたら知らせるので、もう一度壁をクリックしよう")
                else:
                    uf_dsay({_s}, "&eボスの闘技場はほかのパーティーが戦っている。空いたら知らせるので、もう一度壁をクリックしよう")
                return false
    set {-uf::arena::%{_f}%::%{_kind}%} to {_s}
    delete {-uf::await::%{_f}%::%{_kind}%::%{_s}%}
    return true

# 闘技場を空けて、待っているパーティーに知らせる
function uf_arenafree(s: number, kind: text):
    set {_f} to uf_sf({_s})
    if {-uf::arena::%{_f}%::%{_kind}%} is not {_s}:
        stop
    delete {-uf::arena::%{_f}%::%{_kind}%}
    loop {-uf::await::%{_f}%::%{_kind}%::*}:
        if {-uf::sess::%loop-value%::on} is true:
            uf_dsay(loop-value, "&a闘技場が空いた！ もう一度壁をクリックしよう")
    delete {-uf::await::%{_f}%::%{_kind}%::*}

# ------------------------------------------------------------
# 中ボス戦（中ボスの壁をクリック）
#   勝つと、クリックした壁の向こう側（クリックした人と反対側）に出る。そこがこの回の復帰地点になる
# ------------------------------------------------------------
function uf_dmidstart(s: number, gate: location, by: player):
    if {-uf::sess::%{_s}%::phase} is not "explore":
        stop
    set {_f} to uf_sf({_s})
    if {uf::floor::%{_f}%::marena::player} is set:
        if uf_arenatake({_s}, "mid") is false:
            stop
    uf_dsetpast({_s}, {_gate}, {_by})
    uf_dsetphase({_s}, "mid")
    uf_dsay({_s}, "&6壁の向こうから何かが来る…！")
    if {uf::floor::%{_f}%::marena::player} is set:
        uf_dmoveall({_s}, {uf::floor::%{_f}%::marena::player})
        uf_spawnmob({_s}, "mid", {uf::floor::%{_f}%::marena::boss})
    else:
        uf_spawnmob({_s}, "mid", uf_dloc({_f}, "mid"))
    uf_log("dungeon", "mid start f=%{_f}% s=%{_s}%")

# 壁の向こう側: 壁（東西を分ける壁）と同じ並びで、by と反対の方向へ 1 ブロック先。高さは床の上
function uf_dsetpast(s: number, gate: location, by: player):
    set {_gx} to floor(x-coordinate of {_gate})
    set {_gz} to floor(z-coordinate of {_gate})
    set {_y} to floor(y-coordinate of uf_scp({_s}))
    if x-coordinate of {_by} < {_gx} + 0.5:
        set {_px} to {_gx} + 1.5
    else:
        set {_px} to {_gx} - 0.5
    set {-uf::sess::%{_s}%::midpast} to location({_px}, {_y}, {_gz} + 0.5, world of {_gate})

function uf_dmidwin(s: number):
    if {-uf::sess::%{_s}%::phase} is not "mid":
        stop
    set {-uf::sess::%{_s}%::middone} to true
    uf_dsetphase({_s}, "midwin")
    uf_dsay({_s}, "&a中ボス撃破！ まもなく壁の向こう側に出ます")
    wait 3 seconds
    uf_dmidreturn({_s})

function uf_dmidreturn(s: number):
    if {-uf::sess::%{_s}%::phase} is not "midwin":
        stop
    uf_dsetphase({_s}, "explore")
    uf_arenafree({_s}, "mid")
    set {_past} to {-uf::sess::%{_s}%::midpast}
    if {_past} is set:
        set {-uf::sess::%{_s}%::cp} to {_past}
        uf_dmoveall({_s}, {_past})
        uf_dsay({_s}, "&a壁の向こう側に出た！ 階段の壁を目指せ")
    else:
        uf_dsay({_s}, "&a中ボスを倒した！ 階段の壁を目指せ")

# ------------------------------------------------------------
# ボス戦（中ボスを倒した後、出口側の階段の壁をクリック）
#   勝つと、次の階の開始地点へ移ってその階が始まる（次の階が満員なら空くまで待つ）
# ------------------------------------------------------------
function uf_dbossstart(s: number):
    if {-uf::sess::%{_s}%::phase} is not "explore":
        stop
    if {-uf::sess::%{_s}%::middone} is not true:
        stop
    set {_f} to uf_sf({_s})
    if {uf::floor::%{_f}%::barena::player} is set:
        if uf_arenatake({_s}, "boss") is false:
            stop
    uf_dsetphase({_s}, "boss")
    uf_dsay({_s}, "&4%uncolored uf_bossname({_f})% が現れた！")
    if {uf::floor::%{_f}%::barena::player} is set:
        uf_dmoveall({_s}, {uf::floor::%{_f}%::barena::player})
        uf_spawnmob({_s}, "boss", {uf::floor::%{_f}%::barena::boss})
    else:
        uf_spawnmob({_s}, "boss", uf_dloc({_f}, "boss"))
    uf_log("dungeon", "boss start f=%{_f}% s=%{_s}%")

function uf_dbosswin(s: number):
    if {-uf::sess::%{_s}%::phase} is not "boss":
        stop
    set {_f} to uf_sf({_s})
    uf_dsetphase({_s}, "bosswin")
    uf_log("dungeon", "clear f=%{_f}% s=%{_s}%")
    loop {-uf::sess::%{_s}%::mem::*}:
        set {_p} to loop-value
        if {_p} is online:
            if {-uf::sess::%{_s}%::active::%uuid of {_p}%} is true:
                uf_dreward({_p}, {_f})
            else:
                uf_msg({_p}, "&7戦闘への参加が確認できなかったため、突破報酬はありません")
    if {_f} < 9:
        uf_dsay({_s}, "&a%{_f}%階 突破！ まもなく%{_f} + 1%階へ移ります")
    else:
        uf_dsay({_s}, "&615号館 制覇！ おめでとう！")
    wait 3 seconds
    uf_dbossreturn({_s})

function uf_dbossreturn(s: number):
    if {-uf::sess::%{_s}%::phase} is not "bosswin":
        stop
    uf_arenafree({_s}, "boss")
    if uf_sf({_s}) >= 9:
        uf_dsetphase({_s}, "cleared")
        uf_dend({_s}, "complete")
        stop
    uf_dnext({_s})

# 次の階へ移る。次の階が満員なら待つ（定期チェックで再試行）
function uf_dnext(s: number):
    set {_f} to uf_sf({_s})
    set {_nf} to {_f} + 1
    if {uf::floor::%{_nf}%::start} is not set:
        uf_dsay({_s}, "&e%{_nf}%階は準備中です。ここで挑戦を終了します")
        uf_dend({_s}, "nextnotready")
        stop
    set {_ns} to uf_sfree({_nf})
    if {_ns} < 0:
        if {-uf::sess::%{_s}%::phase} is not "waiting":
            uf_dsetphase({_s}, "waiting")
            uf_dsay({_s}, "&e%{_nf}%階は満員。空き次第、移ります")
        stop
    loop {-uf::sess::%{_s}%::mem::*}:
        if loop-value is online:
            add loop-value to {_mem::*}
    uf_dend({_s}, "advance", false)
    if size of {_mem::*} > 0:
        uf_dbegin({_ns}, {_mem::*})

function uf_dreward(p: player, f: number):
    set {_u} to uuid of {_p}
    set {_pt} to {uf::cfg::clear_pt::%{_f}%}
    if {uf::clear::%{_u}%::%{_f}%} is not true:
        # 先にフラグを立ててから渡す（二重取得防止）
        set {uf::clear::%{_u}%::%{_f}%} to true
        uf_addpt({_p}, {_pt}, "firstclear:%{_f}%")
        if {_f} is 2:
            uf_give({_p}, uf_item("heal_kit"), 3)
            uf_give({_p}, bread, 8)
        else if {_f} is 4:
            uf_give({_p}, uf_item("mat_upgrade"), 3)
        else if {_f} is 9:
            # 完成記念品と最終強化（設計書 10.4）。記念品には名前と日付を入れる
            set {_t} to uf_item("trophy_15")
            set {_day} to now formatted as "yyyy/MM/dd"
            add "&e%{_p}% &7（%{_day}%）" to lore of {_t}
            uf_give({_p}, {_t})
            uf_give({_p}, uf_item("mat_final"))
            broadcast "&6&l[15号館] &e%{_p}% &6が 15号館を制覇した！ おめでとう！"
        uf_geardrop({_p}, {_f}, "first")
        send title "&6初回突破！" with subtitle "&e+%{_pt}%pt" to {_p} for 3 seconds
        uf_msg({_p}, "&6%{_f}%階 初回突破報酬 &e+%{_pt}%pt")
        if {_f} < 9:
            uf_msg({_p}, "&aショップに新しい商品が並んだかもしれない")
        uf_ach({_p}, "clear_%{_f}%")
    else:
        set {_r} to floor({_pt} * {uf::cfg::repeat_rate})
        uf_addpt({_p}, {_r}, "repeatclear:%{_f}%")
        uf_msg({_p}, "&a%{_f}%階 再突破報酬 &e+%{_r}%pt")
        uf_geardrop({_p}, {_f}, "repeat")
    if uf_unlock({_p}) <= {_f}:
        set {uf::unlock::%{_u}%} to min({_f} + 1, 9)
        if {_f} < 9:
            uf_msg({_p}, "&b%{_f} + 1%階 が解放された（次からは受付で%{_f} + 1%階から始められる）")
    add 1 to {uf::stat::%{_u}%::clears}
    uf_addxp({_p}, {_f} * 20)
    uf_questadd({_p}, "dclear", 1)
    uf_achcheck({_p})
    uf_log("dungeon", "reward %{_p}% (%{_u}%) f=%{_f}%")

# ------------------------------------------------------------
# 討伐への貢献（ダメージを与えた人だけが報酬を受け取る＝放置対策）
# ------------------------------------------------------------
on damage:
    set {_mid} to metadata value "uf_mid" of victim
    {_mid} is set
    set {_a} to attacker
    {_a} is a player
    set {_s} to metadata value "uf_sid" of victim
    # その敵のパーティー以外は攻撃できない（報酬の横取り防止。ほかのパーティーの敵はこちらを狙わない）
    if {-uf::sess::%{_s}%::mem::%uuid of {_a}%} is not set:
        cancel event
        stop
    set {-uf::dmg::%{_mid}%::%uuid of {_a}%} to {_a}
    set {-uf::sess::%{_s}%::active::%uuid of {_a}%} to true

# フロアへの出入りの管理（1 秒ごと）
#   ・挑戦中の人がエレベーター・階段などで別の階に入った → 自分の階の復帰地点へ戻す
#   ・挑戦中でない人がフロアに入った → ロビーへ戻す（管理者は除く）
every 1 second:
    uf_on("dungeon") is true
    {uf::cfg::lobby} is set
    loop all players:
        set {_p} to loop-player
        if uf_inworld(location of {_p}, "dungeon") is true:
            set {_mine} to {-uf::insess::%uuid of {_p}%}
            loop integers between 2 and 9:
                set {_f} to loop-value-2
                if {uf::floor::%{_f}%::p1} is set:
                    if {uf::floor::%{_f}%::p2} is set:
                        if uf_inbox(location of {_p}, {uf::floor::%{_f}%::p1}, {uf::floor::%{_f}%::p2}) is true:
                            if {_mine} is set:
                                if uf_sf({_mine}) is not {_f}:
                                    teleport {_p} to uf_scp({_mine})
                                    uf_msg({_p}, "&c挑戦中の%uf_sf({_mine})%階に戻ります")
                            else if uf_admin({_p}) is false:
                                teleport {_p} to {uf::cfg::lobby}
                                uf_msg({_p}, "&c%{_f}%階は、挑戦中のパーティーだけが入れます。1 階の受付から挑戦してください")

on death:
    set {_tier} to metadata value "uf_tier" of victim
    {_tier} is set
    clear drops
    set {_f} to metadata value "uf_floor" of victim
    set {_s} to metadata value "uf_sid" of victim
    set {_mid} to metadata value "uf_mid" of victim
    if {-uf::sess::%{_s}%::on} is not true:
        delete {-uf::dmg::%{_mid}%::*}
        stop
    if {-uf::sess::%{_s}%::skipping} is true:
        delete {-uf::dmg::%{_mid}%::*}
        stop
    set {_pt} to {uf::cfg::reward::%{_tier}%}
    loop {-uf::dmg::%{_mid}%::*}:
        set {_p} to loop-value
        if {_p} is online:
            set {_pp} to {_pt}
            # 防具の能力「幸運」（uf_19_gear.sk）
            if uf_armorabcount({_p}, "lucky") > 0:
                set {_pp} to floor({_pt} * 1.2)
            uf_addpt({_p}, {_pp}, "kill:%{_tier}%")
            uf_addxp({_p}, ceil({_pt} / 2))
            add 1 to {uf::stat::%uuid of {_p}%::dkills}
            uf_questadd({_p}, "dkill", 1)
            uf_achcheck({_p})
            if {_tier} is "mid" or "boss":
                uf_msg({_p}, "&a討伐報酬 &e+%{_pp}%pt")
            if {_tier} is "mid":
                uf_geardrop({_p}, {_f}, "mid")
            # 強化素材・レアドロップ品（uf_19_gear.sk）
            uf_mobdrop({_p}, {_f}, {_tier})
    delete {-uf::dmg::%{_mid}%::*}
    if {_tier} is "mid":
        uf_bbclear({_s})
        uf_dmidwin({_s})
    else if {_tier} is "boss":
        uf_bbclear({_s})
        uf_dbosswin({_s})
    else if {_tier} is "minion":
        remove 1 from {-uf::sess::%{_s}%::minions}
    else:
        remove 1 from {-uf::sess::%{_s}%::alive}

# ------------------------------------------------------------
# 全滅（挑戦中のメンバーが全員倒れている）→ その回は終了
#   uf_06_death.sk の死亡処理から呼ばれる
# ------------------------------------------------------------
function uf_dwipecheck(s: number):
    if {-uf::sess::%{_s}%::on} is not true:
        stop
    loop {-uf::sess::%{_s}%::mem::*}:
        if loop-value is online:
            if {-uf::down::%uuid of loop-value%} is not set:
                stop
    uf_dsay({_s}, "&4全滅… 挑戦は終了です。1 階へ戻ります")
    uf_log("dungeon", "wipe f=%uf_sf({_s})% s=%{_s}%")
    uf_dend({_s}, "wipe")

# ------------------------------------------------------------
# 終了・退出
#   tolobby = false は次の階へ移るとき（帰還の書は持ったまま）
# ------------------------------------------------------------
function uf_dend(s: number, reason: text, tolobby: boolean = true):
    if {-uf::sess::%{_s}%::on} is not true:
        stop
    set {-uf::sess::%{_s}%::on} to false
    delete {-uf::slist::%{_s}%}
    uf_bbclear({_s})
    uf_arenafree({_s}, "mid")
    uf_arenafree({_s}, "boss")
    set {_f} to uf_sf({_s})
    delete {-uf::await::%{_f}%::mid::%{_s}%}
    delete {-uf::await::%{_f}%::boss::%{_s}%}
    loop {-uf::sess::%{_s}%::mobs::*}:
        if loop-value is alive:
            kill loop-value
    loop {-uf::sess::%{_s}%::chestloc::*}:
        set block at loop-value to air
        delete {uf::placedchest::%loop-index%}
    loop {-uf::sess::%{_s}%::mem::*}:
        set {_p} to loop-value
        delete {-uf::insess::%uuid of {_p}%}
        delete {-uf::down::%uuid of {_p}%}
        uf_soulclear({_p})
        if {_tolobby} is true:
            if {_p} is online:
                uf_dtakemap({_p})
                if {uf::cfg::lobby} is set:
                    if {_p} is alive:
                        teleport {_p} to {uf::cfg::lobby}
                    else:
                        set {-uf::tolobby::%uuid of {_p}%} to true
    uf_log("dungeon", "end f=%{_f}% s=%{_s}% reason=%{_reason}%")
    delete {-uf::sess::%{_s}%::*}

# 倒れていた人は、復活したら 1 階へ
on respawn:
    {-uf::tolobby::%uuid of player%} is true
    delete {-uf::tolobby::%uuid of player%}
    {uf::cfg::lobby} is set
    wait 1 tick
    if player is online:
        teleport player to {uf::cfg::lobby}

# 管理者用：今の段階を終わらせて次へ（倒した扱い・報酬なし）。階を渡すと、その階の全部のセッション
function uf_dskipfloor(f: number):
    loop uf_fsess({_f}):
        uf_dskip(loop-value)

function uf_dendfloor(f: number, reason: text):
    loop uf_fsess({_f}):
        uf_dend(loop-value, {_reason})

function uf_dskip(s: number):
    set {_f} to {_s}
    if {-uf::sess::%{_f}%::on} is not true:
        stop
    set {_ph} to {-uf::sess::%{_f}%::phase}
    set {-uf::sess::%{_f}%::skipping} to true
    loop {-uf::sess::%{_f}%::mobs::*}:
        if loop-value is alive:
            set {_t} to metadata value "uf_tier" of loop-value
            if {_ph} is "explore":
                if {_t} is "normal" or "strong" or "elite":
                    kill loop-value
            else if {_ph} is "mid":
                if {_t} is "mid":
                    kill loop-value
            else if {_ph} is "boss":
                if {_t} is "boss":
                    kill loop-value
    delete {-uf::sess::%{_f}%::skipping}
    if {_ph} is "explore":
        if {-uf::sess::%{_f}%::middone} is not true:
            # 中ボスを倒した扱いにして、中ボスの壁の向こう側に出す（壁がなければ倒した扱いだけ）
            set {-uf::sess::%{_f}%::alive} to 0
            set {-uf::sess::%{_f}%::middone} to true
            set {_g} to first element out of {uf::gatecells::%uf_sf({_f})%::mid::*}
            loop {-uf::sess::%{_f}%::mem::*}:
                if loop-value is online:
                    set {_by} to loop-value
            if {_g} is set:
                if {_by} is set:
                    uf_dsetpast({_f}, {_g}, {_by})
                    set {-uf::sess::%{_f}%::cp} to {-uf::sess::%{_f}%::midpast}
                    uf_dmoveall({_f}, {-uf::sess::%{_f}%::midpast})
        else:
            # 中ボスを倒した後なら、ボス戦を始める
            uf_dbossstart({_f})
    else if {_ph} is "mid":
        uf_dmidwin({_f})
    else if {_ph} is "boss":
        uf_dbosswin({_f})

function uf_dleave(p: player):
    set {_f} to {-uf::insess::%uuid of {_p}%}
    if {_f} is not set:
        uf_msg({_p}, "&cダンジョンに挑戦していません")
        stop
    delete {-uf::sess::%{_f}%::mem::%uuid of {_p}%}
    delete {-uf::insess::%uuid of {_p}%}
    delete {-uf::down::%uuid of {_p}%}
    uf_soulclear({_p})
    uf_dtakemap({_p})
    if {uf::cfg::lobby} is set:
        teleport {_p} to {uf::cfg::lobby}
    uf_msg({_p}, "&eダンジョンから退出しました")
    if size of {-uf::sess::%{_f}%::mem::*} is 0:
        uf_dend({_f}, "allleft")
    else:
        uf_dwipecheck({_f})

on quit:
    if {-uf::insess::%uuid of player%} is set:
        uf_dleave(player)

# 時間切れ・全員不在・待ちの再試行・reload で中断された待ちの復旧・空いた階の壁を閉じ直す
every 5 seconds:
    loop integers between 2 and 9:
        set {_f} to loop-value-1
        # 点検で開けた壁は、近くに人がいなければ閉じ直す（挑戦中は壁を開けないので、いつでも閉じてよい）
        loop "mid" and "exit":
            if {uf::gatestate::%{_f}%::%loop-value-2%} is "open":
                if uf_gatenear({_f}, loop-value-2) is false:
                    uf_gateclose({_f}, loop-value-2)
    loop {-uf::slist::*}:
        set {_f} to loop-value-1
        if {-uf::sess::%{_f}%::on} is true:
            set {_ph} to {-uf::sess::%{_f}%::phase}
            set {_el} to {-uf::tick} - {-uf::sess::%{_f}%::tphase}
            # 10分ごとの sk reload all で待ち（wait）が中断されても、ここで先へ進める
            if {_ph} is "midwin":
                if {_el} > 100:
                    uf_dmidreturn({_f})
            else if {_ph} is "bosswin":
                if {_el} > 100:
                    uf_dbossreturn({_f})
            else if {_ph} is "waiting":
                uf_dnext({_f})
            if {-uf::sess::%{_f}%::on} is true:
                if {-uf::tick} - {-uf::sess::%{_f}%::t0} > {uf::cfg::session_minutes} * 1200:
                    uf_dsay({_f}, "&c時間切れ！ 1 階へ戻ります")
                    uf_dend({_f}, "timeout")
                else:
                    set {_any} to false
                    loop {-uf::sess::%{_f}%::mem::*}:
                        if loop-value-2 is online:
                            set {_any} to true
                    if {_any} is true:
                        set {-uf::sess::%{_f}%::seen} to {-uf::tick}
                    else if {-uf::tick} - {-uf::sess::%{_f}%::seen} > 600:
                        uf_dend({_f}, "empty")

# ------------------------------------------------------------
# 宝箱（候補地点から 1〜3 か所。中身は個人別で、1 セッション 1 回）
#   セッションごとに置く。ほかのパーティーの宝箱がある場所には置かない
# ------------------------------------------------------------
function uf_placechests(s: number):
    set {_f} to uf_sf({_s})
    loop {uf::floor::%{_f}%::chest::*}:
        if {uf::placedchest::%uf_lockey(loop-value)%} is not set:
            add loop-value to {_c::*}
    if size of {_c::*} < 1:
        stop
    set {_n} to random integer between {uf::cfg::chest::min} and {uf::cfg::chest::max}
    set {_n} to min({_n}, size of {_c::*})
    loop {_n} times:
        set {_l} to random element out of {_c::*}
        remove {_l} from {_c::*}
        set block at {_l} to chest
        set {_k} to uf_lockey({_l})
        set {-uf::sess::%{_s}%::chestloc::%{_k}%} to {_l}
        set {uf::placedchest::%{_k}%} to {_l}

on right click on chest:
    set {_k} to uf_lockey(location of event-block)
    loop {-uf::slist::*}:
        if {-uf::sess::%loop-value%::chestloc::%{_k}%} is set:
            set {_s} to loop-value
    {_s} is set
    cancel event
    set {_u} to uuid of player
    if {-uf::sess::%{_s}%::mem::%{_u}%} is not set:
        uf_msg(player, "&cこの宝箱はほかのパーティーのものです")
        stop
    if {-uf::sess::%{_s}%::opened::%{_k}%::%{_u}%} is true:
        uf_msg(player, "&7この宝箱はすでに開けた")
        stop
    set {-uf::sess::%{_s}%::opened::%{_k}%::%{_u}%} to true
    uf_chestloot(player, uf_sf({_s}))

function uf_chestloot(p: player, f: number):
    # スキル「宝探しの名人」（uf_07_rpg.sk）: ポイント 1.5 倍
    set {_tm} to 1
    if uf_on("rpg") is true:
        if uf_skill({_p}, "treasure") > 0:
            set {_tm} to 1.5
    set {_sh} to ({_f} - 2) * {uf::cfg::chest::shift}
    set {_wn} to max(0, {uf::cfg::rarity::normal} - 3 * {_sh})
    set {_wr} to {uf::cfg::rarity::rare} + {_sh}
    set {_we} to {uf::cfg::rarity::epic} + 1.5 * {_sh}
    set {_wl} to {uf::cfg::rarity::legendary} + 0.5 * {_sh}
    set {_r} to random number between 0 and ({_wn} + {_wr} + {_we} + {_wl})
    if {_r} < {_wn}:
        set {_pt} to round((random integer between 50 and 120) * {_tm})
        uf_addpt({_p}, {_pt}, "chest:normal")
        if random integer between 1 and 2 is 1:
            uf_give({_p}, uf_item("heal_kit"))
        uf_msg({_p}, "&f[ノーマル] &e+%{_pt}%pt")
    else if {_r} < {_wn} + {_wr}:
        set {_pt} to round((random integer between 120 and 250) * {_tm})
        uf_addpt({_p}, {_pt}, "chest:rare")
        uf_give({_p}, uf_item("mat_upgrade"))
        uf_msg({_p}, "&9[レア] &e+%{_pt}%pt &7と 武器強化素材")
    else if {_r} < {_wn} + {_wr} + {_we}:
        set {_pt} to round((random integer between 250 and 400) * {_tm})
        uf_addpt({_p}, {_pt}, "chest:epic")
        uf_give({_p}, uf_item("mat_special"))
        uf_msg({_p}, "&5[エピック] &e+%{_pt}%pt &7と 特殊素材")
    else:
        set {_k} to random integer between 1 and 3
        if {_k} is 1:
            uf_give({_p}, uf_item("acc_rare"))
            uf_msg({_p}, "&6[レジェンダリー] &f守護のお守り")
        else if {_k} is 2:
            uf_give({_p}, uf_item("mat_part"))
            uf_msg({_p}, "&6[レジェンダリー] &f武器パーツ")
        else:
            if random integer between 1 and 2 is 1:
                set {_it} to uf_item("dgb_%{_f}%")
            else:
                set {_it} to uf_item("dgw_%{_f}%")
            set {_it} to uf_bonusab({_it}, {_f})
            uf_gearbow({_p}, {_it})
            uf_give({_p}, {_it})
            uf_msg({_p}, "&6[レジェンダリー] &f%name of {_it}%")
    uf_log("dungeon", "chest %{_p}% f=%{_f}% roll=%{_r}%")

# ------------------------------------------------------------
# 再起動後の後片付け（挑戦中のセッションがなければ、残った敵と宝箱を消す）
# ------------------------------------------------------------
on load:
    if size of {-uf::slist::*} > 0:
        stop
    loop {uf::placedchest::*}:
        set block at loop-value to air
    delete {uf::placedchest::*}
    loop all entities:
        if loop-entity is not a player:
            if name of loop-entity contains "◆":
                kill loop-entity

# ------------------------------------------------------------
# 管理者用：フロアの設定 /ufd <操作> <階> [種類] [数]
#   （管理者ツールの「ダンジョンの各階」からも同じことができる）
# ------------------------------------------------------------
command /ufd [<text>] [<number>] [<text>] [<number>]:
    description: ダンジョンの設定（管理者）
    permission: univfes.admin
    executable by: players
    trigger:
        set {_a} to arg-1
        if {_a} is not set:
            send "&e/ufd lobby &7: 今いる場所をロビー（1 階・退出先）にする" to player
            send "&e/ufd start|cp|p1|p2 <階> &7: 開始/復帰地点・フロアの範囲" to player
            send "&e/ufd gateopen|gateclose <階> &7: その階の中ボスの壁・階段の壁を開ける/閉じる（点検用）" to player
            send "&e/ufd marena|marenaboss|barena|barenaboss <階> &7: 中ボス/ボス闘技場の入口・出現地点" to player
            send "&e/ufd addspawn|addchest <階> &7: 敵の出現地点/宝箱の候補地点を追加" to player
            send "&e/ufd clearspawn|clearchest <階> &7: 上の地点をすべて消す" to player
            send "&e/ufd count <階> normal|strong|elite <数> &7: 出現数" to player
            send "&e/ufd info|end|skip <階> &7: 設定表示/強制終了/次の段階へ" to player
            stop
        if {_a} is "lobby":
            set {uf::cfg::lobby} to location of player
            uf_msg(player, "&aロビーを設定しました")
            uf_adminlog(player, "ufd lobby %uf_fmtloc(location of player)%")
            stop
        set {_f} to arg-2
        if {_f} is not set:
            uf_msg(player, "&c階（2〜9）を指定してください")
            stop
        if {_f} is not between 2 and 9:
            uf_msg(player, "&c階は 2〜9 です")
            stop
        if {_a} is "start" or "cp" or "mid" or "boss" or "p1" or "p2":
            set {uf::floor::%{_f}%::%{_a}%} to location of player
            uf_msg(player, "&a%{_f}%階 の %{_a}% を設定しました")
        else if {_a} is "gateopen":
            uf_gateopen({_f}, "mid")
            uf_gateopen({_f}, "exit")
            uf_msg(player, "&e%{_f}%階 の壁を開けました（だれも挑戦していなければ、近くに人がいなくなると自動で閉じます）")
        else if {_a} is "gateclose":
            uf_gateclose({_f}, "mid")
            uf_gateclose({_f}, "exit")
            uf_msg(player, "&a%{_f}%階 の壁を閉じました")
        else if {_a} is "marena":
            set {uf::floor::%{_f}%::marena::player} to location of player
            uf_msg(player, "&a%{_f}%階 の中ボス闘技場の入口を設定しました")
        else if {_a} is "marenaboss":
            set {uf::floor::%{_f}%::marena::boss} to location of player
            uf_msg(player, "&a%{_f}%階 の中ボスの出現地点を設定しました")
        else if {_a} is "barena":
            set {uf::floor::%{_f}%::barena::player} to location of player
            uf_msg(player, "&a%{_f}%階 のボス闘技場の入口を設定しました")
        else if {_a} is "barenaboss":
            set {uf::floor::%{_f}%::barena::boss} to location of player
            uf_msg(player, "&a%{_f}%階 のボスの出現地点を設定しました")
        else if {_a} is "addspawn":
            add location of player to {uf::floor::%{_f}%::spawn::*}
            uf_msg(player, "&a出現地点を追加（計 %size of {uf::floor::%{_f}%::spawn::*}%）")
        else if {_a} is "addchest":
            add location of block at location of player to {uf::floor::%{_f}%::chest::*}
            uf_msg(player, "&a宝箱の候補地点を追加（計 %size of {uf::floor::%{_f}%::chest::*}%）")
        else if {_a} is "clearspawn":
            delete {uf::floor::%{_f}%::spawn::*}
            uf_msg(player, "&e出現地点を消去しました")
        else if {_a} is "clearchest":
            delete {uf::floor::%{_f}%::chest::*}
            uf_msg(player, "&e宝箱の候補地点を消去しました")
        else if {_a} is "count":
            if arg-3 is not "normal" or "strong" or "elite":
                uf_msg(player, "&c種類は normal / strong / elite です")
                stop
            if arg-4 is not set:
                uf_msg(player, "&c数を指定してください")
                stop
            if arg-4 is not between 0 and 50:
                uf_msg(player, "&c数は 0〜50 です")
                stop
            set {uf::floor::%{_f}%::count::%arg-3%} to floor(arg-4)
            uf_msg(player, "&a%{_f}%階 の %arg-3% を %floor(arg-4)% 体にしました")
        else if {_a} is "info":
            uf_msg(player, "&e%{_f}%階 の設定")
            loop "start", "cp", "p1", "p2", "marena::player", "marena::boss", "barena::player" and "barena::boss":
                if {uf::floor::%{_f}%::%loop-value%} is set:
                    send "&7%loop-value%: &f%uf_fmtloc({uf::floor::%{_f}%::%loop-value%})%" to player
                else:
                    send "&7%loop-value%: &c未設定" to player
            send "&7出現地点: %size of {uf::floor::%{_f}%::spawn::*}% / 宝箱候補: %size of {uf::floor::%{_f}%::chest::*}%" to player
            set {_cn} to uf_dcount({_f}, "normal")
            set {_cs} to uf_dcount({_f}, "strong")
            set {_ce} to uf_dcount({_f}, "elite")
            send "&7出現数: 通常 %{_cn}% / 強化 %{_cs}% / エリート %{_ce}%" to player
            loop uf_fsess({_f}):
                send "&7挑戦中（%loop-value%）: 段階 %{-uf::sess::%loop-value%::phase}% / 残り %{-uf::sess::%loop-value%::alive}%体" to player
            stop
        else if {_a} is "end":
            uf_dendfloor({_f}, "admin")
            uf_msg(player, "&e%{_f}%階 のセッションを終了しました")
        else if {_a} is "skip":
            if size of uf_fsess({_f}) is 0:
                uf_msg(player, "&cこの階は挑戦中ではありません")
                stop
            uf_dskipfloor({_f})
            uf_msg(player, "&e次の段階へ進めました")
        else:
            uf_msg(player, "&c不明な操作です（/ufd で一覧）")
            stop
        uf_adminlog(player, "ufd %{_a}% %{_f}% %arg-3% %arg-4%")
