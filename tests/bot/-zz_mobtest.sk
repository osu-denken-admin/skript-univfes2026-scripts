# ============================================================
# -zz_mobtest.sk : ダンジョンの敵のテスト用コマンド（テストサーバー専用）
#   先頭の - で本番では読み込まれない。tests/bot/mobs.js がテストサーバーに zz_mobtest.sk として入れる
#   /zzroster          uf_roster の全部の行で、種類・装備・色が読めるか
#   /zzfight <階> <tier> [距離]  その階の挑戦中ということにして（今いる場所を復帰地点にする）、自分の 3（距離）ブロック先に敵を出す
#   /zzhp <階> <割合>   その階の敵の体力を、最大の割合にする（怒るかの確認）
#   /zzend <階>        その階の挑戦を終わらせる（敵と体力のバーが消える）
#   /zzworld <種類> <ワールド|none>  ワールドの登録を変える / /zzmod <名前> <on|off>  モジュールを切り替える
#   /zzarea <名前> x1 y1 z1 x2 y2 z2 / /zzareadel <名前>  区域を登録する・消す（今いるワールド）
#   /zzreward <階>     その階を突破したときの報酬を、自分に渡す（初回なら初回の報酬）
# ============================================================

function uf_zzcheck(f: number, tier: text, ent: text) :: number:
    set {_bad} to 0
    set {_p::*} to split {_ent} at "|"
    if ({_p::1} parsed as entity type) is not set:
        broadcast "BAD type %{_f}% %{_tier}% %{_p::1}%"
        add 1 to {_bad}
    if {_p::5} is set:
        loop split {_p::5} at ",":
            set {_g} to loop-value
            if {_g} starts with "L:":
                set {_q::*} to split {_g} at ":"
                if ({_q::3} parsed as color) is not set:
                    broadcast "BAD color %{_f}% %{_tier}% %{_g}%"
                    add 1 to {_bad}
            else if {_g} starts with "hand:":
                if ((last (length of {_g} - 5) characters of {_g}) parsed as item type) is not set:
                    broadcast "BAD hand %{_f}% %{_tier}% %{_g}%"
                    add 1 to {_bad}
            else if {_g} is not "":
                if ({_g} parsed as item type) is not set:
                    broadcast "BAD item %{_f}% %{_tier}% %{_g}%"
                    add 1 to {_bad}
    return {_bad}

command /zzroster:
    trigger:
        set {_bad} to 0
        set {_n} to 0
        loop integers between 2 and 9:
            loop "normal", "strong", "elite", "mid" and "boss":
                loop uf_roster(loop-value-1, loop-value-2):
                    add 1 to {_n}
                    add uf_zzcheck(loop-value-1, loop-value-2, loop-value-3) to {_bad}
        broadcast "roster n=%{_n}% bad=%{_bad}%"

command /zzfight <number> <text> [<number>]:
    trigger:
        set {uf::mod::dungeon} to true
        set {uf::cfg::world::dungeon} to "%world of player%"
        set {_f} to arg-1
        set {-uf::sess::%{_f}%::on} to true
        set {-uf::sess::%{_f}%::phase} to "explore"
        set {-uf::sess::%{_f}%::mem::%uuid of player%} to player
        set {-uf::insess::%uuid of player%} to {_f}
        set {uf::floor::%{_f}%::cp} to location of player
        set {_d} to arg-3
        if {_d} is not set:
            set {_d} to 3
        uf_spawnmob({_f}, arg-2, location of player ~ vector({_d}, 0, 0))
        broadcast "fight %{_f}% %arg-2%"

command /zzhp <number> <number>:
    trigger:
        loop {-uf::sess::%arg-1%::mobs::*}:
            if loop-value is alive:
                set health of loop-value to (max health of loop-value) * arg-2
        broadcast "hp %arg-1% %arg-2%"

command /zzworld <text> <text>:
    trigger:
        if arg-2 is "none":
            delete {uf::cfg::world::%arg-1%}
        else:
            set {uf::cfg::world::%arg-1%} to arg-2
        broadcast "world %arg-1% %arg-2%"

command /zzmod <text> <text>:
    trigger:
        if arg-2 is "on":
            set {uf::mod::%arg-1%} to true
        else:
            set {uf::mod::%arg-1%} to false
        broadcast "mod %arg-1% %arg-2%"

command /zzarea <text> <number> <number> <number> <number> <number> <number>:
    trigger:
        set {uf::area::%arg-1%::a} to location(arg-2, arg-3, arg-4, world of player)
        set {uf::area::%arg-1%::b} to location(arg-5, arg-6, arg-7, world of player)
        broadcast "area %arg-1%"

command /zzareadel <text>:
    trigger:
        delete {uf::area::%arg-1%::*}
        broadcast "areadel %arg-1%"

command /zzreward <number>:
    trigger:
        uf_dreward(player, arg-1)
        broadcast "reward %arg-1%"

command /zzend <number>:
    trigger:
        uf_dend(arg-1, "test", false)
        broadcast "end %arg-1%"

# 地下カジノ（uf_25_casinohall.sk）: /zzchall build|fill
command /zzchall <text>:
    trigger:
        if arg-1 is "build":
            uf_chbuild(player)
        else:
            uf_chfill(player)
        broadcast "chall %arg-1%"
