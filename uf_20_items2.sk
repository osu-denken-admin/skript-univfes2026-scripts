# ============================================================
# uf_20_items2.sk : ショップで買える、気軽に使えるアイテム（id は it_ で始まる）
#   uf_01_items.sk の uf_item から uf_item2 を呼ぶ。ショップの価格と解放は uf_00_core.sk の uf_shopdef
#   食べ物・飲み物: it_onigiri おにぎり / it_speed スピードドリンク / it_power パワードリンク / it_guard ガードドリンク
#   お守り（オフハンドに持つ。shop モジュールで動く）: it_jump ジャンプのお守り / it_night 暗視ゴーグル
#   道具: it_bomb 電研ボム（ダンジョンの中だけ。投げて、当たったまわりのダンジョンの敵にダメージ。ブロックは壊さない）
#         it_warp 帰還の巻物（ダンジョンの挑戦中に、その階の復帰地点へ戻る。闘技場の中では使えない）
# ============================================================

function uf_item2(id: text) :: item:
    if {_id} is "it_onigiri":
        set {_b} to baked potato
        set {_n} to "&fおにぎり"
        add "&7食べると少し回復する" to {_d::*}
    else if {_id} is "it_speed":
        set {_b} to water bottle
        set {_n} to "&bスピードドリンク"
        add "&7飲むと 30 秒間、足が速くなる" to {_d::*}
    else if {_id} is "it_power":
        set {_b} to water bottle
        set {_n} to "&cパワードリンク"
        add "&7飲むと 30 秒間、力が上がる" to {_d::*}
    else if {_id} is "it_guard":
        set {_b} to water bottle
        set {_n} to "&9ガードドリンク"
        add "&7飲むと 30 秒間、受けるダメージが減る" to {_d::*}
    else if {_id} is "it_jump":
        set {_b} to rabbit foot
        set {_n} to "&aジャンプのお守り"
        add "&7オフハンドに持つと高く跳べる" to {_d::*}
    else if {_id} is "it_night":
        set {_b} to spyglass
        set {_n} to "&e暗視ゴーグル"
        add "&7オフハンドに持つと、暗い所でもよく見える" to {_d::*}
    else if {_id} is "it_bomb":
        set {_b} to fire charge
        set {_n} to "&6電研ボム"
        add "&7右クリックで投げる。当たったまわりの敵にダメージ" to {_d::*}
        add "&7ブロックは壊さない。ダンジョンの中でだけ使える" to {_d::*}
    else if {_id} is "it_warp":
        set {_b} to paper
        set {_n} to "&d帰還の巻物"
        add "&7ダンジョンの挑戦中に右クリックすると、その階の復帰地点に戻る" to {_d::*}
        add "&7中ボス・ボスの闘技場の中では使えない" to {_d::*}
    else:
        return {_none}
    add "&8uf:%{_id}%" to {_d::*}
    return ({_b} named {_n}) with lore {_d::*}

# 食べる・飲む
on consume:
    set {_id} to uf_id(player's tool)
    if {_id} is "":
        set {_id} to uf_id(offhand tool of player)
    {_id} starts with "it_"
    if {_id} is "it_onigiri":
        heal player by 2
        apply regeneration 1 to player for 4 seconds
    else if {_id} is "it_speed":
        apply speed 2 to player for 30 seconds
        uf_msg(player, "&b足が速くなった！（30 秒）")
    else if {_id} is "it_power":
        apply strength 1 to player for 30 seconds
        uf_msg(player, "&c力が上がった！（30 秒）")
    else if {_id} is "it_guard":
        apply resistance 1 to player for 30 seconds
        uf_msg(player, "&9体がかたくなった！（30 秒）")

# お守り（オフハンドに持っている間だけ）
every 2 seconds:
    uf_on("shop") is true
    loop all players:
        set {_id} to uf_id(offhand tool of loop-player)
        if {_id} is "it_jump":
            apply jump boost 2 to loop-player for 3 seconds
        else if {_id} is "it_night":
            apply night vision 1 to loop-player for 15 seconds

# 電研ボム
on right click:
    uf_id(player's tool) is "it_bomb"
    cancel event
    if uf_inworld(location of player, "dungeon") is false:
        uf_msg(player, "&c電研ボムはダンジョンの中でだけ使えます")
        stop
    set {_u} to uuid of player
    if {-uf::bombcd::%{_u}%} is set:
        if {-uf::tick} - {-uf::bombcd::%{_u}%} < 20:
            stop
    set {-uf::bombcd::%{_u}%} to {-uf::tick}
    remove 1 of uf_item("it_bomb") from player's inventory
    make player shoot a snowball at speed 1.3
    set {_s} to last shot snowball
    set metadata value "uf_bomb" of {_s} to player
    play sound "entity.tnt.primed" with volume 0.8 at player

on projectile hit:
    set {_by} to metadata value "uf_bomb" of projectile
    {_by} is set
    set {_l} to location of projectile
    play 2 explosion at {_l}
    play sound "entity.generic.explode" with volume 1 at {_l}
    loop all living entities in radius 3 of {_l}:
        set {_mid} to metadata value "uf_mid" of loop-value
        if {_mid} is set:
            set {_f} to metadata value "uf_floor" of loop-value
            # 挑戦中のパーティーの人が投げたときだけ。討伐の報酬に数える
            if {-uf::sess::%{_f}%::mem::%uuid of {_by}%} is set:
                set {-uf::dmg::%{_mid}%::%uuid of {_by}%} to {_by}
                set {-uf::sess::%{_f}%::active::%uuid of {_by}%} to true
                damage loop-value by 4

# 帰還の巻物
on right click:
    uf_id(player's tool) is "it_warp"
    cancel event
    set {_f} to {-uf::insess::%uuid of player%}
    if {_f} is not set:
        uf_msg(player, "&c帰還の巻物は、ダンジョンの挑戦中にだけ使えます")
        stop
    if {-uf::sess::%{_f}%::phase} is not "explore" or "cleared":
        uf_msg(player, "&c中ボス・ボスとの戦いの間は使えません")
        stop
    set {_cp} to {uf::floor::%{_f}%::cp}
    if {_cp} is not set:
        set {_cp} to {uf::floor::%{_f}%::start}
    if {_cp} is not set:
        stop
    remove 1 of uf_item("it_warp") from player's inventory
    play 20 portal at location of player
    teleport player to {_cp}
    play sound "entity.enderman.teleport" with volume 1 at player
    uf_msg(player, "&d%{_f}%階の復帰地点に戻った")
