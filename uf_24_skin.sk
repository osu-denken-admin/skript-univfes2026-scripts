# ============================================================
# uf_24_skin.sk : 武具とアイテムのスキン（リソースパック）
#   武具と、武具以外のアイテム（2026-10-28 から）には見た目の番号（custom model data）を付け、リソースパック（pack/uf_pack.zip、tools/pack/build.py で作る）で絵を差し替える
#   リソースパックは入ってきた人に送る（GitHub の公開リポジトリから。断っても遊べる）。管理者ツールの「スキン」で送る・送らないを切り替える
#   統合版（Geyser）には送られない（統合版は今の見た目のまま）
#   防具は、身に着けたときの見た目も持ち物の絵に合わせる（装備の見た目 = equippable component の model。2026-10-29 から。Skript 2.13 では実験機能なので下の using が要る）
#   前に手に入れた武具は、入ってきたときに作り直す（強化レベル・能力・あとから付けたエンチャントはそのまま）
#   武具以外のアイテム（番号 1700 から）は作り直さず、番号だけ付ける（数と、制覇の証の名前・日付を残す）
#     弾薬・素材・ボムなどは「同じアイテムか」で数えて消すので、番号のない前のアイテムが残っていると数えられない。
#     そのため、入ってきたとき・画面を閉じたとき（箱から出したもの）・読み込み直したときに付け直す
#   変数: {uf::cfg::skin::enabled}
# ============================================================

using equippable components

# 見た目の番号（0 ならスキンなし）。リソースパックの番号と合わせる（tools/pack/build.py）
function uf_skinid(id: text) :: number:
    if {_id} starts with "dgw_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is set:
            return 1000 + {_f}
        return 0
    if {_id} starts with "dgb_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is set:
            return 1100 + {_f}
        return 0
    if {_id} starts with "dga_":
        set {_q::*} to split {_id} at "_"
        if {_q::2} is "uniform":
            set {_n} to 1210
        else if {_q::2} is "labcoat":
            set {_n} to 1220
        else if {_q::2} is "lord":
            set {_n} to 1230
        else:
            return 0
        if {_q::3} is "helmet":
            return {_n} + 1
        if {_q::3} is "chest":
            return {_n} + 2
        if {_q::3} is "legs":
            return {_n} + 3
        return {_n} + 4
    if {_id} is "cg_sword":
        return 1301
    if {_id} is "cg_bow":
        return 1302
    if {_id} is "cg_helmet":
        return 1303
    if {_id} is "cg_chest":
        return 1304
    if {_id} is "cg_legs":
        return 1305
    if {_id} is "cg_boots":
        return 1306
    if {_id} is "melee_basic":
        return 1401
    if {_id} is "melee_adv":
        return 1402
    if {_id} is "gun_handgun":
        return 1501
    if {_id} is "gun_rifle":
        return 1502
    if {_id} is "gun_shotgun":
        return 1503
    if {_id} is "gun_energy":
        return 1504
    if {_id} is "armor_special":
        return 1601
    # 武具以外のアイテム（1700 から）
    if {_id} starts with "rare_":
        set {_f} to (last (length of {_id} - 5) characters of {_id}) parsed as number
        if {_f} is set:
            return 1900 + {_f}
        return 0
    if {_id} is "heal_kit":
        return 1701
    if {_id} is "ammo":
        return 1702
    if {_id} is "hook":
        return 1703
    if {_id} is "ore_potion":
        return 1704
    if {_id} is "map":
        return 1705
    if {_id} is "admin_tool":
        return 1706
    if {_id} is "trophy_15":
        return 1707
    if {_id} is "sp_potion":
        return 1709
    # ショップの弾薬パックの絵（買うと弾薬 32 発になる。アイテムとしてはない。uf_03_shop.sk の uf_shopicon）
    if {_id} is "ammo_pack":
        return 1708
    if {_id} is "mat_upgrade":
        return 1711
    if {_id} is "mat_special":
        return 1712
    if {_id} is "mat_part":
        return 1713
    if {_id} is "mat_final":
        return 1714
    if {_id} is "acc_basic":
        return 1721
    if {_id} is "acc_rare":
        return 1722
    if {_id} is "tool_pick3":
        return 1731
    if {_id} is "tool_shovel3":
        return 1732
    if {_id} is "tool_axe":
        return 1733
    if {_id} is "bike_key":
        return 1741
    if {_id} is "bike_key_scooter":
        return 1742
    if {_id} is "bike_key_offroad":
        return 1743
    if {_id} is "bike_kit":
        return 1744
    if {_id} is "it_onigiri":
        return 1801
    if {_id} is "it_speed":
        return 1802
    if {_id} is "it_power":
        return 1803
    if {_id} is "it_guard":
        return 1804
    if {_id} is "it_jump":
        return 1805
    if {_id} is "it_night":
        return 1806
    if {_id} is "it_bomb":
        return 1807
    if {_id} is "it_warp":
        return 1808
    return 0

# 身に着けたときの見た目（リソースパックの assets/uf/equipment/<名前>.json。tools/pack/armor.py）。なければ ""
function uf_wornmodel(id: text) :: text:
    if {_id} starts with "dga_":
        set {_q::*} to split {_id} at "_"
        if {_q::2} is "uniform" or "labcoat" or "lord":
            return "uf:%{_q::2}%"
        return ""
    if {_id} is "cg_helmet" or "cg_chest" or "cg_legs" or "cg_boots":
        return "uf:lucky"
    if {_id} is "armor_special":
        return "uf:special"
    return ""

function uf_skin(i: item, id: text) :: item:
    set {_n} to uf_skinid({_id})
    if {_n} > 0:
        set custom model data of {_i} to {_n}
    set {_m} to uf_wornmodel({_id})
    if {_m} is not "":
        set equipped model key of {_i} to {_m}
    return {_i}

# ------------------------------------------------------------
# リソースパックを送る
# ------------------------------------------------------------
function uf_packurl() :: text:
    return "https://raw.githubusercontent.com/osu-denken-admin/skript-univfes2026-scripts/main/pack/uf_pack.zip"

function uf_sendpack(p: player):
    set {_u} to uf_packurl()
    set {_h} to uf_packhash()
    send the resource pack from the url {_u} with hash {_h} to {_p}

on join:
    wait 2 seconds
    player is online
    uf_refreshgear(player)
    {uf::cfg::skin::enabled} is true
    uf_sendpack(player)

on resource pack response:
    the resource pack was declined
    uf_msg(player, "&7スキン（リソースパック）を断りました。武具の見た目が変わらないだけで、遊ぶのには困りません")

# ------------------------------------------------------------
# 前に手に入れた武具を作り直す（スキン・壊れない・今の説明にする）
# ------------------------------------------------------------
# 武具の作り直しの版。強さを変えたら 1 つ上げると、入ってきた人の武具を 1 回だけ作り直す（説明の攻撃力・守りが新しくなる）
function uf_gearrev() :: number:
    return 3

function uf_refreshgear(p: player):
    set {_n} to 0
    set {_force} to false
    if {uf::gearrev::%uuid of {_p}%} is not uf_gearrev():
        set {_force} to true
    loop integers between 0 and 40:
        set {_s} to loop-value
        set {_it} to slot {_s} of inventory of {_p}
        set {_id} to uf_id({_it})
        if {_id} is not "":
            set {_k} to uf_skinid({_id})
            if {_k} >= 1700:
                if custom model data of {_it} is not {_k}:
                    set custom model data of {_it} to {_k}
                    set slot {_s} of inventory of {_p} to {_it}
            else if {_k} > 0:
                set {_re} to {_force}
                if custom model data of {_it} is not {_k}:
                    set {_re} to true
                if {_re} is true:
                    set {_new} to uf_rebuild({_it}, -1, uf_abof({_it}))
                    loop enchantments of {_it}:
                        if {_new} is not enchanted with loop-value-2:
                            enchant {_new} with loop-value-2
                    set slot {_s} of inventory of {_p} to {_new}
                    add 1 to {_n}
    set {uf::gearrev::%uuid of {_p}%} to uf_gearrev()
    if {_n} > 0:
        uf_msg({_p}, "&7持っている武具 %{_n}% 個を新しくした（強くなった・スキンが付いた）")

# 箱・エンダーチェストから出したもの
on inventory close:
    wait 1 tick
    player is online
    uf_refreshgear(player)

# 読み込み直したとき（本番に届いたとき）に入っている人
on load:
    loop all players:
        uf_refreshgear(loop-player)

# リソースパックの SHA-1（tools/pack/build.py が書き換える。変わると、入ってきた人がもう一度読み込む）
function uf_packhash() :: text:
    return "599a66cd937e20da49577176a0ccfa4cd7b79872"
