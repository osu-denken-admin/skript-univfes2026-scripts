# ============================================================
# uf_19_gear.sk : ダンジョン産の武具（階ごとの武器 8 本と、防具 3 セット）
#   ダンジョンのモジュール（dungeon）で動く（特殊武器のモジュールとは別）
#   武器 dgw_<階>: その階のボスから。初回突破では必ず 1 本。/upgrade で強化できる（強化 1 レベルにつき +10％）
#     手に持って敵を叩くと、武器ごとの効果（uf_gearhit）。プレイヤーには効果なし
#   防具 dga_<セット>_<部位>（helmet / chest / legs / boots）。4 つそろえるとセットの効果（2 秒ごと）
#     uniform 制服（2〜4 階）: 足が速くなる / labcoat 白衣（5〜7 階）: 少しずつ回復 / lord 主の鎧（8・9 階）: 力が上がる・火に強い
#   落ちる場所（uf_geardrop）: ボス（初回は武器を必ず。2 回目からは gear::boss_weapon の確率で武器、だめなら gear::boss_armor で防具）
#     中ボス（gear::mid_armor の確率で防具）、レジェンダリーの宝箱（3 分の 1 でその階の武器。uf_05_dungeon.sk の uf_chestloot）
# ============================================================

function uf_gearitem(id: text, lv: number) :: item:
    if {_id} starts with "dgw_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is 2:
            set {_b} to iron sword
            set {_n} to "&aさしぼうソード"
            add "&7教室棟のボスが持っていた指し棒。よくしなる" to {_d::*}
        else if {_f} is 3:
            set {_b} to iron sword
            set {_n} to "&aじしょブレード"
            add "&7当てた敵を大きくふきとばす" to {_d::*}
        else if {_f} is 4:
            set {_b} to iron axe
            set {_n} to "&aフラスコアックス"
            add "&7当てた敵を毒にする" to {_d::*}
        else if {_f} is 5:
            set {_b} to diamond sword
            set {_n} to "&9LANケーブルソード"
            add "&7ときどき近くの敵にも電気が流れる" to {_d::*}
        else if {_f} is 6:
            set {_b} to diamond axe
            set {_n} to "&9フォークリフトアックス"
            add "&7当てた敵の動きを遅くする" to {_d::*}
        else if {_f} is 7:
            set {_b} to diamond sword
            set {_n} to "&9万年筆ブレード"
            add "&7ときどき 2 倍のダメージ" to {_d::*}
        else if {_f} is 8:
            set {_b} to netherite sword
            set {_n} to "&6封鎖区画のカギ"
            add "&7ときどき敵の体力を吸い取る" to {_d::*}
        else if {_f} is 9:
            set {_b} to netherite sword
            set {_n} to "&6&l15号館の主の剣"
            add "&7当てた敵を燃やし、まわりの敵にもダメージ" to {_d::*}
        else:
            return {_none}
        add "&8%{_f}%階のボスから手に入る" to {_d::*}
        add "&8uf:%{_id}%" to {_d::*}
        add "&7強化レベル: &e%{_lv}%" to {_d::*}
        add "&8uflv:%{_lv}%" to {_d::*}
        return ({_b} named {_n}) with lore {_d::*}
    # 防具
    set {_q::*} to split {_id} at "_"
    set {_set} to {_q::2}
    set {_part} to {_q::3}
    if {_set} is "uniform":
        set {_b} to uf_leather({_part}, blue)
        enchant {_b} with protection 1
        set {_sn} to "&a制服"
        set {_fx} to "&7セットの効果: 足が速くなる"
        set {_from} to "&82〜4 階の中ボス・ボスから手に入る"
    else if {_set} is "labcoat":
        if {_part} is "helmet":
            set {_b} to iron helmet
        else if {_part} is "chest":
            set {_b} to iron chestplate
        else if {_part} is "legs":
            set {_b} to iron leggings
        else:
            set {_b} to iron boots
        enchant {_b} with protection 2
        set {_sn} to "&9白衣"
        set {_fx} to "&7セットの効果: 少しずつ体力が回復する"
        set {_from} to "&85〜7 階の中ボス・ボスから手に入る"
    else if {_set} is "lord":
        if {_part} is "helmet":
            set {_b} to netherite helmet
        else if {_part} is "chest":
            set {_b} to netherite chestplate
        else if {_part} is "legs":
            set {_b} to netherite leggings
        else:
            set {_b} to netherite boots
        enchant {_b} with protection 2
        set {_sn} to "&6主の鎧"
        set {_fx} to "&7セットの効果: 力が上がる・火に強くなる"
        set {_from} to "&88・9 階の中ボス・ボスから手に入る"
    else:
        return {_none}
    if {_part} is "helmet":
        set {_pn} to "（かぶと）"
    else if {_part} is "chest":
        set {_pn} to "（上着）"
    else if {_part} is "legs":
        set {_pn} to "（ズボン）"
    else:
        set {_pn} to "（くつ）"
    add "&74 つそろえるとセットの効果" to {_d::*}
    add {_fx} to {_d::*}
    add {_from} to {_d::*}
    add "&8uf:%{_id}%" to {_d::*}
    return ({_b} named "%{_sn}%%{_pn}%") with lore {_d::*}

function uf_gearmult(id: text) :: number:
    if {_id} is "dgw_9":
        return 1.3
    if {_id} is "dgw_3" or "dgw_7":
        return 1.15
    if {_id} is "dgw_4" or "dgw_6":
        return 1
    return 1.1

# ------------------------------------------------------------
# 特殊能力の一覧。階ごとに、武器の能力と防具の能力が 1 つずつ決まっている
#   その階の武器（dgw_<階>）は、はじめからその階の武器の能力を持つ
#   鍛冶屋（uf_22_smith.sk）で、その階のレアドロップ品を使って武具に能力を 1 つ付けられる
# ------------------------------------------------------------
function uf_rareab(f: number) :: text:
    if {_f} is 2:
        return "haste"
    if {_f} is 3:
        return "knock"
    if {_f} is 4:
        return "poison"
    if {_f} is 5:
        return "zap"
    if {_f} is 6:
        return "slow"
    if {_f} is 7:
        return "crit"
    if {_f} is 8:
        return "drain"
    return "fire"

function uf_rareabarmor(f: number) :: text:
    if {_f} is 2:
        return "swift"
    if {_f} is 3:
        return "guard"
    if {_f} is 4:
        return "antidote"
    if {_f} is 5:
        return "thorns"
    if {_f} is 6:
        return "regen"
    if {_f} is 7:
        return "lucky"
    if {_f} is 8:
        return "dodge"
    return "might"

function uf_abname(ab: text) :: text:
    if {_ab} is "haste":
        return "疾風"
    if {_ab} is "knock":
        return "ふきとばし"
    if {_ab} is "poison":
        return "毒"
    if {_ab} is "zap":
        return "雷"
    if {_ab} is "slow":
        return "足止め"
    if {_ab} is "crit":
        return "会心"
    if {_ab} is "drain":
        return "吸収"
    if {_ab} is "fire":
        return "業火"
    if {_ab} is "swift":
        return "俊足"
    if {_ab} is "guard":
        return "鉄壁"
    if {_ab} is "antidote":
        return "解毒"
    if {_ab} is "thorns":
        return "反撃"
    if {_ab} is "regen":
        return "再生"
    if {_ab} is "lucky":
        return "幸運"
    if {_ab} is "dodge":
        return "回避"
    if {_ab} is "might":
        return "剛力"
    return {_ab}

# ------------------------------------------------------------
# 階ごとのレアドロップ品（rare_<階>）と、敵のドロップ
#   レアドロップ品は鍛冶屋（uf_22_smith.sk）で、その階のテーマの特殊能力を武具に付ける材料になる
#   ドロップは、倒した敵にダメージを与えた人それぞれに直接渡す（地面に落とさない＝横取りされない）
#   確率は uf_00_core.sk の drop::<tier>::<素材>（％）。ボスが呼ぶ手下（minion）からは落ちない
# ------------------------------------------------------------
function uf_rarename(f: number) :: text:
    if {_f} is 2:
        return "&c先生の赤ペン"
    if {_f} is 3:
        return "&6古文書のページ"
    if {_f} is 4:
        return "&a光る試薬"
    if {_f} is 5:
        return "&b壊れた基板"
    if {_f} is 6:
        return "&e警備員の鍵束"
    if {_f} is 7:
        return "&d教授の研究ノート"
    if {_f} is 8:
        return "&8錆びた封鎖の鍵"
    return "&5&l15号館の主のかけら"

function uf_rareitem(id: text) :: item:
    set {_f} to (last (length of {_id} - 5) characters of {_id}) parsed as number
    if {_f} is not set:
        return {_none}
    if {_f} < 2:
        return {_none}
    if {_f} > 9:
        return {_none}
    if {_f} is 2:
        set {_b} to red dye
    else if {_f} is 3:
        set {_b} to paper
    else if {_f} is 4:
        set {_b} to glow ink sac
    else if {_f} is 5:
        set {_b} to redstone
    else if {_f} is 6:
        set {_b} to tripwire hook
    else if {_f} is 7:
        set {_b} to writable book
    else if {_f} is 8:
        set {_b} to iron nugget
    else:
        set {_b} to echo shard
    add "&7%{_f}%階の敵がまれに落とすレアドロップ品" to {_d::*}
    add "&7鍛冶屋で、武器に「%uf_abname(uf_rareab({_f}))%」、防具に「%uf_abname(uf_rareabarmor({_f}))%」の能力を付ける材料" to {_d::*}
    add "&8uf:%{_id}%" to {_d::*}
    return ({_b} named uf_rarename({_f})) with lore {_d::*}

# 倒した人 1 人ぶんのドロップ
function uf_mobdrop(p: player, f: number, tier: text):
    if {_tier} is "minion":
        stop
    loop "mat_upgrade", "rare", "mat_special" and "mat_part":
        set {_k} to loop-value
        set {_n} to 0
        set {_sure} to {uf::cfg::drop::%{_tier}%::%{_k}%::sure}
        if {_sure} is set:
            set {_n} to {_sure}
        set {_rate} to {uf::cfg::drop::%{_tier}%::%{_k}%}
        if {_rate} is set:
            if random number between 0 and 100 < {_rate}:
                add 1 to {_n}
        if {_n} > 0:
            if {_k} is "rare":
                set {_it} to uf_item("rare_%{_f}%")
            else:
                set {_it} to uf_item({_k})
            uf_give({_p}, {_it}, {_n})
            if {_k} is "mat_upgrade":
                uf_msg({_p}, "&7ドロップ: &f%name of {_it}% ×%{_n}%")
            else:
                uf_msg({_p}, "&6レアドロップ！ &f%name of {_it}% ×%{_n}%")
                play sound "entity.player.levelup" with volume 0.6 at {_p}
            uf_log("item", "drop %{_p}% (%uuid of {_p}%) %uf_id({_it})% x%{_n}% f=%{_f}% tier=%{_tier}%")

# 階に合う防具のセット
function uf_gearsetof(f: number) :: text:
    if {_f} <= 4:
        return "uniform"
    if {_f} <= 7:
        return "labcoat"
    return "lord"

# kind: first（初回突破）/ repeat（2 回目からの突破）/ mid（中ボス）
function uf_geardrop(p: player, f: number, kind: text):
    set {_w} to "dgw_%{_f}%"
    set {_parts::*} to "helmet", "chest", "legs" and "boots"
    set {_pt} to random element out of {_parts::*}
    set {_a} to "dga_%uf_gearsetof({_f})%_%{_pt}%"
    if {_kind} is "first":
        set {_it} to uf_item({_w})
    else if {_kind} is "repeat":
        if random number between 0 and 1 < {uf::cfg::gear::boss_weapon}:
            set {_it} to uf_item({_w})
        else if random number between 0 and 1 < {uf::cfg::gear::boss_armor}:
            set {_it} to uf_item({_a})
    else:
        if random number between 0 and 1 < {uf::cfg::gear::mid_armor}:
            set {_it} to uf_item({_a})
    if {_it} is not set:
        stop
    uf_give({_p}, {_it})
    uf_msg({_p}, "&6武具を手に入れた！ &f%name of {_it}%")
    play sound "entity.player.levelup" with volume 1 at {_p}
    uf_log("item", "gear %{_p}% (%uuid of {_p}%) %uf_id({_it})% f=%{_f}% kind=%{_kind}%")

# ------------------------------------------------------------
# 武器の効果
# ------------------------------------------------------------
on damage:
    damage cause is attack
    set {_a} to attacker
    {_a} is a player
    set {_id} to uf_id(tool of {_a})
    {_id} starts with "dgw_"
    uf_on("dungeon") is true
    set {_v} to victim
    {_v} is not a player
    set damage to damage * uf_gearmult({_id}) * (1 + 0.1 * uf_lv(tool of {_a}))
    if {_id} is "dgw_7":
        if random number between 0 and 1 < 0.15:
            set damage to damage * 2
            play 10 crit at location of {_v}
            play sound "entity.player.attack.crit" with volume 1 at {_v}
    uf_gearhit({_a}, {_v}, {_id})

function uf_gearhit(a: player, v: entity, id: text):
    if {_id} is "dgw_3":
        set {_d} to normalized vector from {_a} to {_v}
        push {_v} {_d} at speed 0.9
        push {_v} upwards at speed 0.3
    else if {_id} is "dgw_4":
        apply poison 1 to {_v} for 3 seconds
    else if {_id} is "dgw_5":
        if random number between 0 and 1 < 0.25:
            loop all living entities in radius 4 of location of {_v}:
                if loop-value is not {_v}:
                    if metadata value "uf_tier" of loop-value is set:
                        damage loop-value by 1.5
                        play 5 crit at location of loop-value
                        play sound "block.beacon.power_select" with volume 0.6 at loop-value
                        stop
    else if {_id} is "dgw_6":
        apply slowness 2 to {_v} for 2 seconds
    else if {_id} is "dgw_8":
        if random number between 0 and 1 < 0.25:
            heal {_a} by 1
            play 3 heart at location of {_a}
    else if {_id} is "dgw_9":
        ignite {_v} for 3 seconds
        loop all living entities in radius 3 of location of {_v}:
            if loop-value is not {_v}:
                if metadata value "uf_tier" of loop-value is set:
                    damage loop-value by 1

# ------------------------------------------------------------
# 防具のセットの効果
# ------------------------------------------------------------
function uf_gearset(p: player) :: text:
    set {_h} to uf_id(helmet of {_p})
    if {_h} does not start with "dga_":
        return ""
    set {_q::*} to split {_h} at "_"
    set {_s} to {_q::2}
    if uf_id(chestplate of {_p}) is not "dga_%{_s}%_chest":
        return ""
    if uf_id(leggings of {_p}) is not "dga_%{_s}%_legs":
        return ""
    if uf_id(boots of {_p}) is not "dga_%{_s}%_boots":
        return ""
    return {_s}

every 2 seconds:
    uf_on("dungeon") is true
    loop all players:
        set {_s} to uf_gearset(loop-player)
        if {_s} is "uniform":
            apply speed 1 to loop-player for 3 seconds
        else if {_s} is "labcoat":
            apply regeneration 1 to loop-player for 3 seconds
        else if {_s} is "lord":
            apply strength 1 to loop-player for 3 seconds
            apply fire resistance 1 to loop-player for 3 seconds
