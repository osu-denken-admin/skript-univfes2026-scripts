# ============================================================
# uf_19_gear.sk : ダンジョン産の武具（階ごとの武器 8 本と、防具 3 セット）
#   ダンジョンのモジュール（dungeon）で動く（特殊武器のモジュールとは別）
#   武器 dgw_<階>（剣・斧）と dgb_<階>（弓。無限つき）: その階のボスから。初回突破では dgw を必ず 1 本。2 回目からは dgw か dgb
#     鍛冶屋（/upgrade）で強化できる（強化 1 レベルにつき +15％。Lv10 で 2.5 倍）
#     攻撃力は uf_wpow（敵の体力のバーと同じ単位。Lv0 のとき）。説明に「攻撃力」として出す。どれも壊れない
#   掘り出し物: 武具が出るとき gear::bonus_ab の確率で、その階までのどれかの能力がはじめから 1 つ付いている
#     手に持って敵を叩くと、特殊能力の効果（uf_abhit）。はじめからその階の能力を持ち、鍛冶屋でもう 1 つ付けられる。プレイヤーには効果なし
#   防具 dga_<セット>_<部位>（helmet / chest / legs / boots）。4 つそろえるとセットの効果（2 秒ごと）
#     uniform 制服（2〜4 階）: 速さ 2 / labcoat 白衣（5〜7 階）: 再生 2 / lord 主の鎧（8・9 階）: 力 2・耐性・火に強い
#     どの防具も 1 つにつき受けるダメージが減る（uf_armordefof。合計は最大 60％）
#   落ちる場所（uf_geardrop）: ボス（初回は武器を必ず。2 回目からは gear::boss_weapon の確率で武器、だめなら gear::boss_armor で防具）
#     中ボス（gear::mid_armor の確率で防具）、レジェンダリーの宝箱（3 分の 1 でその階の武器。uf_05_dungeon.sk の uf_chestloot）
# ============================================================

function uf_bowname(f: number) :: text:
    if {_f} is 2:
        return "&aチョークボウ"
    if {_f} is 3:
        return "&aしおりの弓"
    if {_f} is 4:
        return "&a試験管ボウ"
    if {_f} is 5:
        return "&9光ファイバーの弓"
    if {_f} is 6:
        return "&9物干し竿の弓"
    if {_f} is 7:
        return "&9指示棒の弓"
    if {_f} is 8:
        return "&6封鎖の大弓"
    return "&6&l15号館の主の天弓"

function uf_gearitem(id: text, lv: number) :: item:
    if {_id} starts with "dgb_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is not set:
            return {_none}
        if {_f} < 2:
            return {_none}
        if {_f} > 9:
            return {_none}
        set {_b} to bow
        enchant {_b} with infinity 1
        add "&7矢が 1 本あれば、いくらでも撃てる" to {_d::*}
        add uf_atklore({_id}, {_lv}) to {_d::*}
        add "&dはじめからの能力: %uf_abname(uf_rareab({_f}))%" to {_d::*}
        add "&8%{_f}%階のボスから手に入る" to {_d::*}
        add "&8uf:%{_id}%" to {_d::*}
        add "&7強化レベル: &e%{_lv}%" to {_d::*}
        add "&8uflv:%{_lv}%" to {_d::*}
        return uf_skin(unbreakable (({_b} named uf_bowname({_f})) with lore {_d::*}), {_id})
    if {_id} starts with "dgw_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is 2:
            set {_b} to iron sword
            set {_n} to "&aさしぼうソード"
            add "&7教室棟のボスが持っていた指し棒。当てると少し足が速くなる" to {_d::*}
        else if {_f} is 3:
            set {_b} to iron sword
            set {_n} to "&aじしょブレード"
            add "&7当てた敵を大きくふきとばす" to {_d::*}
        else if {_f} is 4:
            set {_b} to iron axe
            set {_n} to "&aフラスコアックス"
            add "&7当てた敵を毒にする" to {_d::*}
        else if {_f} is 5:
            set {_b} to diamond sword
            set {_n} to "&9LANケーブルソード"
            add "&7ときどき近くの敵にも電気が流れる" to {_d::*}
        else if {_f} is 6:
            set {_b} to diamond axe
            set {_n} to "&9フォークリフトアックス"
            add "&7当てた敵の動きを遅くする" to {_d::*}
        else if {_f} is 7:
            set {_b} to diamond sword
            set {_n} to "&9万年筆ブレード"
            add "&7ときどき 2 倍のダメージ" to {_d::*}
        else if {_f} is 8:
            set {_b} to netherite sword
            set {_n} to "&6封鎖区画のカギ"
            add "&7ときどき敵の体力を吸い取る" to {_d::*}
        else if {_f} is 9:
            set {_b} to netherite sword
            set {_n} to "&6&l15号館の主の剣"
            add "&7当てた敵を燃やし、まわりの敵にもダメージ" to {_d::*}
        else:
            return {_none}
        add uf_atklore({_id}, {_lv}) to {_d::*}
        add "&dはじめからの能力: %uf_abname(uf_rareab({_f}))%" to {_d::*}
        add "&8%{_f}%階のボスから手に入る" to {_d::*}
        add "&8uf:%{_id}%" to {_d::*}
        add "&7強化レベル: &e%{_lv}%" to {_d::*}
        add "&8uflv:%{_lv}%" to {_d::*}
        return uf_skin(unbreakable (({_b} named {_n}) with lore {_d::*}), {_id})
    # 防具
    set {_q::*} to split {_id} at "_"
    set {_set} to {_q::2}
    set {_part} to {_q::3}
    if {_set} is "uniform":
        set {_b} to uf_leather({_part}, blue)
        enchant {_b} with protection 3
        set {_sn} to "&a制服"
        set {_fx} to "&7セットの効果: 足がとても速くなる"
        set {_from} to "&82〜4 階の中ボス・ボスから手に入る"
    else if {_set} is "labcoat":
        if {_part} is "helmet":
            set {_b} to iron helmet
        else if {_part} is "chest":
            set {_b} to iron chestplate
        else if {_part} is "legs":
            set {_b} to iron leggings
        else:
            set {_b} to iron boots
        enchant {_b} with protection 3
        set {_sn} to "&9白衣"
        set {_fx} to "&7セットの効果: どんどん体力が回復する"
        set {_from} to "&85〜7 階の中ボス・ボスから手に入る"
    else if {_set} is "lord":
        if {_part} is "helmet":
            set {_b} to netherite helmet
        else if {_part} is "chest":
            set {_b} to netherite chestplate
        else if {_part} is "legs":
            set {_b} to netherite leggings
        else:
            set {_b} to netherite boots
        enchant {_b} with protection 4
        set {_sn} to "&6主の鎧"
        set {_fx} to "&7セットの効果: 力が大きく上がる・ダメージに強い・火に強い"
        set {_from} to "&88・9 階の中ボス・ボスから手に入る"
    else:
        return {_none}
    if {_part} is "helmet":
        set {_pn} to "（かぶと）"
    else if {_part} is "chest":
        set {_pn} to "（上着）"
    else if {_part} is "legs":
        set {_pn} to "（ズボン）"
    else:
        set {_pn} to "（くつ）"
    add "&b守り: 受けるダメージ -%uf_armordefof({_id}) * 100%％（1 つにつき）" to {_d::*}
    add "&74 つそろえるとセットの効果" to {_d::*}
    add {_fx} to {_d::*}
    add {_from} to {_d::*}
    add "&8uf:%{_id}%" to {_d::*}
    return uf_skin(unbreakable (({_b} named "%{_sn}%%{_pn}%") with lore {_d::*}), {_id})

# ------------------------------------------------------------
# 攻撃力（2026-10-28 に見直し。前は素の武器の 1.1〜1.3 倍で、敵に比べて弱すぎた）
#   uf_wpow: Lv0 で 1 回当てたときのダメージ（敵の体力のバーと同じ単位）。強化 1 レベルにつき +15％
#   近接は、溜めた一撃のときこの値になるよう、素の武器のダメージ（uf_wbase）との比をかける（溜め・会心・ダメージ増加のエンチャントはそのまま効く）
#   弓は、引き切ったときの矢（およそ 3）との比
# ------------------------------------------------------------
function uf_wpow(id: text) :: number:
    if {_id} starts with "dgw_":
        set {_f} to (last (length of {_id} - 4) characters of {_id}) parsed as number
        if {_f} is 2:
            return 8
        if {_f} is 3:
            return 10
        if {_f} is 4:
            return 12
        if {_f} is 5:
            return 15
        if {_f} is 6:
            return 18
        if {_f} is 7:
            return 21
        if {_f} is 8:
            return 25
        return 30
    if {_id} starts with "dgb_":
        set {_w} to "dgw_%last (length of {_id} - 4) characters of {_id}%"
        return uf_wpow({_w}) * 0.8
    if {_id} is "cg_sword":
        return 32
    if {_id} is "cg_bow":
        return 26
    if {_id} is "melee_basic":
        return 3 * {uf::cfg::melee::melee_basic}
    if {_id} is "melee_adv":
        return 3.5 * {uf::cfg::melee::melee_adv}
    if {_id} starts with "gun_":
        return {uf::cfg::gun::%{_id}%::dmg} * {uf::cfg::gun::%{_id}%::pellets}
    return 0

function uf_lvmult(lv: number) :: number:
    return 1 + 0.15 * {_lv}

# 素の武器のダメージ（敵の体力のバーの単位）
function uf_wbase(i: item) :: number:
    if {_i} is a bow:
        return 3
    if {_i} is an iron axe or diamond axe:
        return 4.5
    if {_i} is a netherite axe:
        return 5
    if {_i} is a netherite sword:
        return 4
    if {_i} is a diamond sword:
        return 3.5
    return 3

function uf_atklore(id: text, lv: number) :: text:
    set {_x} to round(uf_wpow({_id}) * uf_lvmult({_lv}) * 10) / 10
    if {_id} is "gun_shotgun":
        return "&c攻撃力: %{_x}%（散弾が全部当たったとき）"
    return "&c攻撃力: %{_x}%"

# ------------------------------------------------------------
# 特殊能力の一覧。階ごとに、武器の能力と防具の能力が 1 つずつ決まっている
#   その階の武器（dgw_<階>）は、はじめからその階の武器の能力を持つ
#   鍛冶屋（uf_22_smith.sk）で、その階のレアドロップ品を使って武具に能力を 1 つ付けられる
# ------------------------------------------------------------
function uf_rareab(f: number) :: text:
    if {_f} is 2:
        return "haste"
    if {_f} is 3:
        return "knock"
    if {_f} is 4:
        return "poison"
    if {_f} is 5:
        return "zap"
    if {_f} is 6:
        return "slow"
    if {_f} is 7:
        return "crit"
    if {_f} is 8:
        return "drain"
    return "fire"

function uf_rareabarmor(f: number) :: text:
    if {_f} is 2:
        return "swift"
    if {_f} is 3:
        return "guard"
    if {_f} is 4:
        return "antidote"
    if {_f} is 5:
        return "thorns"
    if {_f} is 6:
        return "regen"
    if {_f} is 7:
        return "lucky"
    if {_f} is 8:
        return "dodge"
    return "might"

function uf_abname(ab: text) :: text:
    if {_ab} is "haste":
        return "疾風"
    if {_ab} is "knock":
        return "ふきとばし"
    if {_ab} is "poison":
        return "毒"
    if {_ab} is "zap":
        return "雷"
    if {_ab} is "slow":
        return "足止め"
    if {_ab} is "crit":
        return "会心"
    if {_ab} is "drain":
        return "吸収"
    if {_ab} is "fire":
        return "業火"
    if {_ab} is "swift":
        return "俊足"
    if {_ab} is "guard":
        return "鉄壁"
    if {_ab} is "antidote":
        return "解毒"
    if {_ab} is "thorns":
        return "反撃"
    if {_ab} is "regen":
        return "再生"
    if {_ab} is "lucky":
        return "幸運"
    if {_ab} is "dodge":
        return "回避"
    if {_ab} is "might":
        return "剛力"
    return {_ab}

# ------------------------------------------------------------
# 階ごとのレアドロップ品（rare_<階>）と、敵のドロップ
#   レアドロップ品は鍛冶屋（uf_22_smith.sk）で、その階のテーマの特殊能力を武具に付ける材料になる
#   ドロップは、倒した敵にダメージを与えた人それぞれに直接渡す（地面に落とさない＝横取りされない）
#   確率は uf_00_core.sk の drop::<tier>::<素材>（％）。ボスが呼ぶ手下（minion）からは落ちない
# ------------------------------------------------------------
function uf_rarename(f: number) :: text:
    if {_f} is 2:
        return "&c先生の赤ペン"
    if {_f} is 3:
        return "&6古文書のページ"
    if {_f} is 4:
        return "&a光る試薬"
    if {_f} is 5:
        return "&b壊れた基板"
    if {_f} is 6:
        return "&e警備員の鍵束"
    if {_f} is 7:
        return "&d教授の研究ノート"
    if {_f} is 8:
        return "&8錆びた封鎖の鍵"
    return "&5&l15号館の主のかけら"

function uf_rareitem(id: text) :: item:
    set {_f} to (last (length of {_id} - 5) characters of {_id}) parsed as number
    if {_f} is not set:
        return {_none}
    if {_f} < 2:
        return {_none}
    if {_f} > 9:
        return {_none}
    if {_f} is 2:
        set {_b} to red dye
    else if {_f} is 3:
        set {_b} to paper
    else if {_f} is 4:
        set {_b} to glow ink sac
    else if {_f} is 5:
        set {_b} to redstone
    else if {_f} is 6:
        set {_b} to tripwire hook
    else if {_f} is 7:
        set {_b} to writable book
    else if {_f} is 8:
        set {_b} to iron nugget
    else:
        set {_b} to echo shard
    add "&7%{_f}%階の敵がまれに落とすレアドロップ品" to {_d::*}
    add "&7鍛冶屋で、武器に「%uf_abname(uf_rareab({_f}))%」、防具に「%uf_abname(uf_rareabarmor({_f}))%」の能力を付ける材料" to {_d::*}
    add "&8uf:%{_id}%" to {_d::*}
    return ({_b} named uf_rarename({_f})) with lore {_d::*}

# 倒した人 1 人ぶんのドロップ
function uf_mobdrop(p: player, f: number, tier: text):
    if {_tier} is "minion":
        stop
    loop "mat_upgrade", "rare", "mat_special" and "mat_part":
        set {_k} to loop-value
        set {_n} to 0
        set {_sure} to {uf::cfg::drop::%{_tier}%::%{_k}%::sure}
        if {_sure} is set:
            set {_n} to {_sure}
        set {_rate} to {uf::cfg::drop::%{_tier}%::%{_k}%}
        if {_rate} is set:
            if random number between 0 and 100 < {_rate}:
                add 1 to {_n}
        if {_n} > 0:
            if {_k} is "rare":
                set {_it} to uf_item("rare_%{_f}%")
            else:
                set {_it} to uf_item({_k})
            uf_give({_p}, {_it}, {_n})
            if {_k} is "mat_upgrade":
                uf_msg({_p}, "&7ドロップ: &f%name of {_it}% ×%{_n}%")
            else:
                uf_msg({_p}, "&6レアドロップ！ &f%name of {_it}% ×%{_n}%")
                play sound "entity.player.levelup" with volume 0.6 at {_p}
            uf_log("item", "drop %{_p}% (%uuid of {_p}%) %uf_id({_it})% x%{_n}% f=%{_f}% tier=%{_tier}%")

# 階に合う防具のセット
function uf_gearsetof(f: number) :: text:
    if {_f} <= 4:
        return "uniform"
    if {_f} <= 7:
        return "labcoat"
    return "lord"

# kind: first（初回突破）/ repeat（2 回目からの突破）/ mid（中ボス）
function uf_geardrop(p: player, f: number, kind: text):
    set {_w} to "dgw_%{_f}%"
    set {_parts::*} to "helmet", "chest", "legs" and "boots"
    set {_pt} to random element out of {_parts::*}
    set {_a} to "dga_%uf_gearsetof({_f})%_%{_pt}%"
    if {_kind} is "first":
        set {_it} to uf_item({_w})
    else if {_kind} is "repeat":
        if random number between 0 and 1 < {uf::cfg::gear::boss_weapon}:
            if random integer between 1 and 2 is 1:
                set {_it} to uf_item("dgb_%{_f}%")
            else:
                set {_it} to uf_item({_w})
        else if random number between 0 and 1 < {uf::cfg::gear::boss_armor}:
            set {_it} to uf_item({_a})
    else:
        if random number between 0 and 1 < {uf::cfg::gear::mid_armor}:
            set {_it} to uf_item({_a})
    if {_it} is not set:
        stop
    set {_it} to uf_bonusab({_it}, {_f})
    uf_gearbow({_p}, {_it})
    uf_give({_p}, {_it})
    uf_msg({_p}, "&6武具を手に入れた！ &f%name of {_it}%")
    set {_x} to uf_abof({_it})
    if {_x} is not "":
        uf_msg({_p}, "&d掘り出し物！ 特殊能力「%uf_abname({_x})%」つき")
    play sound "entity.player.levelup" with volume 1 at {_p}
    uf_log("item", "gear %{_p}% (%uuid of {_p}%) %uf_id({_it})% f=%{_f}% kind=%{_kind}%")

# 掘り出し物: gear::bonus_ab の確率で、2 階〜その階のどれかの能力を付ける（武器なら武器の能力、防具なら防具の能力）
function uf_bonusab(i: item, f: number) :: item:
    if random number between 0 and 1 >= {uf::cfg::gear::bonus_ab}:
        return {_i}
    set {_kind} to uf_abkind(uf_id({_i}))
    if {_kind} is "":
        return {_i}
    set {_g} to random integer between 2 and {_f}
    if {_kind} is "weapon":
        set {_ab} to uf_rareab({_g})
    else:
        set {_ab} to uf_rareabarmor({_g})
    return uf_rebuild({_i}, -1, {_ab})

# 弓には矢を 1 本添える（無限なので 1 本あれば撃てる）
function uf_gearbow(p: player, i: item):
    if uf_id({_i}) starts with "dgb_":
        if {_p} doesn't have arrow:
            uf_give({_p}, arrow)

# 弓の矢が当たったとき（鍛冶屋の強化と能力が効く）
on damage:
    damage cause is projectile
    set {_a} to attacker
    {_a} is a player
    set {_t} to tool of {_a}
    set {_id} to uf_id({_t})
    set {_ok} to false
    if {_id} starts with "dgb_":
        set {_ok} to true
    else if {_id} is "cg_bow":
        set {_ok} to true
    {_ok} is true
    uf_gearon({_id}) is true
    set {_v} to victim
    {_v} is not a player
    set damage to damage * uf_wpow({_id}) / 3 * uf_lvmult(uf_lv({_t}))
    set {_abs::*} to uf_weaponabs({_t})
    if {_abs::*} contains "crit":
        if random number between 0 and 1 < uf_critrate({_id}):
            set damage to damage * 2
            play 10 crit at location of {_v}
    set {_d} to damage
    loop {_abs::*}:
        uf_abhit({_a}, {_v}, loop-value, {_d})

# ------------------------------------------------------------
# 武器の効果（特殊能力で動く）
#   能力 = 武器のはじめからの能力（dgw_<階> はその階の uf_rareab）＋ 鍛冶屋で付けた能力（説明の ufab:<能力>）
#   ダンジョン産の武器（dgw_）・特殊な近接武器（melee_）で、プレイヤー以外の相手に効く
# ------------------------------------------------------------
# 鍛冶屋で付けた能力（なければ ""）
function uf_abof(i: item) :: text:
    if {_i} is not set:
        return ""
    loop lore of {_i}:
        set {_s} to uncolored loop-value
        replace all "&8" with "" in {_s}
        if {_s} starts with "ufab:":
            return last (length of {_s} - 5) characters of {_s}
    return ""

# 武器の能力の一覧
function uf_weaponabs(i: item) :: texts:
    set {_id} to uf_id({_i})
    if {_id} starts with "dgw_":
        add uf_rareab((last (length of {_id} - 4) characters of {_id}) parsed as number) to {_out::*}
    else if {_id} starts with "dgb_":
        add uf_rareab((last (length of {_id} - 4) characters of {_id}) parsed as number) to {_out::*}
    else if {_id} is "cg_sword":
        add "crit" to {_out::*}
    else if {_id} is "cg_bow":
        add "haste" to {_out::*}
    set {_x} to uf_abof({_i})
    if {_x} is not "":
        if {_out::*} does not contain {_x}:
            add {_x} to {_out::*}
    return {_out::*}

on damage:
    damage cause is attack
    set {_a} to attacker
    {_a} is a player
    set {_t} to tool of {_a}
    set {_id} to uf_id({_t})
    set {_ok} to false
    if {_id} starts with "dgw_":
        set {_ok} to true
    else if {_id} starts with "melee_":
        set {_ok} to true
    else if {_id} is "cg_sword":
        set {_ok} to true
    {_ok} is true
    uf_gearon({_id}) is true
    set {_v} to victim
    {_v} is not a player
    if {_id} does not start with "melee_":
        set damage to damage * uf_wpow({_id}) / uf_wbase({_t}) * uf_lvmult(uf_lv({_t}))
    set {_abs::*} to uf_weaponabs({_t})
    if {_abs::*} contains "crit":
        if random number between 0 and 1 < uf_critrate({_id}):
            set damage to damage * 2
            play 10 crit at location of {_v}
            play sound "entity.player.attack.crit" with volume 1 at {_v}
    set {_d} to damage
    loop {_abs::*}:
        uf_abhit({_a}, {_v}, loop-value, {_d})

# カジノ限定の武具はカジノ（casino）、それ以外はダンジョン（dungeon）のモジュールで効く
function uf_gearon(id: text) :: boolean:
    if {_id} starts with "cg_":
        return uf_on("casino")
    return uf_on("dungeon")

# 会心の確率（ディーラーの剣は高い）
function uf_critrate(id: text) :: number:
    if {_id} is "cg_sword":
        return 0.3
    return 0.15

# 能力の効果。d は当てたダメージ（まわりへのダメージ・吸収はこれに比例する）
function uf_abhit(a: player, v: entity, ab: text, d: number):
    if {_ab} is "haste":
        apply speed 2 to {_a} for 3 seconds
    else if {_ab} is "knock":
        set {_dir} to normalized vector from {_a} to {_v}
        push {_v} {_dir} at speed 1.2
        push {_v} upwards at speed 0.35
    else if {_ab} is "poison":
        apply poison 3 to {_v} for 4 seconds
    else if {_ab} is "zap":
        if random number between 0 and 1 < 0.35:
            set {_n} to 0
            loop all living entities in radius 5 of location of {_v}:
                if loop-value is not {_v}:
                    if metadata value "uf_tier" of loop-value is set:
                        if {_n} < 3:
                            damage loop-value by {_d} * 0.5
                            play 5 crit at location of loop-value
                            add 1 to {_n}
            if {_n} > 0:
                play sound "block.beacon.power_select" with volume 0.6 at {_v}
    else if {_ab} is "slow":
        apply slowness 3 to {_v} for 3 seconds
    else if {_ab} is "drain":
        if random number between 0 and 1 < 0.35:
            heal {_a} by max(1, {_d} * 0.15)
            play 3 heart at location of {_a}
    else if {_ab} is "fire":
        ignite {_v} for 4 seconds
        loop all living entities in radius 3 of location of {_v}:
            if loop-value is not {_v}:
                if metadata value "uf_tier" of loop-value is set:
                    damage loop-value by {_d} * 0.4
                    ignite loop-value for 2 seconds

# ------------------------------------------------------------
# 防具の能力（鍛冶屋で付ける。着ている防具の数だけ強くなるものもある）
#   swift 俊足 / guard 鉄壁（1 つにつき -6％）/ antidote 解毒 / thorns 反撃 / regen 再生
#   lucky 幸運（討伐のポイント +20％。uf_05_dungeon.sk）/ dodge 回避（1 つにつき 8％）/ might 剛力（体力 40％ 未満で力 2）
# ------------------------------------------------------------
function uf_armorabs(p: player) :: texts:
    loop helmet of {_p}, chestplate of {_p}, leggings of {_p} and boots of {_p}:
        set {_x} to uf_abof(loop-value)
        if {_x} is not "":
            add {_x} to {_out::*}
    return {_out::*}

function uf_armorabcount(p: player, ab: text) :: number:
    set {_n} to 0
    loop uf_armorabs({_p}):
        if loop-value is {_ab}:
            add 1 to {_n}
    return {_n}

on damage:
    victim is a player
    uf_on("dungeon") is true
    set {_p} to victim
    set {_dodge} to uf_armorabcount({_p}, "dodge")
    if {_dodge} > 0:
        if attacker is set:
            if random number between 0 and 1 < min(0.3, 0.08 * {_dodge}):
                cancel event
                play sound "entity.player.attack.sweep" with volume 0.6 at {_p}
                send action bar "&b回避！" to {_p}
                stop
    set {_guard} to uf_armorabcount({_p}, "guard")
    if {_guard} > 0:
        set damage to damage * (1 - 0.06 * {_guard})
    set {_def} to uf_armordef({_p})
    if {_def} > 0:
        set damage to damage * (1 - {_def})
    set {_th} to uf_armorabcount({_p}, "thorns")
    if {_th} > 0:
        set {_atk} to attacker
        if {_atk} is set:
            if {_atk} is not a player:
                if {_atk} is alive:
                    damage {_atk} by 2 * {_th}

# 防具 1 つぶんの守り（受けるダメージを減らす割合）。合計は最大 60％
function uf_armordefof(id: text) :: number:
    if {_id} starts with "dga_uniform":
        return 0.04
    if {_id} starts with "dga_labcoat":
        return 0.07
    if {_id} starts with "dga_lord":
        return 0.1
    if {_id} starts with "cg_":
        return 0.12
    if {_id} is "armor_special":
        return 0.08
    return 0

function uf_armordef(p: player) :: number:
    set {_n} to 0
    loop helmet of {_p}, chestplate of {_p}, leggings of {_p} and boots of {_p}:
        add uf_armordefof(uf_id(loop-value)) to {_n}
    return min({_n}, 0.6)

every 2 seconds:
    uf_on("dungeon") is true
    loop all players:
        set {_abs::*} to uf_armorabs(loop-player)
        if size of {_abs::*} > 0:
            if {_abs::*} contains "swift":
                apply speed 2 to loop-player for 3 seconds
            if {_abs::*} contains "regen":
                apply regeneration 2 to loop-player for 3 seconds
            if {_abs::*} contains "antidote":
                remove poison from loop-player
            if {_abs::*} contains "might":
                if (health of loop-player) / (max health of loop-player) < 0.4:
                    apply strength 2 to loop-player for 3 seconds
        delete {_abs::*}

# ------------------------------------------------------------
# 防具のセットの効果
# ------------------------------------------------------------
function uf_gearset(p: player) :: text:
    set {_h} to uf_id(helmet of {_p})
    if {_h} does not start with "dga_":
        return ""
    set {_q::*} to split {_h} at "_"
    set {_s} to {_q::2}
    if uf_id(chestplate of {_p}) is not "dga_%{_s}%_chest":
        return ""
    if uf_id(leggings of {_p}) is not "dga_%{_s}%_legs":
        return ""
    if uf_id(boots of {_p}) is not "dga_%{_s}%_boots":
        return ""
    return {_s}

every 2 seconds:
    uf_on("dungeon") is true
    loop all players:
        set {_s} to uf_gearset(loop-player)
        if {_s} is "uniform":
            apply speed 2 to loop-player for 3 seconds
        else if {_s} is "labcoat":
            apply regeneration 2 to loop-player for 3 seconds
        else if {_s} is "lord":
            apply strength 2 to loop-player for 3 seconds
            apply resistance 1 to loop-player for 3 seconds
            apply fire resistance 1 to loop-player for 3 seconds
