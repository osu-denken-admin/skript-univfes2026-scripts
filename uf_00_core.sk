function uf_shopdef(id: text, price: number, req: number, enabled: boolean):
    if {uf::shop::%{_id}%::price} is not set:
        set {uf::shop::%{_id}%::price} to {_price}
        set {uf::shop::%{_id}%::req} to {_req}
        set {uf::shop::%{_id}%::enabled} to {_enabled}
    if {uf::shoporder::%{_id}%} is not set:
        add 1 to {uf::shopcount}
        set {uf::shoporder::%{_id}%} to {uf::shopcount}
        set {uf::shopids::%{uf::shopcount}%} to {_id}

function uf_cshopdef(id: text, price: number, enabled: boolean):
    if {uf::cshop::%{_id}%::price} is not set:
        set {uf::cshop::%{_id}%::price} to {_price}
        set {uf::cshop::%{_id}%::enabled} to {_enabled}
    if {uf::cshoporder::%{_id}%} is not set:
        add 1 to {uf::cshopcount}
        set {uf::cshoporder::%{_id}%} to {uf::cshopcount}
        set {uf::cshopids::%{uf::cshopcount}%} to {_id}

function uf_selldef(k: text, v: number, cat: text):
    if {uf::selldone::%{_k}%} is not set:
        set {uf::selldone::%{_k}%} to true
        set {uf::sell::%{_k}%} to {_v}
        set {uf::sellcat::%{_k}%} to {_cat}

# ------------------------------------------------------------
# モジュール・権限・メッセージ
# ------------------------------------------------------------
function uf_on(m: text) :: boolean:
    if {uf::mod::%{_m}%} is true:
        return true
    return false

function uf_admin(p: player) :: boolean:
    if {_p} has permission "univfes.admin":
        return true
    return false

function uf_msg(p: player, t: text):
    send "&6[電研]&r %colored {_t}%" to {_p}

function uf_fmtloc(l: location) :: text:
    return "%world of {_l}% %floor(x-coordinate of {_l})%, %floor(y-coordinate of {_l})%, %floor(z-coordinate of {_l})%"

# ------------------------------------------------------------
# ログ（plugins/Skript/logs/univfes_<分類>.log に出力）
# ------------------------------------------------------------
function uf_log(cat: text, msg: text):
    log "%{_msg}%" to "univfes_%{_cat}%"

# 管理者操作の履歴（ファイル＋直近 50 件を変数に保持）
function uf_adminlog(p: player, msg: text):
    add 1 to {uf::adminlog::n}
    set {_i} to mod({uf::adminlog::n}, 50)
    set {uf::adminlog::e::%{_i}%} to "%now% %{_p}%: %{_msg}%"
    uf_log("admin", "%{_p}% (%uuid of {_p}%): %{_msg}%")

# ------------------------------------------------------------
# ポイント（通常経済）
#   reason が admin / recover / chip で始まる加算は「累計獲得」に含めない
# ------------------------------------------------------------
function uf_pt(p: player) :: number:
    set {_v} to {uf::pt::%uuid of {_p}%}
    if {_v} is not set:
        return 0
    return {_v}

function uf_addpt(p: player, n: number, reason: text):
    set {_n} to floor({_n})
    if {_n} <= 0:
        stop
    add {_n} to {uf::pt::%uuid of {_p}%}
    set {_earn} to true
    if {_reason} starts with "admin":
        set {_earn} to false
    if {_reason} starts with "recover":
        set {_earn} to false
    if {_reason} starts with "chip":
        set {_earn} to false
    if {_earn} is true:
        add {_n} to {uf::stat::%uuid of {_p}%::earned}
    uf_log("economy", "+%{_n}% pt %{_p}% (%uuid of {_p}%) reason=%{_reason}% bal=%uf_pt({_p})%")

# 残高が足りなければ何もせず false を返す
function uf_takept(p: player, n: number, reason: text) :: boolean:
    set {_n} to floor({_n})
    if {_n} < 0:
        return false
    if uf_pt({_p}) < {_n}:
        return false
    if {_n} is 0:
        return true
    remove {_n} from {uf::pt::%uuid of {_p}%}
    uf_log("economy", "-%{_n}% pt %{_p}% (%uuid of {_p}%) reason=%{_reason}% bal=%uf_pt({_p})%")
    return true

# ------------------------------------------------------------
# カジノチップ（ポイントとは別残高）
# ------------------------------------------------------------
function uf_chip(p: player) :: number:
    set {_v} to {uf::chip::%uuid of {_p}%}
    if {_v} is not set:
        return 0
    return {_v}

function uf_addchip(p: player, n: number, reason: text):
    set {_n} to floor({_n})
    if {_n} <= 0:
        stop
    add {_n} to {uf::chip::%uuid of {_p}%}
    uf_log("casino", "+%{_n}% chip %{_p}% (%uuid of {_p}%) reason=%{_reason}% bal=%uf_chip({_p})%")

function uf_takechip(p: player, n: number, reason: text) :: boolean:
    set {_n} to floor({_n})
    if {_n} < 0:
        return false
    if uf_chip({_p}) < {_n}:
        return false
    if {_n} is 0:
        return true
    remove {_n} from {uf::chip::%uuid of {_p}%}
    uf_log("casino", "-%{_n}% chip %{_p}% (%uuid of {_p}%) reason=%{_reason}% bal=%uf_chip({_p})%")
    return true

# ------------------------------------------------------------
# 特殊アイテムの識別
#   説明文（lore）に "uf:<id>" の行を入れて判定する。名前だけでは判定しない。
#   サバイバルでは説明文を書き換えられないため、通常アイテムで偽装できない。
#   （クリエイティブの管理者は複製できる点に注意）
# ------------------------------------------------------------
function uf_id(i: item) :: text:
    if {_i} is not set:
        return ""
    loop lore of {_i}:
        set {_s} to uncolored loop-value
        replace all "&8" with "" in {_s}
        if {_s} starts with "uf:":
            return last (length of {_s} - 3) characters of {_s}
    return ""

function uf_lv(i: item) :: number:
    if {_i} is not set:
        return 0
    loop lore of {_i}:
        set {_s} to uncolored loop-value
        replace all "&8" with "" in {_s}
        if {_s} starts with "uflv:":
            set {_n} to (last (length of {_s} - 5) characters of {_s}) parsed as number
            if {_n} is set:
                return {_n}
    return 0

# インベントリに入らない分は足元に落とす
function uf_give(p: player, i: item, n: number = 1):
    set {_x} to {_n} of {_i}
    if {_p} can hold {_x}:
        give {_x} to {_p}
    else:
        drop {_x} at {_p}
        uf_msg({_p}, "&eインベントリが満杯のため、足元に落としました")

# ------------------------------------------------------------
# GUI 管理
#   開く前に種類と Inventory を記録し、閉じたときに消す。
#   各モジュールは {-uf::gui::<uuid>} の種類を見てクリックを処理する。
# ------------------------------------------------------------
function uf_gui(p: player, kind: text, inv: inventory):
    set {-uf::gui::%uuid of {_p}%} to {_kind}
    set {-uf::guiinv::%uuid of {_p}%} to {_inv}
    open {_inv} to {_p}

function uf_guiclear(p: player):
    delete {-uf::guictx::%uuid of {_p}%::*}

# GUI へのドラッグでアイテムが消えないようにする
on inventory drag:
    {-uf::gui::%uuid of player%} is set
    cancel event

on inventory close:
    if event-inventory is {-uf::guiinv::%uuid of player%}:
        delete {-uf::gui::%uuid of player%}
        delete {-uf::guiinv::%uuid of player%}

on quit:
    delete {-uf::gui::%uuid of player%}
    delete {-uf::guiinv::%uuid of player%}
    delete {-uf::guictx::%uuid of player%::*}

# ------------------------------------------------------------
# 区域・ワールド判定
# ------------------------------------------------------------
function uf_lockey(l: location) :: text:
    return "%world of {_l}%_%floor(x-coordinate of {_l})%_%floor(y-coordinate of {_l})%_%floor(z-coordinate of {_l})%"

# a と b を対角とする直方体の中に l があるか
function uf_inbox(l: location, a: location, b: location) :: boolean:
    if "%world of {_l}%" is not "%world of {_a}%":
        return false
    set {_x} to x-coordinate of {_l}
    set {_y} to y-coordinate of {_l}
    set {_z} to z-coordinate of {_l}
    if {_x} < min(x-coordinate of {_a}, x-coordinate of {_b}):
        return false
    if {_x} > max(x-coordinate of {_a}, x-coordinate of {_b}) + 1:
        return false
    if {_y} < min(y-coordinate of {_a}, y-coordinate of {_b}):
        return false
    if {_y} > max(y-coordinate of {_a}, y-coordinate of {_b}) + 1:
        return false
    if {_z} < min(z-coordinate of {_a}, z-coordinate of {_b}):
        return false
    if {_z} > max(z-coordinate of {_a}, z-coordinate of {_b}) + 1:
        return false
    return true

# kind: survival / dungeon / event（管理者ツールの「ワールドとロビー」か /ufadmin world <kind> で登録）
#   15号館は、常設サバイバルと同じワールドの中にある「世界のどこかのダンジョン」という位置づけ（2026-10-27）
#   ダンジョンの区域（建物 dungeon1・上空の闘技場 dungeon2。uf_15_layout.sk が初期値を入れ、管理者ツールで直せる）が
#   登録してあれば、dungeon はその区域の中だけ、survival はその区域の外だけ。区域がなければワールド全体で判定する
function uf_inworld(l: location, kind: text) :: boolean:
    if {uf::cfg::world::%{_kind}%} is not set:
        return false
    if "%world of {_l}%" is not {uf::cfg::world::%{_kind}%}:
        return false
    if {_kind} is "dungeon":
        if uf_hasdarea() is true:
            return uf_indarea({_l})
    else if {_kind} is "survival":
        if uf_indarea({_l}) is true:
            return false
    return true

function uf_hasdarea() :: boolean:
    loop "dungeon1" and "dungeon2":
        if {uf::area::%loop-value%::a} is set:
            if {uf::area::%loop-value%::b} is set:
                return true
    return false

# ダンジョンの区域（建物・闘技場）の中か
function uf_indarea(l: location) :: boolean:
    loop "dungeon1" and "dungeon2":
        set {_a} to {uf::area::%loop-value%::a}
        set {_b} to {uf::area::%loop-value%::b}
        if {_a} is set:
            if {_b} is set:
                if uf_inbox({_l}, {_a}, {_b}) is true:
                    return true
    return false

# 名前付き区域（shop / casino など）。未設定なら「どこでも可」として true
function uf_inarea(p: player, name: text) :: boolean:
    if {uf::area::%{_name}%::a} is not set:
        return true
    if {uf::area::%{_name}%::b} is not set:
        return true
    return uf_inbox(location of {_p}, {uf::area::%{_name}%::a}, {uf::area::%{_name}%::b})

# 特殊道具・乗り物から守る保護区域
function uf_protected(l: location) :: boolean:
    loop {uf::protlist::*}:
        set {_a} to {uf::prot::%loop-value%::a}
        set {_b} to {uf::prot::%loop-value%::b}
        if {_a} is set:
            if {_b} is set:
                if uf_inbox({_l}, {_a}, {_b}) is true:
                    return true
    return false
