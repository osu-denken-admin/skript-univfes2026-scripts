# ============================================================
# uf_14_admintool.sk : 管理者ツール（本）から開く管理メニュー
#   コマンドを使わずに、本の画面だけで設定を変えられるようにする。
#   - 管理者ツールを右クリック / 左クリック / 捨てる（Q）と開く
#   - Java 版は本の画面。項目をクリックすると操作し、本を開き直して結果を見せる
#     （項目にマウスを合わせると説明が出る）
#   - 統合版は本のクリックが使えないので、同じ内容をチェスト画面で開く（タップ、または捨てる操作）
#   - 権限 univfes.admin は、開くときとボタンを押すたびに確認する
#   - 数値は「＋／－ボタン → 決定」で変える（チャット入力は使わない）
#   - 消去・強制終了などの重要な操作は確認画面を通す
#   - 管理者が初めて参加したときに 1 冊配る。なくしたら /ufadmin tool
#
# ボタンの動作は「操作文字列」で表し、uf_aact で実行する
#   open/<ページ>  edit/<対象>  ask/<確認文>|<操作>  など
# ============================================================

# ------------------------------------------------------------
# ツールを開く
# ------------------------------------------------------------
on click:
    uf_id(player's tool) is "admin_tool"
    cancel event
    uf_atoolopen(player)

on drop:
    uf_id(event-item) is "admin_tool"
    cancel event
    uf_atoolopen(player)

function uf_atoolopen(p: player):
    if uf_admin({_p}) is false:
        uf_msg({_p}, "&cこれは管理者専用のアイテムです")
        stop
    uf_adminopen({_p}, "hub")

# 管理者以外は拾えない
on pickup:
    uf_id(event-item) is "admin_tool"
    uf_admin(player) is false
    cancel event

# 管理者が初めて参加したときに 1 冊配る
on join:
    uf_admin(player) is true
    {uf::atoolgiven::%uuid of player%} is not set
    set {uf::atoolgiven::%uuid of player%} to true
    wait 2 seconds
    if player is online:
        uf_give(player, uf_item("admin_tool"))
        uf_msg(player, "&e管理者ツールを渡しました。右クリック（統合版はタップ）で管理メニューを開けます")

# ------------------------------------------------------------
# 部品
#   ボタンは uf_abtn で置く。チェスト画面のスロットと本の項目の両方を作っておき、
#   uf_ashow で Java 版には本、統合版にはチェスト画面を開く。
#   本の項目は「/ufadmin ui <画面番号> <スロット>」を実行する。
#   画面番号が今のものと違う（古い本を押した）ときは、操作せずに開き直す。
# ------------------------------------------------------------
# lore は "|" 区切り
function uf_abtn(p: player, g: inventory, s: number, icon: item, name: text, lore: text, action: text):
    set {_l::*} to split {_lore} at "|"
    set slot {_s} of {_g} to ({_icon} named {_name}) with lore {_l::*}
    uf_abook({_p}, {_s}, {_name}, {_lore}, {_action})

# 本の項目だけを登録する（チェスト画面のスロットは呼び出し側で置く）
function uf_abook(p: player, s: number, name: text, lore: text, action: text):
    set {_u} to uuid of {_p}
    set {-uf::bkn::%{_u}%::%{_s}%} to {_name}
    set {-uf::bkl::%{_u}%::%{_s}%} to {_lore}
    if {_action} is not "":
        set {-uf::guictx::%{_u}%::%{_s}%} to {_action}

function uf_apage(p: player, title: text) :: inventory:
    uf_guiclear({_p})
    set {_u} to uuid of {_p}
    delete {-uf::bkn::%{_u}%::*}
    delete {-uf::bkl::%{_u}%::*}
    set {-uf::bktitle::%{_u}%} to {_title}
    return chest inventory with 6 rows named {_title}

# 戻るボタン（49）と閉じるボタン（53）を置いて開く
function uf_ashow(p: player, g: inventory, back: text):
    if {_back} is not "":
        uf_abtn({_p}, {_g}, 49, arrow, "&f戻る", "&7前の画面へ", "open/%{_back}%")
    uf_abtn({_p}, {_g}, 53, barrier, "&c閉じる", "&7メニューを閉じる", "close")
    if uf_usebook({_p}) is true:
        uf_bkshow({_p})
    else:
        uf_gui({_p}, "atool", {_g})

# 統合版（Floodgate）のプレイヤーか
function uf_bedrock(p: player) :: boolean:
    if "%uuid of {_p}%" starts with "00000000-0000-0000-":
        return true
    return false

# 本の画面で開くか。管理者ごとにハブの「表示の切り替え」で選べる（統合版は本が使えないので常にチェスト画面）
function uf_usebook(p: player) :: boolean:
    if uf_bedrock({_p}) is true:
        return false
    if {uf::atoolview::%uuid of {_p}%} is "chest":
        return false
    return true

# ------------------------------------------------------------
# 本の画面
# ------------------------------------------------------------
# 紙の上で読みやすい色に変える（黄・黄緑・白・灰は紙の上で見えにくい）
function uf_bkc(t: text) :: text:
    set {_r} to {_t}
    loop "e:6", "a:2", "f:0", "7:8" and "b:3":
        set {_x::*} to split loop-value at ":"
        replace all "&%{_x::1}%" with "&%{_x::2}%" in {_r}
        replace all "§%{_x::1}%" with "§%{_x::2}%" in {_r}
    return {_r}

# クリックできる文字。押すと /ufadmin ui <画面番号> <s> を実行し、マウスを合わせると hover（"|" で改行）を出す
#   説明に色記号（&7 など）があると説明として読まれないので、色は外す。
#   半角の「:」から後ろは説明から消え、「<」「>」は記号として読まれるので、全角にする
function uf_bklink(p: player, s: text, label: text, hover: text) :: text:
    set {_h} to uncolored {_hover}
    replace all ":" with "：" in {_h}
    replace all "<" with "＜" in {_h}
    replace all ">" with "＞" in {_h}
    replace all "|" with nl in {_h}
    return "<cmd:/ufadmin ui %{-uf::bkid::%uuid of {_p}%}% %{_s}%><tooltip:%{_h}%>%{_label}%<reset>"

# 本で何行になるかの目安。1 行は全角でおよそ 12.6 文字、半角は全角の 2/3 の幅
function uf_bklines(t: text) :: number:
    set {_s} to uncolored (colored {_t})
    set {_w} to 0
    loop length of {_s} times:
        set {_c} to subtext of {_s} from characters loop-number to loop-number
        if "abcdefghijklmnopqrstuvwxyz0123456789 .,:;!?()[]-+/*=_'<>~|@#^" contains {_c}:
            add 0.67 to {_w}
        else:
            add 1 to {_w}
    return max(1, ceil({_w} / 12.6))

# 説明（lore）の 1 行目を項目の下にも出すか。現在の値・状態だけを出し、ただの説明は出さない
function uf_bkshowlore(l: text) :: boolean:
    if {_l} starts with "&e":
        return false
    if {_l} starts with "&7":
        if {_l} contains "現在":
            return true
        return false
    return true

# 本を開く。<cmd:…> や <tooltip:…> は formatted にしたときだけクリック・説明になる
function uf_bkopen(p: player, pages: texts):
    set {_b} to written book
    loop {_pages::*}:
        add (formatted loop-value) to {_f::*}
    set book pages of {_b} to {_f::*}
    # チェスト画面から本に切り替えたときは、先にチェスト画面を閉じる
    if {-uf::gui::%uuid of {_p}%} is set:
        close inventory of {_p}
    open book {_b} to {_p}

function uf_bkshow(p: player):
    set {_u} to uuid of {_p}
    add 1 to {-uf::bkid::%{_u}%}
    if {-uf::apage::%{_u}%} is "editor":
        uf_bkeditor({_p})
        stop
    set {_title} to "&4&l%uncolored {-uf::bktitle::%{_u}%}%"
    set {_foot} to uf_bklink({_p}, "53", "&4× 閉じる", "&7メニューを閉じる")
    if {-uf::bkn::%{_u}%::49} is set:
        set {_back} to uf_bklink({_p}, "49", "&1« 戻る", "&7前の画面へ")
        set {_foot} to "%{_back}%　%{_foot}%"
    # 見出し（＋空行）と、下の空行＋戻る・閉じるを除いた行数
    set {_cap} to 14 - uf_bklines({_title}) - 3
    set {_page} to ""
    set {_used} to 0
    loop integers between 0 and 52:
        set {_s} to loop-value
        if {_s} is not 49:
            set {_name} to {-uf::bkn::%{_u}%::%{_s}%}
            if {_name} is set:
                set {_lore} to {-uf::bkl::%{_u}%::%{_s}%}
                set {_l::*} to split {_lore} at "|"
                if {-uf::guictx::%{_u}%::%{_s}%} is set:
                    set {_e} to uf_bklink({_p}, "%{_s}%", "&8▶ %uf_bkc({_name})%", {_lore})
                    set {_n} to uf_bklines("▶ %{_name}%")
                    if {_l::1} is set:
                        if uf_bkshowlore({_l::1}) is true:
                            set {_e} to "%{_e}%%nl%　&8%uf_bkc({_l::1})%"
                            add uf_bklines("　%{_l::1}%") to {_n}
                else:
                    # 押せない項目（情報だけ）は説明もすべて出す
                    set {_e} to uf_bkc({_name})
                    set {_n} to uf_bklines({_name})
                    loop {_l::*}:
                        if loop-value-2 is not "":
                            set {_e} to "%{_e}%%nl%　&8%uf_bkc(loop-value-2)%"
                            add uf_bklines("　%loop-value-2%") to {_n}
                if {_used} > 0:
                    if {_used} + {_n} > {_cap}:
                        add "%{_title}%%nl%%nl%%{_page}%%nl%%nl%%{_foot}%" to {_pages::*}
                        set {_page} to ""
                        set {_used} to 0
                if {_used} > 0:
                    set {_page} to "%{_page}%%nl%"
                set {_page} to "%{_page}%%{_e}%"
                add {_n} to {_used}
    add "%{_title}%%nl%%nl%%{_page}%%nl%%nl%%{_foot}%" to {_pages::*}
    uf_bkopen({_p}, {_pages::*})

# 数値エディタの本（＋／－を横に並べる）
function uf_bkeditor(p: player):
    set {_u} to uuid of {_p}
    set {_t} to "&4&l数値の変更%nl%%nl%&6%{-uf::ed::%{_u}%::label}%"
    set {_t} to "%{_t}%%nl%&8元の値: &0%{-uf::ed::%{_u}%::orig}%"
    set {_t} to "%{_t}%%nl%&8変更後: &2&l%{-uf::ed::%{_u}%::val}%"
    set {_t} to "%{_t}%%nl%&8範囲: %{-uf::ed::%{_u}%::min}%〜%{-uf::ed::%{_u}%::max}%%nl%"
    loop 2 times:
        set {_row} to ""
        if loop-value is 1:
            set {_from} to 18
        else:
            set {_from} to 23
        loop integers between {_from} and {_from} + 3:
            set {_s} to loop-value-2
            set {_a} to {-uf::guictx::%{_u}%::%{_s}%}
            if {_a} is set:
                set {_d} to last (length of {_a} - 3) characters of {_a}
                if {_d} starts with "-":
                    set {_lb} to "&4%{_d}%"
                else:
                    set {_lb} to "&2+%{_d}%"
                set {_k} to uf_bklink({_p}, "%{_s}%", {_lb}, "&7クリックで %{_d}%")
                set {_row} to "%{_row}%%{_k}% "
        set {_t} to "%{_t}%%nl%%{_row}%"
    set {_k1} to uf_bklink({_p}, "40", "&2▶ 決定", "&7%{-uf::ed::%{_u}%::orig}% → %{-uf::ed::%{_u}%::val}%")
    set {_k2} to uf_bklink({_p}, "38", "&6▶ 元の値に戻す", "&7%{-uf::ed::%{_u}%::orig}%")
    set {_k3} to uf_bklink({_p}, "42", "&4▶ やめる", "&7変更せずに戻る")
    set {_t} to "%{_t}%%nl%%nl%%{_k1}%%nl%%{_k2}%%nl%%{_k3}%"
    uf_bkopen({_p}, {_t})

# 確認の本（uf_confirm から使う）。「実行する」「やめる」は /ufadmin ui <画面番号> yes|no
function uf_bkconfirm(p: player, label: text):
    add 1 to {-uf::bkid::%uuid of {_p}%}
    set {_k1} to uf_bklink({_p}, "yes", "&2▶ 実行する", "&7%{_label}%")
    set {_k2} to uf_bklink({_p}, "no", "&4▶ やめる", "&7取り消す")
    set {_t} to "&4&l確認%nl%%nl%&0%uf_bkc({_label})%%nl%%nl%%{_k1}%%nl%%nl%%{_k2}%"
    uf_bkopen({_p}, {_t})

# 本の項目が押されたとき（/ufadmin ui <画面番号> <スロット|yes|no>）
function uf_bkclick(p: player, id: text, s: text):
    if uf_admin({_p}) is false:
        stop
    set {_u} to uuid of {_p}
    if {_id} is not "%{-uf::bkid::%{_u}%}%":
        uf_msg({_p}, "&7古い画面が押されたので、今の画面を開き直しました")
        uf_adminopen({_p}, {-uf::apage::%{_u}%})
        stop
    if {_s} is "yes" or "no":
        set {_action} to {-uf::guictx::%{_u}%::action}
        if {_action} is not set:
            stop
        delete {-uf::guictx::%{_u}%::action}
        if {_s} is "yes":
            uf_doaction({_p}, {_action})
        else:
            uf_msg({_p}, "&7取り消しました")
            if {_action} starts with "x/":
                uf_adminopen({_p}, {-uf::apage::%{_u}%})
        stop
    set {_a} to {-uf::guictx::%{_u}%::%{_s}%}
    if {_a} is set:
        uf_aact({_p}, {_a})

function uf_onoff(b: object) :: text:
    if {_b} is true:
        return "&a有効"
    return "&c無効"

function uf_locstr(l: object) :: text:
    if {_l} is not set:
        return "&c未設定"
    return "&f%uf_fmtloc({_l})%"

on inventory click:
    {-uf::gui::%uuid of player%} is "atool"
    cancel event
    event-inventory is {-uf::guiinv::%uuid of player%}
    set {_a} to {-uf::guictx::%uuid of player%::%index of event-slot%}
    {_a} is set
    wait 1 tick
    player is online
    uf_aact(player, {_a})

# ------------------------------------------------------------
# ページ
# ------------------------------------------------------------
function uf_adminopen(p: player, page: text):
    if uf_admin({_p}) is false:
        stop
    set {-uf::apage::%uuid of {_p}%} to {_page}
    set {_q::*} to split {_page} at "/"
    set {_k} to {_q::1}
    if {_k} is "hub":
        uf_ap_hub({_p})
    else if {_k} is "modules":
        uf_ap_modules({_p})
    else if {_k} is "worlds":
        uf_ap_worlds({_p})
    else if {_k} is "floors":
        uf_ap_floors({_p})
    else if {_k} is "floor":
        uf_ap_floor({_p}, {_q::2} parsed as number)
    else if {_k} is "shop":
        uf_ap_shop({_p})
    else if {_k} is "shopitem":
        uf_ap_shopitem({_p}, {_q::2})
    else if {_k} is "casino":
        uf_ap_casino({_p})
    else if {_k} is "casinogame":
        uf_ap_casinogame({_p}, {_q::2})
    else if {_k} is "sell":
        uf_ap_sell({_p})
    else if {_k} is "sellitem":
        uf_ap_sellitem({_p}, {_q::2})
    else if {_k} is "cfg":
        uf_ap_cfg({_p})
    else if {_k} is "cfgcat":
        uf_ap_cfgcat({_p}, {_q::2})
    else if {_k} is "players":
        uf_ap_players({_p})
    else if {_k} is "ops":
        uf_ap_ops({_p})
    else if {_k} is "cshop":
        uf_ap_cshop({_p})
    else if {_k} is "cshopitem":
        uf_ap_cshopitem({_p}, {_q::2})
    else if {_k} is "boards":
        uf_ap_boards({_p})
    else if {_k} is "npcs":
        uf_ap_npcs({_p})
    else if {_k} is "chall":
        uf_ap_chall({_p})
    else if {_k} is "player":
        uf_ap_player({_p}, {_q::2})
    else if {_k} is "areas":
        uf_ap_areas({_p})
    else if {_k} is "prot":
        uf_ap_prot({_p})
    else if {_k} is "protarea":
        uf_ap_protarea({_p}, {_q::2})
    else if {_k} is "items":
        uf_ap_items({_p}, {_q::2} parsed as number)
    else if {_k} is "logs":
        uf_ap_logs({_p})
    else if {_k} is "editor":
        uf_edgui({_p})
    else:
        uf_ap_hub({_p})

function uf_ap_hub(p: player):
    set {_g} to uf_apage({_p}, "&4管理者ツール")
    uf_abtn({_p}, {_g}, 10, comparator, "&eモジュールの有効・無効", "&7機能ごとにオン・オフ", "open/modules")
    uf_abtn({_p}, {_g}, 11, grass block, "&eワールドとロビー", "&7サバイバル・ダンジョン・イベントの登録", "open/worlds")
    uf_abtn({_p}, {_g}, 12, oak door, "&eダンジョンの各階", "&7開始地点・中ボスの部屋・闘技場・敵・宝箱など", "open/floors")
    uf_abtn({_p}, {_g}, 13, emerald, "&eショップ", "&7販売状態・価格・解放条件", "open/shop")
    uf_abtn({_p}, {_g}, 14, gold ingot, "&eカジノ", "&7営業・確率・倍率・賭け金", "open/casino")
    uf_abtn({_p}, {_g}, 15, wheat, "&e売却価格", "&7生産物の買い取り価格", "open/sell")
    uf_abtn({_p}, {_g}, 16, redstone torch, "&e各種設定", "&7報酬・死亡・宝箱・道具・武器・RPG", "open/cfg")
    uf_abtn({_p}, {_g}, 28, player head, "&eプレイヤー", "&7ポイント・チップ・解放階の確認と変更", "open/players")
    uf_abtn({_p}, {_g}, 29, oak sign, "&e受付・ショップ・カジノの区域", "&7利用できる範囲", "open/areas")
    uf_abtn({_p}, {_g}, 30, shield, "&e保護区域", "&7特殊道具で壊させない範囲", "open/prot")
    if {uf::maint} is true:
        uf_abtn({_p}, {_g}, 32, iron door, "&cメンテナンス中", "&eクリックで解除", "act/maint_off")
    else:
        uf_abtn({_p}, {_g}, 32, iron door, "&7メンテナンス: 停止中", "&eクリックで開始（管理者以外をキック）", "ask/メンテナンスモードにする（管理者以外をキック）|act/maint_on")
    uf_abtn({_p}, {_g}, 33, chest, "&e特殊アイテムを受け取る", "&7テスト用", "open/items")
    uf_abtn({_p}, {_g}, 34, book, "&e操作履歴", "&7管理者の操作の記録", "open/logs")
    uf_abtn({_p}, {_g}, 37, oak sign, "&eランキングの掲示板", "&7壁に貼りつける浮かぶ文字の掲示板", "open/boards")
    uf_abtn({_p}, {_g}, 38, villager spawn egg, "&eNPC（受付・ショップ・カジノ・スキル）", "&7話しかけると画面が開く村人", "open/npcs")
    uf_abtn({_p}, {_g}, 39, gilded blackstone, "&e地下カジノ", "&715号館の地下のカジノ（建物）を作る・埋め戻す", "open/chall")
    if {uf::cfg::skin::enabled} is true:
        uf_abtn({_p}, {_g}, 40, painting, "&a武具のスキン: 送る", "&7入ってきた人にリソースパック（武具の絵）を送る|&7統合版には送られない|&eクリックで送らないようにする", "skin")
    else:
        uf_abtn({_p}, {_g}, 40, painting, "&c武具のスキン: 送らない", "&7入ってきた人にリソースパック（武具の絵）を送らない|&eクリックで送るようにする", "skin")
    # OP の付け外しは OP の人だけ（univfes.admin だけの人が自分に OP を付けられないように）
    if {_p} is op:
        uf_abtn({_p}, {_g}, 35, nether star, "&eOP の一覧", "&7オフラインの人も含めて表示|&7開発用のボット（ClaudeBot）の OP もここで外せる", "open/ops")
    if uf_bedrock({_p}) is false:
        if uf_usebook({_p}) is true:
            uf_abtn({_p}, {_g}, 45, chest, "&e表示: 本 → チェストにする", "&7このメニューをチェスト画面で開くようにする|&7自分だけの設定", "view")
        else:
            uf_abtn({_p}, {_g}, 45, written book, "&e表示: チェスト → 本にする", "&7このメニューを本の画面で開くようにする|&7自分だけの設定", "view")
    uf_ashow({_p}, {_g}, "")

function uf_ap_modules(p: player):
    set {_g} to uf_apage({_p}, "&4モジュール（クリックで切り替え）")
    set {_s} to 10
    loop "economy", "shop", "party", "dungeon", "death", "rpg", "tools", "weapons", "casino", "progress" and "guide":
        if {_s} is 17:
            set {_s} to 19
        if {uf::mod::%loop-value%} is true:
            uf_abtn({_p}, {_g}, {_s}, lime concrete, "&a%uf_modname(loop-value)%", "&7%loop-value%|&a有効|&eクリックで無効にする", "mod/%loop-value%")
        else:
            uf_abtn({_p}, {_g}, {_s}, red concrete, "&c%uf_modname(loop-value)%", "&7%loop-value%|&c無効|&eクリックで有効にする", "mod/%loop-value%")
        add 1 to {_s}
    uf_ashow({_p}, {_g}, "hub")

function uf_modname(m: text) :: text:
    if {_m} is "economy":
        return "売却（経済）"
    if {_m} is "shop":
        return "ショップ"
    if {_m} is "party":
        return "パーティー"
    if {_m} is "dungeon":
        return "ダンジョン"
    if {_m} is "death":
        return "死亡・回収・蘇生"
    if {_m} is "rpg":
        return "レベル・スキル"
    if {_m} is "tools":
        return "特殊道具"
    if {_m} is "weapons":
        return "特殊武器・アクセサリー"
    if {_m} is "casino":
        return "カジノ"
    if {_m} is "progress":
        return "クエスト・実績"
    return "初参加の案内"

function uf_ap_worlds(p: player):
    set {_g} to uf_apage({_p}, "&4ワールドとロビー")
    set {_w} to "%world of {_p}%"
    uf_abtn({_p}, {_g}, 11, grass block, "&e常設サバイバル", "&7現在: &f%{uf::cfg::world::survival}%|&eクリックで今いるワールド（%{_w}%）にする", "world/survival")
    uf_abtn({_p}, {_g}, 13, oak door, "&e15号館（ダンジョン）", "&7現在: &f%{uf::cfg::world::dungeon}%|&eクリックで今いるワールド（%{_w}%）にする", "world/dungeon")
    uf_abtn({_p}, {_g}, 15, firework rocket, "&eイベント", "&7現在: &f%{uf::cfg::world::event}%|&eクリックで今いるワールド（%{_w}%）にする", "world/event")
    uf_abtn({_p}, {_g}, 31, red bed, "&eロビー（ダンジョンからの退出先）", "&7現在: %uf_locstr({uf::cfg::lobby})%|&eクリックで今いる場所にする", "lobby")
    # 初期スポーン地点（uf_26_travel.sk）
    uf_abtn({_p}, {_g}, 33, compass, "&e初期スポーン地点を遠くに決める", "&7現在: %uf_locstr({uf::cfg::farspawn})%|&7ロビーから約 %{uf::cfg::farspawn_dist}% ブロック離れた地面を探して、ワールドのスポーン地点にする|&7初めて入った人・ベッドのない人がここに出る|&7押すたびに別の場所になる|&7確認画面が出ます", "ask/初期スポーン地点をロビーから遠くに決め直す|farspawn")
    uf_abtn({_p}, {_g}, 34, paper, "&e初期スポーン地点の遠さ", "&7現在: %{uf::cfg::farspawn_dist}% ブロック|&eクリックで変更", "edit/cfg/farspawn_dist")
    uf_ashow({_p}, {_g}, "hub")

function uf_ap_floors(p: player):
    set {_g} to uf_apage({_p}, "&4ダンジョンの各階")
    loop integers between 2 and 9:
        set {_f} to loop-value
        set {_ns} to size of {uf::floor::%{_f}%::spawn::*}
        set {_nc} to size of {uf::floor::%{_f}%::chest::*}
        if {uf::floor::%{_f}%::start} is set:
            set {_st} to "&a開始地点あり"
        else:
            set {_st} to "&c開始地点なし"
        set {_sn} to size of uf_fsess({_f})
        if {_sn} > 0:
            set {_st} to "%{_st}%|&6挑戦中 %{_sn}% / %{uf::cfg::floor_parties}% パーティー"
        uf_abtn({_p}, {_g}, {_f} + 17, oak door, "&f%{_f}%階", "%{_st}%|&7敵の出現地点: %{_ns}% / 宝箱候補: %{_nc}%|&eクリックで設定", "open/floor/%{_f}%")
    uf_abtn({_p}, {_g}, 40, writable book, "&a15号館の内装に合わせて全階を設定", "&72〜9階の開始地点・復帰地点・ボス・敵の出現地点・宝箱・範囲を一括登録|&7先に「15号館（ダンジョン）」のワールドを登録しておくこと|&c今の各階の設定は上書きされます|&7確認画面が出ます", "ask/2〜9階の設定を15号館の内装に合わせて上書きする|layout")
    uf_abtn({_p}, {_g}, 42, glowstone, "&a15号館のライトを置き直す", "&7内装と闘技場のライトブロックを消して、決まった場所に置き直す|&7Litematica で貼るとライトが置かれないので、貼ったあとに 1 回押す|&7確認画面が出ます", "ask/内装と闘技場のライトブロックを置き直す|lights")
    uf_ashow({_p}, {_g}, "hub")

function uf_ap_floor(p: player, f: number):
    if {_f} is not between 2 and 9:
        uf_ap_floors({_p})
        stop
    set {_g} to uf_apage({_p}, "&4%{_f}%階の設定")
    set {_h} to "|&eクリックで今いる場所にする"
    uf_abtn({_p}, {_g}, 10, lime banner, "&e開始地点", "%uf_locstr({uf::floor::%{_f}%::start})%%{_h}%", "floc/%{_f}%/start")
    uf_abtn({_p}, {_g}, 11, white banner, "&e復帰地点（死亡時）", "%uf_locstr({uf::floor::%{_f}%::cp})%|&7未設定なら開始地点%{_h}%", "floc/%{_f}%/cp")
    uf_abtn({_p}, {_g}, 12, crying obsidian, "&e壁を閉じる", "&7中ボスの壁と階段の壁を閉じる|&7状態: 中ボス %{uf::gatestate::%{_f}%::mid}% / 階段 %{uf::gatestate::%{_f}%::exit}%", "gates/%{_f}%/close")
    uf_abtn({_p}, {_g}, 13, reinforced deepslate, "&e壁を開ける（点検用）", "&7だれも挑戦していなければ、近くに人がいなくなると自動で閉じる|&7確認画面が出ます", "ask/%{_f}%階の壁を開ける（点検用）|gates/%{_f}%/open")
    uf_abtn({_p}, {_g}, 24, orange wool, "&e中ボス闘技場の入口", "%uf_locstr({uf::floor::%{_f}%::marena::player})%|&7パーティーが移動する場所%{_h}%", "floc/%{_f}%/marena::player")
    uf_abtn({_p}, {_g}, 25, orange concrete, "&e中ボスの出現地点", "%uf_locstr({uf::floor::%{_f}%::marena::boss})%%{_h}%", "floc/%{_f}%/marena::boss")
    uf_abtn({_p}, {_g}, 37, red wool, "&eボス闘技場の入口", "%uf_locstr({uf::floor::%{_f}%::barena::player})%|&7パーティーが移動する場所%{_h}%", "floc/%{_f}%/barena::player")
    uf_abtn({_p}, {_g}, 38, red concrete, "&eボスの出現地点", "%uf_locstr({uf::floor::%{_f}%::barena::boss})%%{_h}%", "floc/%{_f}%/barena::boss")
    uf_abtn({_p}, {_g}, 15, white wool, "&eフロアの範囲（角1）", "%uf_locstr({uf::floor::%{_f}%::p1})%%{_h}%", "floc/%{_f}%/p1")
    uf_abtn({_p}, {_g}, 16, white wool, "&eフロアの範囲（角2）", "%uf_locstr({uf::floor::%{_f}%::p2})%%{_h}%", "floc/%{_f}%/p2")
    uf_abtn({_p}, {_g}, 19, rotten flesh, "&e敵の出現地点を追加", "&7登録数: %size of {uf::floor::%{_f}%::spawn::*}%|&eクリックで今いる場所を追加", "fadd/%{_f}%/spawn")
    uf_abtn({_p}, {_g}, 20, tnt, "&c敵の出現地点をすべて消す", "&7確認画面が出ます", "ask/%{_f}%階の敵の出現地点をすべて消す|fclear/%{_f}%/spawn")
    uf_abtn({_p}, {_g}, 22, chest, "&e宝箱の候補地点を追加", "&7登録数: %size of {uf::floor::%{_f}%::chest::*}%|&eクリックで今立っている場所を追加", "fadd/%{_f}%/chest")
    uf_abtn({_p}, {_g}, 23, tnt, "&c宝箱の候補地点をすべて消す", "&7確認画面が出ます", "ask/%{_f}%階の宝箱の候補地点をすべて消す|fclear/%{_f}%/chest")
    set {_cn} to uf_dcount({_f}, "normal")
    set {_cs} to uf_dcount({_f}, "strong")
    set {_ce} to uf_dcount({_f}, "elite")
    uf_abtn({_p}, {_g}, 28, bone, "&e通常敵の数", "&7現在: %{_cn}%|&eクリックで変更", "edit/count/%{_f}%/normal")
    uf_abtn({_p}, {_g}, 29, bone, "&e強化敵の数", "&7現在: %{_cs}%|&eクリックで変更", "edit/count/%{_f}%/strong")
    uf_abtn({_p}, {_g}, 30, blaze rod, "&eエリート敵の数", "&7現在: %{_ce}%|&eクリックで変更", "edit/count/%{_f}%/elite")
    if {uf::floor::%{_f}%::start} is set:
        uf_abtn({_p}, {_g}, 32, ender pearl, "&b開始地点へ移動", "&7確認用", "ftp/%{_f}%")
    if size of uf_fsess({_f}) > 0:
        set {_sl} to ""
        loop uf_fsess({_f}):
            set {_sl} to "%{_sl}%|&7%loop-value%: %{-uf::sess::%loop-value%::phase}% / 残り %{-uf::sess::%loop-value%::alive}%体"
        uf_abtn({_p}, {_g}, 33, clock, "&6次の段階へ進める（この階の全パーティー）", "&7挑戦中のパーティー:%{_sl}%|&7確認画面が出ます", "ask/%{_f}%階の全パーティーを次の段階へ進める（敵を倒した扱い・報酬なし）|fskip/%{_f}%")
        uf_abtn({_p}, {_g}, 34, barrier, "&c挑戦を強制終了（この階の全パーティー）", "&7確認画面が出ます", "ask/%{_f}%階の全パーティーの挑戦を強制終了する|fend/%{_f}%")
    uf_ashow({_p}, {_g}, "floors")

function uf_ap_shop(p: player):
    set {_g} to uf_apage({_p}, "&4ショップ（クリックで商品の設定）")
    set {_s} to 0
    loop {uf::shopids::*}:
        if {_s} < 45:
            set {_id} to loop-value
            set {_icon} to uf_shopicon({_id})
            if {_icon} is not set:
                set {_icon} to paper
            uf_abtn({_p}, {_g}, {_s}, {_icon}, uf_shopname({_id}), "%uf_onoff({uf::shop::%{_id}%::enabled})%|&7価格: &e%{uf::shop::%{_id}%::price}%pt|&7解放: %{uf::shop::%{_id}%::req}%階クリア（0=なし）|&eクリックで設定", "open/shopitem/%{_id}%")
            add 1 to {_s}
    uf_ashow({_p}, {_g}, "hub")

# カジノ限定ショップ（uf_23_chipshop.sk）
function uf_ap_cshop(p: player):
    set {_g} to uf_apage({_p}, "&4カジノ限定ショップ（クリックで商品の設定）")
    set {_s} to 0
    loop {uf::cshopids::*}:
        if {_s} < 45:
            set {_id} to loop-value
            set {_icon} to uf_cshopitem({_id})
            if {_icon} is not set:
                set {_icon} to paper
            uf_abtn({_p}, {_g}, {_s}, {_icon}, uf_cshopname({_id}), "%uf_onoff({uf::cshop::%{_id}%::enabled})%|&7価格: &6チップ %{uf::cshop::%{_id}%::price}% 枚|&eクリックで設定", "open/cshopitem/%{_id}%")
            add 1 to {_s}
    uf_ashow({_p}, {_g}, "casino")

function uf_ap_cshopitem(p: player, id: text):
    if {uf::cshop::%{_id}%::price} is not set:
        uf_ap_cshop({_p})
        stop
    set {_g} to uf_apage({_p}, "&4カジノ限定: %uf_cshopname({_id})%")
    set {_icon} to uf_cshopitem({_id})
    if {_icon} is not set:
        set {_icon} to paper
    uf_abtn({_p}, {_g}, 4, {_icon}, uf_cshopname({_id}), "&7ID: %{_id}%", "")
    if {uf::cshop::%{_id}%::enabled} is true:
        uf_abtn({_p}, {_g}, 20, lime concrete, "&a交換できる", "&eクリックで止める", "cshoptoggle/%{_id}%")
    else:
        uf_abtn({_p}, {_g}, 20, red concrete, "&c交換を止めている", "&eクリックで交換できるようにする", "cshoptoggle/%{_id}%")
    uf_abtn({_p}, {_g}, 22, gold nugget, "&e価格（チップ）", "&7現在: %{uf::cshop::%{_id}%::price}% 枚|&eクリックで変更", "edit/cshopprice/%{_id}%")
    uf_ashow({_p}, {_g}, "cshop")

function uf_ap_shopitem(p: player, id: text):
    if {uf::shop::%{_id}%::price} is not set:
        uf_ap_shop({_p})
        stop
    set {_g} to uf_apage({_p}, "&4商品: %uf_shopname({_id})%")
    set {_icon} to uf_shopicon({_id})
    if {_icon} is not set:
        set {_icon} to paper
    uf_abtn({_p}, {_g}, 4, {_icon}, uf_shopname({_id}), "&7ID: %{_id}%", "")
    if {uf::shop::%{_id}%::enabled} is true:
        uf_abtn({_p}, {_g}, 20, lime concrete, "&a販売中", "&eクリックで販売を止める", "shoptoggle/%{_id}%")
    else:
        uf_abtn({_p}, {_g}, 20, red concrete, "&c販売停止中", "&eクリックで販売する", "shoptoggle/%{_id}%")
    uf_abtn({_p}, {_g}, 22, gold nugget, "&e価格", "&7現在: %{uf::shop::%{_id}%::price}%pt|&eクリックで変更", "edit/shopprice/%{_id}%")
    uf_abtn({_p}, {_g}, 24, iron bars, "&e解放条件", "&7現在: %{uf::shop::%{_id}%::req}%階クリア（0=なし）|&eクリックで変更", "edit/shopreq/%{_id}%")
    uf_ashow({_p}, {_g}, "shop")

function uf_ap_casino(p: player):
    set {_g} to uf_apage({_p}, "&4カジノ（クリックでゲームの設定）")
    set {_s1} to uf_casinosum("slot")
    set {_s2} to uf_casinosum("roulette")
    set {_s3} to uf_casinosum("reaction")
    uf_abtn({_p}, {_g}, 20, diamond, "&bスロット", "%uf_onoff({uf::cfg::casino::slot::enabled})%|%{_s1}%|&eクリックで設定", "open/casinogame/slot")
    uf_abtn({_p}, {_g}, 22, red wool, "&cルーレット", "%uf_onoff({uf::cfg::casino::roulette::enabled})%|%{_s2}%|&eクリックで設定", "open/casinogame/roulette")
    uf_abtn({_p}, {_g}, 24, clock, "&a反応速度ゲーム", "%uf_onoff({uf::cfg::casino::reaction::enabled})%|%{_s3}%|&eクリックで設定", "open/casinogame/reaction")
    set {_s4} to uf_casinosum("dice")
    set {_s5} to uf_casinosum("highlow")
    set {_s6} to uf_casinosum("gacha")
    uf_abtn({_p}, {_g}, 29, white wool, "&fサイコロ", "%uf_onoff({uf::cfg::casino::dice::enabled})%|%{_s4}%|&eクリックで設定", "open/casinogame/dice")
    uf_abtn({_p}, {_g}, 31, paper, "&eハイ＆ロー", "%uf_onoff({uf::cfg::casino::highlow::enabled})%|%{_s5}%|&eクリックで設定", "open/casinogame/highlow")
    uf_abtn({_p}, {_g}, 33, ender chest, "&dガチャ", "%uf_onoff({uf::cfg::casino::gacha::enabled})%|%{_s6}%|&eクリックで設定", "open/casinogame/gacha")
    set {_s7} to uf_casinosum("target")
    set {_s8} to uf_casinosum("timed")
    uf_abtn({_p}, {_g}, 38, target, "&c的当て", "%uf_onoff({uf::cfg::casino::target::enabled})%|%{_s7}%|&eクリックで設定", "open/casinogame/target")
    uf_abtn({_p}, {_g}, 42, clock, "&b時間制限チャレンジ", "%uf_onoff({uf::cfg::casino::timed::enabled})%|%{_s8}%|&eクリックで設定", "open/casinogame/timed")
    uf_abtn({_p}, {_g}, 40, emerald block, "&dカジノ限定ショップ", "&7チップで交換する商品の販売と価格", "open/cshop")
    uf_ashow({_p}, {_g}, "hub")

# 設定と集計の要約（"|" 区切り）
function uf_casinosum(gm: text) :: text:
    if {_gm} is "gacha":
        set {_t} to "&71 回 %{uf::cfg::casino::gacha::cost}% チップ / 景品はアイテム"
        set {_n} to {uf::cstat::gacha::plays}
        if {_n} is not set:
            set {_n} to 0
        return "%{_t}%|&7実績: %{_n}%回"
    if {_gm} is "reaction":
        set {_t} to "&7制限時間 %{uf::cfg::casino::reaction::window}% tick / 倍率 %{uf::cfg::casino::reaction::mult}%"
    else if {_gm} is "dice":
        set {_rtp} to round({uf::cfg::casino::dice::mult} / 6 * 1000) / 10
        set {_t} to "&7当選 1/6 / 倍率 %{uf::cfg::casino::dice::mult}% / 理論還元率 %{_rtp}%％"
    else if {_gm} is "highlow":
        set {_t} to "&7倍率 = %{uf::cfg::casino::highlow::mult}% ÷ 当たる確率 / 理論還元率 %{uf::cfg::casino::highlow::mult} * 100%％"
    else if {_gm} is "target":
        set {_t} to "&7%{uf::cfg::casino::target::time}% 秒で %{uf::cfg::casino::target::goal}% 個 → %{uf::cfg::casino::target::mult}% 倍（半分以上で返金）"
    else if {_gm} is "timed":
        set {_t} to "&7%{uf::cfg::casino::timed::time}% 秒以内に 1→9 → %{uf::cfg::casino::timed::mult}% 倍"
    else:
        set {_rtp} to {uf::cfg::casino::%{_gm}%::prob} * {uf::cfg::casino::%{_gm}%::mult}
        set {_t} to "&7当選 %{uf::cfg::casino::%{_gm}%::prob}%％ / 倍率 %{uf::cfg::casino::%{_gm}%::mult}% / 理論還元率 %{_rtp}%％"
    set {_t} to "%{_t}%|&7賭け金 %{uf::cfg::casino::%{_gm}%::min}%〜%{uf::cfg::casino::%{_gm}%::max}%"
    set {_in} to {uf::cstat::%{_gm}%::in}
    set {_out} to {uf::cstat::%{_gm}%::out}
    if {_in} is not set:
        set {_in} to 0
    if {_out} is not set:
        set {_out} to 0
    set {_n} to {uf::cstat::%{_gm}%::plays}
    if {_n} is not set:
        set {_n} to 0
    set {_t} to "%{_t}%|&7実績: %{_n}%回 / 賭け %{_in}% / 払い戻し %{_out}%"
    if {_in} > 0:
        set {_t} to "%{_t}%|&7実際の還元率 %round({_out} / {_in} * 1000) / 10%％"
    return {_t}

function uf_ap_casinogame(p: player, gm: text):
    if {_gm} is not "slot", "roulette", "reaction", "dice", "highlow", "gacha", "target" or "timed":
        uf_ap_casino({_p})
        stop
    set {_g} to uf_apage({_p}, "&4カジノ: %{_gm}%")
    uf_abtn({_p}, {_g}, 4, paper, "&f%{_gm}%", uf_casinosum({_gm}), "")
    if {uf::cfg::casino::%{_gm}%::enabled} is true:
        uf_abtn({_p}, {_g}, 19, lime concrete, "&a営業中", "&eクリックで休止する", "casinotoggle/%{_gm}%")
    else:
        uf_abtn({_p}, {_g}, 19, red concrete, "&c休止中", "&eクリックで営業する", "casinotoggle/%{_gm}%")
    if {_gm} is "gacha":
        uf_abtn({_p}, {_g}, 22, gold nugget, "&e1 回のチップ", "&7現在: %{uf::cfg::casino::gacha::cost}%|&eクリックで変更", "edit/casino/gacha/cost")
        uf_ashow({_p}, {_g}, "casino")
        stop
    if {_gm} is "reaction":
        uf_abtn({_p}, {_g}, 21, clock, "&e制限時間（tick）", "&7現在: %{uf::cfg::casino::reaction::window}%|&7緑になってからこの時間内なら成功|&eクリックで変更", "edit/casino/reaction/window")
    else if {_gm} is "dice" or "highlow":
        uf_abtn({_p}, {_g}, 21, ender eye, "&7当選確率", "&7ゲームの仕組みで決まる（変えられない）", "")
    else if {_gm} is "target" or "timed":
        uf_abtn({_p}, {_g}, 21, clock, "&e制限時間（秒）", "&7現在: %{uf::cfg::casino::%{_gm}%::time}%|&eクリックで変更", "edit/casino/%{_gm}%/time")
        if {_gm} is "target":
            uf_abtn({_p}, {_g}, 20, target, "&e目標の数", "&7現在: %{uf::cfg::casino::target::goal}%|&eクリックで変更", "edit/casino/target/goal")
    else:
        uf_abtn({_p}, {_g}, 21, ender eye, "&e当選確率（％）", "&7現在: %{uf::cfg::casino::%{_gm}%::prob}%|&eクリックで変更", "edit/casino/%{_gm}%/prob")
    uf_abtn({_p}, {_g}, 22, gold ingot, "&e払い戻し倍率", "&7現在: %{uf::cfg::casino::%{_gm}%::mult}%|&eクリックで変更", "edit/casino/%{_gm}%/mult")
    uf_abtn({_p}, {_g}, 24, gold nugget, "&e最低賭け金", "&7現在: %{uf::cfg::casino::%{_gm}%::min}%|&eクリックで変更", "edit/casino/%{_gm}%/min")
    uf_abtn({_p}, {_g}, 25, gold block, "&e最高賭け金", "&7現在: %{uf::cfg::casino::%{_gm}%::max}%|&eクリックで変更", "edit/casino/%{_gm}%/max")
    uf_ashow({_p}, {_g}, "casino")

function uf_ap_sell(p: player):
    set {_g} to uf_apage({_p}, "&4売却価格（クリックで設定）")
    set {_s} to 0
    loop {uf::sell::*}:
        if {_s} < 45:
            set {_icon} to loop-index parsed as item type
            if {_icon} is not set:
                set {_icon} to paper
            set {_cat} to {uf::sellcat::%loop-index%}
            uf_abtn({_p}, {_g}, {_s}, {_icon}, "&f%loop-index%", "&7価格: &e%loop-value%pt|&7分類: %{_cat}%|&eクリックで設定", "open/sellitem/%loop-index%")
            add 1 to {_s}
    uf_abtn({_p}, {_g}, 51, hopper, "&a手に持っているアイテムを登録・変更", "&7メニューを開く前に、登録したいアイテムを手に持っておく", "selladd")
    uf_ashow({_p}, {_g}, "hub")

function uf_ap_sellitem(p: player, k: text):
    set {_g} to uf_apage({_p}, "&4売却: %{_k}%")
    set {_icon} to {_k} parsed as item type
    if {_icon} is not set:
        set {_icon} to paper
    set {_v} to {uf::sell::%{_k}%}
    if {_v} is not set:
        set {_v} to 0
    uf_abtn({_p}, {_g}, 4, {_icon}, "&f%{_k}%", "&7価格: %{_v}%pt / 分類: %{uf::sellcat::%{_k}%}%", "")
    uf_abtn({_p}, {_g}, 20, gold nugget, "&e価格（1個あたり）", "&7現在: %{_v}%pt|&eクリックで変更", "edit/sell/%{_k}%")
    uf_abtn({_p}, {_g}, 22, name tag, "&e分類（クエスト用）", "&7現在: %{uf::sellcat::%{_k}%}%|&7crop=作物 / fish=魚 / ore=鉱石 / wood=木材 / none=なし|&eクリックで切り替え", "sellcat/%{_k}%")
    uf_abtn({_p}, {_g}, 24, tnt, "&c売却できなくする", "&7確認画面が出ます", "ask/%{_k}% を売却できなくする|selldel/%{_k}%")
    uf_ashow({_p}, {_g}, "sell")

# ------------------------------------------------------------
# 各種設定（カテゴリ → 項目 → 数値エディタ）
# ------------------------------------------------------------
function uf_cfgkeys(cat: text) :: texts:
    if {_cat} is "reward":
        return "reward::normal", "reward::strong", "reward::elite", "reward::mid", "reward::boss", "clear_pt::2", "clear_pt::3", "clear_pt::4", "clear_pt::5", "clear_pt::6", "clear_pt::7", "clear_pt::8", "clear_pt::9", "repeat_rate", "session_minutes", "warp_seconds", "party_max" and "floor_parties"
    if {_cat} is "death":
        return "death_loss_scope", "death_loss_rate", "revive_seconds", "revive_range" and "soul_seconds"
    if {_cat} is "chest":
        return "chest::min", "chest::max", "chest::shift", "rarity::normal", "rarity::rare", "rarity::epic" and "rarity::legendary"
    if {_cat} is "tools":
        return "tree::max", "tree::height", "tree::radius", "ore::radius", "ore::seconds", "hook::range" and "hook::cooldown"
    if {_cat} is "weapons":
        return "power::weapon", "power::armor", "power::mob_hp", "gun_scope", "gun::gun_handgun::dmg", "gun::gun_handgun::cd", "gun::gun_handgun::ammo", "gun::gun_rifle::dmg", "gun::gun_rifle::cd", "gun::gun_rifle::ammo", "gun::gun_shotgun::dmg", "gun::gun_shotgun::cd", "gun::gun_shotgun::ammo", "gun::gun_shotgun::pellets", "gun::gun_energy::dmg", "gun::gun_energy::cd", "melee::melee_basic" and "melee::melee_adv"
    if {_cat} is "rpg":
        return "level::max", "level::base", "level::step" and "skill_reset_cost"
    return "chip_rate" and "sell_daily_cap"

function uf_cfgcatname(cat: text) :: text:
    if {_cat} is "reward":
        return "ダンジョンの報酬"
    if {_cat} is "death":
        return "死亡・回収・蘇生"
    if {_cat} is "chest":
        return "宝箱"
    if {_cat} is "tools":
        return "特殊道具"
    if {_cat} is "weapons":
        return "特殊武器"
    if {_cat} is "rpg":
        return "レベル・スキル"
    return "経済"

function uf_cfglabel(k: text) :: text:
    if {_k} is "power::weapon":
        return "武器のダメージの倍率（全部の武器・銃・ボム）"
    if {_k} is "power::armor":
        return "防具の守りの倍率（1 つごと。合計は最大 60％）"
    if {_k} is "power::mob_hp":
        return "ダンジョンの敵の体力の倍率"
    if {_k} starts with "clear_pt::":
        return "%last 1 characters of {_k}%階の初回クリア報酬（pt）"
    if {_k} starts with "gun::":
        set {_x::*} to split {_k} at "::"
        set {_n} to uncolored uf_shopname({_x::2})
        if {_x::3} is "dmg":
            return "%{_n}% ダメージ"
        if {_x::3} is "cd":
            return "%{_n}% 発射間隔（tick）"
        if {_x::3} is "ammo":
            return "%{_n}% 1発の弾薬消費"
        if {_x::3} is "pellets":
            return "%{_n}% 散弾の数"
        return "%{_n}% 弾速"
    if {_k} is "reward::normal":
        return "通常敵の討伐報酬（pt）"
    if {_k} is "reward::strong":
        return "強化敵の討伐報酬（pt）"
    if {_k} is "reward::elite":
        return "エリート敵の討伐報酬（pt）"
    if {_k} is "reward::mid":
        return "中ボスの討伐報酬（pt）"
    if {_k} is "reward::boss":
        return "階層ボスの討伐報酬（pt）"
    if {_k} is "repeat_rate":
        return "再挑戦報酬の割合（初回報酬に対して）"
    if {_k} is "session_minutes":
        return "挑戦の制限時間（分）"
    if {_k} is "warp_seconds":
        return "帰還の書で復帰地点に戻れる間隔（秒）"
    if {_k} is "farspawn_dist":
        return "初期スポーン地点の、ロビーからの距離（ブロック）"
    if {_k} is "floor_parties":
        return "1 つの階に同時に入れるパーティーの数"
    if {_k} is "party_max":
        return "パーティーの最大人数"
    if {_k} is "death_loss_scope":
        return "死亡でポイントを失う範囲"
    if {_k} is "death_loss_rate":
        return "死亡で失うポイントの割合"
    if {_k} is "revive_seconds":
        return "蘇生に必要な時間（秒）"
    if {_k} is "revive_range":
        return "蘇生できる距離（ブロック）"
    if {_k} is "soul_seconds":
        return "蘇生を受け付ける時間（秒）"
    if {_k} is "chest::min":
        return "1回の挑戦で置く宝箱の最小数"
    if {_k} is "chest::max":
        return "1回の挑戦で置く宝箱の最大数"
    if {_k} is "chest::shift":
        return "階が上がるごとのレア度の上がり方"
    if {_k} is "rarity::normal":
        return "ノーマルの重み（2階）"
    if {_k} is "rarity::rare":
        return "レアの重み（2階）"
    if {_k} is "rarity::epic":
        return "エピックの重み（2階）"
    if {_k} is "rarity::legendary":
        return "レジェンダリーの重み（2階）"
    if {_k} is "tree::max":
        return "木こり斧: 一度に切る最大数"
    if {_k} is "tree::height":
        return "木こり斧: 最大の高さ"
    if {_k} is "tree::radius":
        return "木こり斧: 水平の範囲"
    if {_k} is "ore::radius":
        return "鉱石探知: 半径（重くなるので注意）"
    if {_k} is "ore::seconds":
        return "鉱石探知: 効果時間（秒）"
    if {_k} is "hook::range":
        return "フック: 届く距離"
    if {_k} is "hook::cooldown":
        return "フック: 再使用までの時間（tick）"
    if {_k} is "gun_scope":
        return "銃を使える場所"
    if {_k} is "melee::melee_basic":
        return "電研ブレードのダメージ倍率"
    if {_k} is "melee::melee_adv":
        return "蒼刃のダメージ倍率"
    if {_k} is "level::max":
        return "レベルの上限"
    if {_k} is "level::base":
        return "Lv1→2 に必要な経験値"
    if {_k} is "level::step":
        return "レベルごとの必要経験値の増加"
    if {_k} is "skill::max":
        return "スキルの最大段階"
    if {_k} is "skill_reset_cost":
        return "スキル振り直しの費用（pt）"
    if {_k} is "chip_rate":
        return "1pt あたりのチップ枚数（0 で交換停止）"
    if {_k} is "sell_daily_cap":
        return "1日の売却上限（pt、0 で無制限）"
    return {_k}

function uf_ap_cfg(p: player):
    set {_g} to uf_apage({_p}, "&4各種設定")
    uf_abtn({_p}, {_g}, 19, gold ingot, uf_cfgcatname2("reward"), "&7討伐・クリア報酬、制限時間、人数", "open/cfgcat/reward")
    uf_abtn({_p}, {_g}, 20, skeleton skull, uf_cfgcatname2("death"), "&7ポイントを失う範囲・割合、蘇生", "open/cfgcat/death")
    uf_abtn({_p}, {_g}, 21, chest, uf_cfgcatname2("chest"), "&7宝箱の数とレア度", "open/cfgcat/chest")
    uf_abtn({_p}, {_g}, 22, diamond pickaxe, uf_cfgcatname2("tools"), "&7木こり斧・鉱石探知・フック", "open/cfgcat/tools")
    uf_abtn({_p}, {_g}, 23, iron sword, uf_cfgcatname2("weapons"), "&7銃・近接武器", "open/cfgcat/weapons")
    uf_abtn({_p}, {_g}, 24, book, uf_cfgcatname2("rpg"), "&7レベル上限・必要経験値・スキル", "open/cfgcat/rpg")
    uf_abtn({_p}, {_g}, 25, emerald, uf_cfgcatname2("economy"), "&7チップ交換・売却上限", "open/cfgcat/economy")
    uf_ashow({_p}, {_g}, "hub")

function uf_ap_cfgcat(p: player, cat: text):
    set {_g} to uf_apage({_p}, "&4設定: %uf_cfgcatname({_cat})%")
    set {_s} to 0
    loop uf_cfgkeys({_cat}):
        set {_k} to loop-value
        set {_v} to {uf::cfg::%{_k}%}
        if {_k} is "death_loss_scope" or "gun_scope":
            uf_abtn({_p}, {_g}, {_s}, name tag, "&e%uf_cfglabel({_k})%", "&7現在: &f%uf_scopename({_v})%|&eクリックで切り替え", "cyc/%{_k}%")
        else:
            uf_abtn({_p}, {_g}, {_s}, paper, "&e%uf_cfglabel({_k})%", "&7現在: &f%{_v}%|&7範囲: %uf_cfgmin({_k})%〜%uf_cfgmax({_k})%|&eクリックで変更", "edit/cfg/%{_k}%")
        add 1 to {_s}
    uf_ashow({_p}, {_g}, "cfg")

function uf_scopename(v: text) :: text:
    if {_v} is "dungeon":
        return "ダンジョンのみ"
    if {_v} is "all":
        return "すべてのワールド"
    if {_v} is "none":
        return "なし"
    return {_v}

function uf_cfgdec(k: text) :: boolean:
    if {_k} is "death_loss_rate", "repeat_rate", "chest::shift" or "chip_rate":
        return true
    if {_k} starts with "power::":
        return true
    if {_k} starts with "melee::":
        return true
    if {_k} starts with "rarity::":
        return true
    if {_k} ends with "::speed":
        return true
    return false

function uf_cfgmin(k: text) :: number:
    if {_k} starts with "power::":
        return 0.1
    if {_k} is "farspawn_dist":
        return 200
    if {_k} is "floor_parties":
        return 1
    if {_k} is "party_max", "revive_seconds", "revive_range", "tree::max", "tree::height", "tree::radius", "ore::radius", "level::max", "level::base", "skill::max" or "session_minutes":
        return 1
    if {_k} ends with "::cd":
        return 1
    if {_k} ends with "::pellets":
        return 1
    if {_k} is "soul_seconds" or "ore::seconds":
        return 5
    if {_k} is "hook::range":
        return 5
    return 0

function uf_cfgmax(k: text) :: number:
    if {_k} starts with "power::":
        return 10
    if {_k} is "death_loss_rate" or "repeat_rate":
        return 1
    if {_k} starts with "rarity::":
        return 100
    if {_k} is "chest::shift":
        return 5
    if {_k} is "chest::min" or "chest::max":
        return 5
    if {_k} is "chip_rate":
        return 100
    if {_k} starts with "melee::":
        return 10
    if {_k} ends with "::speed":
        return 6
    if {_k} ends with "::pellets" or "::ammo":
        return 10
    if {_k} ends with "::dmg":
        return 100
    if {_k} ends with "::cd":
        return 200
    if {_k} is "party_max":
        return 10
    if {_k} is "revive_seconds":
        return 60
    if {_k} is "revive_range" or "tree::radius":
        return 8
    if {_k} is "soul_seconds" or "ore::seconds":
        return 300
    if {_k} is "tree::max":
        return 256
    if {_k} is "tree::height":
        return 64
    if {_k} is "ore::radius":
        return 16
    if {_k} is "hook::range":
        return 64
    if {_k} is "hook::cooldown":
        return 200
    if {_k} is "session_minutes":
        return 120
    if {_k} is "warp_seconds":
        return 600
    if {_k} is "farspawn_dist":
        return 20000
    if {_k} is "floor_parties":
        return 9
    if {_k} is "level::max":
        return 200
    if {_k} is "skill::max":
        return 20
    return 1000000

# ------------------------------------------------------------
# プレイヤー・区域・イベント・アイテム・履歴
# ------------------------------------------------------------
function uf_ap_players(p: player):
    set {_g} to uf_apage({_p}, "&4プレイヤー（オンライン）")
    set {_s} to 0
    loop all players:
        if {_s} < 45:
            set {_u} to uuid of loop-player
            set {-uf::apl::%{_u}%} to loop-player
            uf_abtn({_p}, {_g}, {_s}, skull of loop-player, "&f%loop-player%", "&7pt %uf_pt(loop-player)% / チップ %uf_chip(loop-player)% / Lv %uf_lvof(loop-player)%|&eクリックで詳細", "open/player/%{_u}%")
            add 1 to {_s}
    uf_ashow({_p}, {_g}, "hub")

function uf_ap_player(p: player, u: text):
    set {_t} to {-uf::apl::%{_u}%}
    if {_t} is not set:
        uf_ap_players({_p})
        stop
    if {_t} is not online:
        uf_msg({_p}, "&cそのプレイヤーはオフラインです")
        uf_ap_players({_p})
        stop
    set {_g} to uf_apage({_p}, "&4プレイヤー: %{_t}%")
    set {_cl} to ""
    loop integers between 2 and 9:
        if {uf::clear::%{_u}%::%loop-value%} is true:
            set {_cl} to "%{_cl}%%loop-value% "
    set {_info} to "&7Lv %uf_lvof({_t})% / 挑戦できる最上階 %uf_unlock({_t})%階|&7初回クリア済み: %{_cl}%|&7回収待ち: %size of {uf::recidx::%{_u}%::*}%件|&7挑戦中の階: %uf_sf({-uf::insess::%{_u}%})%"
    uf_abtn({_p}, {_g}, 4, skull of {_t}, "&f%{_t}%", {_info}, "")
    uf_abtn({_p}, {_g}, 20, gold nugget, "&eポイント", "&7現在: %uf_pt({_t})%|&eクリックで変更（記録が残ります）", "edit/pt/%{_u}%")
    uf_abtn({_p}, {_g}, 22, gold ingot, "&eカジノチップ", "&7現在: %uf_chip({_t})%|&eクリックで変更（記録が残ります）", "edit/chip/%{_u}%")
    uf_abtn({_p}, {_g}, 24, oak door, "&e挑戦できる最上階", "&7現在: %uf_unlock({_t})%階|&eクリックで変更", "edit/unlock/%{_u}%")
    if {-uf::insess::%{_u}%} is set:
        uf_abtn({_p}, {_g}, 31, barrier, "&cダンジョンから退出させる", "&7確認画面が出ます", "ask/%{_t}% をダンジョンから退出させる|pleave/%{_u}%")
    if {_p} is op:
        if {_t} is {_p}:
            uf_abtn({_p}, {_g}, 33, nether star, "&7OP: あり（自分）", "&7自分の OP はここでは外せません", "")
        else if {_t} is op:
            uf_abtn({_p}, {_g}, 33, nether star, "&cOP を外す", "&7今は OP あり|&7確認画面が出ます", "ask/%{_t}% の OP を外す|opset/%{_u}%/off")
        else:
            uf_abtn({_p}, {_g}, 33, nether star, "&eOP を付ける", "&7今は OP なし|&7すべてのコマンドと管理者ツールが使えるようになる|&7確認画面が出ます", "ask/%{_t}% に OP を付ける|opset/%{_u}%/on")
    uf_ashow({_p}, {_g}, "players")

# ランキングの掲示板（uf_16_board.sk）
function uf_ap_boards(p: player):
    set {_g} to uf_apage({_p}, "&4ランキングの掲示板")
    set {_s} to 10
    loop uf_boardsrcs():
        set {_src} to loop-value
        if {uf::board::%{_src}%::loc} is set:
            set {_st} to "&a置いてある: %uf_locstr({uf::board::%{_src}%::loc})%"
        else:
            set {_st} to "&7まだ置いていない"
        uf_abtn({_p}, {_g}, {_s}, oak sign, "&e%uf_rankname({_src})%", "%{_st}%|&e壁を見ながら押すと、その壁に貼る（置き直すと前のものは消える）|&7文字は下の端から上に伸びる。上位 10 人で高さ 3 ブロックほど", "boardset/%{_src}%")
        if {uf::board::%{_src}%::loc} is set:
            uf_abtn({_p}, {_g}, {_s} + 9, tnt, "&c%uf_rankname({_src})% を消す", "&7確認画面が出ます", "ask/%uf_rankname({_src})% の掲示板を消す|boarddel/%{_src}%")
        add 1 to {_s}
    uf_abtn({_p}, {_g}, 31, clock, "&e今すぐ書き直す", "&7ふだんは 1 分ごとに書き直す", "boardnow")
    uf_ashow({_p}, {_g}, "hub")

# NPC（uf_17_npc.sk）
function uf_ap_npcs(p: player):
    set {_g} to uf_apage({_p}, "&4NPC（受付・ショップ・カジノ・鍛冶屋・スキル）")
    set {_s} to 11
    loop "reception", "shop", "casino", "smith" and "skill":
        set {_k} to loop-value
        uf_abtn({_p}, {_g}, {_s}, villager spawn egg, "%uf_npcname({_k})% &eを置く", "&7今いる場所に、今向いている方向を向けて置く|&7読み込まれている範囲にいる数: %uf_npccount({_k})%", "npcset/%{_k}%")
        add 2 to {_s}
    uf_abtn({_p}, {_g}, 31, tnt, "&c近くの NPC を消す", "&73 ブロック以内の NPC を消す|&7確認画面が出ます", "ask/近く（3 ブロック以内）の NPC を消す|npcdel")
    uf_ashow({_p}, {_g}, "hub")

# 地下カジノ（uf_25_casinohall.sk）
function uf_ap_chall(p: player):
    set {_g} to uf_apage({_p}, "&4地下カジノ")
    if {uf::chall::built} is set:
        set {_st} to "&a作ってある（%{uf::chall::built}%）"
    else:
        set {_st} to "&7まだ作っていない"
    uf_abtn({_p}, {_g}, 4, gilded blackstone, "&e地下カジノ", "%{_st}%|&715号館の 1 階の西の端の階段から下りた先|&7中は x -276〜-233・y 56〜60・z 94〜124", "")
    uf_abtn({_p}, {_g}, 11, gold block, "&a地下カジノを作る", "&7階段の先の土を掘って、部屋・台・浮かぶ文字・カジノの NPC を置く|&7もう作ってあれば、作り直す（台を置き直す）|&7カジノの区域をこの部屋にする|&7確認画面が出ます", "ask/15号館の地下を掘ってカジノを作る（作り直す）|chall/build")
    uf_abtn({_p}, {_g}, 13, ender pearl, "&e地下カジノへ行く", "&7入口（階段の下）へ移動", "chall/tp")
    uf_abtn({_p}, {_g}, 15, dirt, "&c地下カジノを埋め戻す", "&7部屋を土に戻し、台・浮かぶ文字・NPC・カジノの区域を消す|&7確認画面が出ます", "ask/地下カジノを土で埋め戻す|chall/fill")
    uf_ashow({_p}, {_g}, "hub")

# OP の一覧（オフラインの人も含む）。OP の人だけが開ける
function uf_ap_ops(p: player):
    if {_p} is not op:
        uf_ap_hub({_p})
        stop
    set {_g} to uf_apage({_p}, "&4OP の一覧")
    set {_s} to 0
    loop all operators:
        if {_s} < 45:
            set {_u} to uuid of loop-value
            set {-uf::aop::%{_u}%} to loop-value
            if loop-value is online:
                set {_st} to "&aオンライン"
            else:
                set {_st} to "&7オフライン"
            if {_u} is "%uuid of {_p}%":
                uf_abtn({_p}, {_g}, {_s}, player head, "&f%loop-value%（自分）", "%{_st}%|&7自分の OP はここでは外せません", "")
            else:
                uf_abtn({_p}, {_g}, {_s}, player head, "&f%loop-value%", "%{_st}%|&eクリックで OP を外す|&7確認画面が出ます", "ask/%loop-value% の OP を外す|opset/%{_u}%/off")
            add 1 to {_s}
    uf_ashow({_p}, {_g}, "hub")

