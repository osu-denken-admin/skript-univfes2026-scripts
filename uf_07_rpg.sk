# ============================================================
# uf_07_rpg.sk : レベル・経験値・スキルツリー（数値の多くは管理者ツールの設定 → レベル・スキルで変えられる）
#   必要経験値 = level::base + level::step × (現在レベル - 1)
#   経験値はダンジョン（討伐・突破）とクエストから。レベルアップごとにスキルポイント 1
#   スキルポイントはカジノ限定ショップの「スキルの霊薬」（sp_potion）でも増える
#   スキルはダンジョンの外でも効く（rpg モジュールで動く）
#
#   スキルツリー（2026-10-28 に作り直し。画面は実績の画面のように、上の段がタブ、まん中の段が線でつないだ木）
#     系統（タブ）ごとに 3〜4 個のスキルが左から右に並び、左のスキルを 1 段階でも取ると右のスキルが開く
#     最後の ★ は奥義。保存は {uf::skill::<uuid>::<スキル>}（前からの hp・atk・def・gather はそのまま）
#     戦士 war   : atk 攻撃強化(5) → crit 会心(3) → drain 吸収(3) → berserk ★狂戦士(1)
#     守護 guard : hp 体力強化(5) → def 守り(5) → regen 再生(3) → endure ★不屈(1)
#     探索 explore: run 俊足(2) → gather 商売上手(5) → luck 幸運(3) → treasure ★宝探しの名人(1)
#     釣り fish  : angler 釣り上手(2) → bigcatch 大漁(1) → fishtreasure 海の宝(1) → frenzy ★入れ食い(1)
#     採掘 mine  : miner 採掘の心得(2) → vein 鉱脈の勘(1) → stonegem 石の中の宝(1) → oresense ★鉱脈探知(1)
#     農林 farm  : lumber 木こりの心得(2) → harvest 豊作(1) → replant 植え直し(1) → greenhand ★緑の手(1)
#     生活 life  : featherfall 身軽(1) → hearty 腹持ち(1) → nightsight 夜目(1)
#   開き方: スキルの受付（NPC。uf_17_npc.sk）か /skill
#   振り直し: skill_reset_cost ポイントで、使ったスキルポイントを全部返す
# ============================================================

function uf_lvof(p: player) :: number:
    set {_v} to {uf::lv::%uuid of {_p}%}
    if {_v} is not set:
        return 1
    return {_v}

function uf_need(lv: number) :: number:
    return {uf::cfg::level::base} + {uf::cfg::level::step} * ({_lv} - 1)

function uf_skill(p: player, s: text) :: number:
    set {_v} to {uf::skill::%uuid of {_p}%::%{_s}%}
    if {_v} is not set:
        return 0
    return {_v}

function uf_addxp(p: player, n: number):
    if uf_on("rpg") is false:
        stop
    set {_n} to floor({_n})
    if {_n} <= 0:
        stop
    set {_u} to uuid of {_p}
    set {_lv} to uf_lvof({_p})
    if {_lv} >= {uf::cfg::level::max}:
        stop
    add {_n} to {uf::xp::%{_u}%}
    while {uf::xp::%{_u}%} >= uf_need({_lv}):
        remove uf_need({_lv}) from {uf::xp::%{_u}%}
        add 1 to {_lv}
        set {uf::lv::%{_u}%} to {_lv}
        add 1 to {uf::sp::%{_u}%}
        send title "&6LEVEL UP!" with subtitle "&eLv.%{_lv}%（スキルポイント +1）" to {_p} for 2 seconds
        uf_log("rpg", "levelup %{_p}% (%{_u}%) lv=%{_lv}%")
        if {_lv} >= {uf::cfg::level::max}:
            set {uf::xp::%{_u}%} to 0
            exit loop
    uf_achcheck({_p})

# 体力強化 1 段階につきハート 2 つ（2026-10-28 に 1 → 2）
function uf_applyhp(p: player):
    if uf_on("rpg") is false:
        stop
    set max health of {_p} to 10 + 2 * uf_skill({_p}, "hp")

on join:
    wait 1 tick
    if player is online:
        uf_applyhp(player)

on respawn:
    wait 1 tick
    if player is online:
        uf_applyhp(player)

# ------------------------------------------------------------
# スキルの表
# ------------------------------------------------------------
function uf_sktabs() :: texts:
    return "war", "guard", "explore", "fish", "mine", "farm" and "life"

function uf_sktabname(t: text) :: text:
    if {_t} is "war":
        return "&c戦士"
    if {_t} is "guard":
        return "&9守護"
    if {_t} is "explore":
        return "&a探索"
    if {_t} is "fish":
        return "&b釣り"
    if {_t} is "mine":
        return "&7採掘"
    if {_t} is "farm":
        return "&2農林"
    return "&e生活"

function uf_sktabdesc(t: text) :: text:
    if {_t} is "war":
        return "&7攻撃を強くする"
    if {_t} is "guard":
        return "&7体力と守りを強くする"
    if {_t} is "explore":
        return "&7足の速さ・お金・ドロップ"
    if {_t} is "fish":
        return "&7釣り（ダンジョンの外でも）"
    if {_t} is "mine":
        return "&7鉱石掘り（ダンジョンの外でも）"
    if {_t} is "farm":
        return "&7木こりと畑（ダンジョンの外でも）"
    return "&7暮らしを楽にする"

function uf_sktabicon(t: text) :: item:
    if {_t} is "war":
        return iron sword
    if {_t} is "guard":
        return shield
    if {_t} is "explore":
        return compass
    if {_t} is "fish":
        return fishing rod
    if {_t} is "mine":
        return iron pickaxe
    if {_t} is "farm":
        return wheat
    return bread

# その系統のスキル（左から右の順。左を取ると右が開く）
function uf_sklist(t: text) :: texts:
    if {_t} is "war":
        return "atk", "crit", "drain" and "berserk"
    if {_t} is "guard":
        return "hp", "def", "regen" and "endure"
    if {_t} is "explore":
        return "run", "gather", "luck" and "treasure"
    if {_t} is "fish":
        return "angler", "bigcatch", "fishtreasure" and "frenzy"
    if {_t} is "mine":
        return "miner", "vein", "stonegem" and "oresense"
    if {_t} is "farm":
        return "lumber", "harvest", "replant" and "greenhand"
    return "featherfall", "hearty" and "nightsight"

function uf_skmax(s: text) :: number:
    if {_s} is "atk", "hp", "def" or "gather":
        return 5
    if {_s} is "crit", "drain", "regen" or "luck":
        return 3
    if {_s} is "run", "angler", "miner" or "lumber":
        return 2
    return 1

