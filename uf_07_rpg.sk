        return "&75％ / 段階 の確率でダメージ 1.5 倍"
    if {_s} is "drain":
        return "&7与えたダメージの 3％ / 段階 だけ体力が戻る"
    if {_s} is "berserk":
        return "&7体力が半分以下のとき、与えるダメージ +30％"
    if {_s} is "hp":
        return "&7最大体力 +ハート 2 / 段階"
    if {_s} is "def":
        return "&7受けるダメージ -4％ / 段階"
    if {_s} is "regen":
        return "&7体力が少しずつ戻る（段階が上がるほど速い）"
    if {_s} is "endure":
        return "&7倒れるダメージを 1 回だけ耐える（5 分に 1 回）"
    if {_s} is "run":
        return "&7いつも足が速い（1 段階で速さ I、2 段階で II）"
    if {_s} is "gather":
        return "&7売るときの値段 +3％ / 段階"
    if {_s} is "luck":
        return "&7ダンジョンの敵の素材・レアドロップが +20％ / 段階 出やすい"
    if {_s} is "treasure":
        return "&7ダンジョンの宝箱のポイント 1.5 倍"
    if {_s} is "angler":
        return "&7魚がかかるまでが短くなる（2 段階でもっと短い）"
    if {_s} is "bigcatch":
        return "&7釣れたとき、25％ でもう 1 匹"
    if {_s} is "fishtreasure":
        return "&7釣れたとき、8％ で宝物（名札・鞍・ダイヤなど）"
    if {_s} is "frenzy":
        return "&7投げるとすぐ魚がかかる"
