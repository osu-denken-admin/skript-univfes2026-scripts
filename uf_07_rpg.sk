# すぐ左のスキル（一番左は ""）
function uf_skprev(s: text) :: text:
    loop uf_sktabs():
        set {_l::*} to uf_sklist(loop-value)
        set {_prev} to ""
        loop {_l::*}:
            if loop-value-2 is {_s}:
                return {_prev}
            set {_prev} to loop-value-2
        delete {_l::*}
    return ""

# 取れるか（左のスキルを 1 段階以上取っていれば開く）
function uf_skopen(p: player, s: text) :: boolean:
    set {_prev} to uf_skprev({_s})
    if {_prev} is "":
        return true
    if uf_skill({_p}, {_prev}) >= 1:
        return true
    return false

# 使ったスキルポイントの合計（振り直しで返す）
function uf_skspent(p: player) :: number:
    set {_n} to 0
    loop uf_sktabs():
        loop uf_sklist(loop-value-1):
            add uf_skill({_p}, loop-value-2) to {_n}
    return {_n}

# ------------------------------------------------------------
# スキルツリーの画面（実績の画面のような形）
#   0〜6 系統のタブ / 8 レベル・経験値・スキルポイント
#   18 系統の印、20・22・24・26 スキル（19・21・23・25 は線）/ 49 振り直し
# ------------------------------------------------------------
command /skill [<text>]:
    description: レベルとスキルツリー
    aliases: /level, /lv
    executable by: players
    trigger:
        if uf_on("rpg") is false:
            uf_msg(player, "&cスキルは現在停止中です")
            stop
        uf_skillgui(player)

function uf_skillgui(p: player, tab: text = ""):
    set {_u} to uuid of {_p}
    if {_tab} is "":
        set {_tab} to {-uf::sktab::%{_u}%}
    if {_tab} is not set:
        set {_tab} to "war"
    set {-uf::sktab::%{_u}%} to {_tab}
    set {_g} to chest inventory with 6 rows named "&8スキルツリー：%uncolored uf_sktabname({_tab})%"
    uf_guiclear({_p})
    loop integers between 0 and 53:
        set slot loop-value of {_g} to black stained glass pane named "&8 "
    # タブ
    set {_i} to 0
    loop uf_sktabs():
        set {_t} to loop-value
        if {_t} is {_tab}:
            set slot {_i} of {_g} to ((uf_sktabicon({_t}) with enchantment glint) named "&l%uf_sktabname({_t})%") with lore uf_sktabdesc({_t}) and "&a表示中"
        else:
            set slot {_i} of {_g} to (uf_sktabicon({_t}) named uf_sktabname({_t})) with lore uf_sktabdesc({_t}) and "&eクリックで切り替え"
        set {-uf::guictx::%{_u}%::%{_i}%} to "tab:%{_t}%"
        add 1 to {_i}
    # レベル・経験値・スキルポイント
    set {_lv} to uf_lvof({_p})
    set {_xp} to {uf::xp::%{_u}%}
    if {_xp} is not set:
        set {_xp} to 0
    set {_sp} to {uf::sp::%{_u}%}
    if {_sp} is not set:
        set {_sp} to 0
    set slot 8 of {_g} to bottle o' enchanting named "&eLv.%{_lv}%" with lore "&7経験値: %{_xp}% / %uf_need({_lv})%", "&7スキルポイント: &a%{_sp}%", "&7ダンジョンの討伐・突破とクエストで経験値が入る" and "&7カジノ限定ショップの「スキルの霊薬」でも増える"
    # 系統の印と、スキルの木
    set slot 18 of {_g} to (uf_sktabicon({_tab}) named "&l%uf_sktabname({_tab})%") with lore uf_sktabdesc({_tab}) and "&7左のスキルを取ると、右のスキルが開く"
    set {_s} to 20
    loop uf_sklist({_tab}):
        set {_k} to loop-value
        set {_r} to uf_skill({_p}, {_k})
        set {_mx} to uf_skmax({_k})
        delete {_lore::*}
        add uf_skdesc({_k}) to {_lore::*}
        add "&7段階: &e%{_r}% / %{_mx}%" to {_lore::*}
        if {_r} >= {_mx}:
            add "&a習得済み（最大）" to {_lore::*}
            set {_icon} to (uf_skicon({_k}) with enchantment glint)
            set {_line} to lime stained glass pane
        else if uf_skopen({_p}, {_k}) is true:
            add "&eクリックで習得（スキルポイント 1）" to {_lore::*}
            set {_icon} to uf_skicon({_k})
            if {_r} >= 1:
                set {_line} to lime stained glass pane
            else:
                set {_line} to yellow stained glass pane
        else:
            add "&c%uncolored uf_skname(uf_skprev({_k}))% を取ると開く" to {_lore::*}
            set {_icon} to gray dye
            set {_line} to gray stained glass pane
        set slot {_s} of {_g} to ({_icon} named uf_skname({_k})) with lore {_lore::*}
        set slot ({_s} - 1) of {_g} to {_line} named "&8 "
        set {-uf::guictx::%{_u}%::%{_s}%} to "sk:%{_k}%"
        add 2 to {_s}
    set slot 49 of {_g} to barrier named "&cスキルの振り直し" with lore "&7%{uf::cfg::skill_reset_cost}%pt で、使ったスキルポイントを全部返す"
    uf_gui({_p}, "skill", {_g})

on inventory click:
    {-uf::gui::%uuid of player%} is "skill"
    cancel event
    event-inventory is {-uf::guiinv::%uuid of player%}
    set {_u} to uuid of player
    set {_slot} to index of event-slot
    if {_slot} is 49:
        wait 1 tick
        if player is online:
            uf_skillresetgui(player)
        stop
    set {_c} to {-uf::guictx::%{_u}%::%{_slot}%}
    {_c} is set
    if {_c} starts with "tab:":
        wait 1 tick
        if player is online:
            uf_skillgui(player, last (length of {_c} - 4) characters of {_c})
        stop
    {_c} starts with "sk:"
    set {_s} to last (length of {_c} - 3) characters of {_c}
    if uf_skill(player, {_s}) >= uf_skmax({_s}):
        uf_msg(player, "&eこのスキルは最大段階です")
        stop
    if uf_skopen(player, {_s}) is false:
        uf_msg(player, "&c先に %uf_skname(uf_skprev({_s}))% &cを取ってください")
        stop
    if {uf::sp::%{_u}%} is not set:
        set {uf::sp::%{_u}%} to 0
    if {uf::sp::%{_u}%} < 1:
        uf_msg(player, "&cスキルポイントが足りません（ダンジョンでレベルを上げるか、スキルの霊薬）")
        stop
    remove 1 from {uf::sp::%{_u}%}
    add 1 to {uf::skill::%{_u}%::%{_s}%}
    uf_applyhp(player)
    play sound "entity.player.levelup" with volume 0.6 at player
    uf_msg(player, "&a%uf_skname({_s})% &aを習得した（段階 %uf_skill(player, {_s})%）")
    uf_log("rpg", "skill %player% (%{_u}%) %{_s}%=%uf_skill(player, {_s})%")
    wait 1 tick
    if player is online:
        uf_skillgui(player)

# 振り直しの確認画面
function uf_skillresetgui(p: player):
    set {_g} to chest inventory with 3 rows named "&4本当に振り直しますか？"
    uf_guiclear({_p})
    set slot 11 of {_g} to lime wool named "&a振り直す（%{uf::cfg::skill_reset_cost}%pt）"
    set slot 15 of {_g} to red wool named "&cやめる"
    uf_gui({_p}, "skillreset", {_g})

on inventory click:
    {-uf::gui::%uuid of player%} is "skillreset"
    cancel event
    event-inventory is {-uf::guiinv::%uuid of player%}
    set {_slot} to index of event-slot
    if {_slot} is 15:
        wait 1 tick
        if player is online:
            uf_skillgui(player)
        stop
    {_slot} is 11
    set {_u} to uuid of player
    set {_sum} to uf_skspent(player)
    if {_sum} <= 0:
        uf_msg(player, "&7習得済みのスキルがありません")
        stop
    if uf_takept(player, {uf::cfg::skill_reset_cost}, "skillreset") is false:
        uf_msg(player, "&cポイントが足りません")
        stop
    delete {uf::skill::%{_u}%::*}
    add {_sum} to {uf::sp::%{_u}%}
    uf_applyhp(player)
    uf_msg(player, "&aスキルを振り直した（スキルポイント %{_sum}% を返却）")
    uf_log("rpg", "reset %player% (%{_u}%) sp=%{_sum}%")
    wait 1 tick
    if player is online:
        uf_skillgui(player)

# スキルの霊薬（カジノ限定ショップ。uf_01_items.sk の sp_potion）
on consume:
    set {_id} to uf_id(player's tool)
    if {_id} is "":
        set {_id} to uf_id(offhand tool of player)
    {_id} is "sp_potion"
    add 1 to {uf::sp::%uuid of player%}
    play sound "entity.player.levelup" with volume 0.8 at player
    uf_msg(player, "&dスキルポイントが 1 増えた！（スキルの受付か /skill で使う）")
    uf_log("rpg", "sp_potion %player% (%uuid of player%) sp=%{uf::sp::%uuid of player%}%")

# ------------------------------------------------------------
# 戦い（戦士・守護）
# ------------------------------------------------------------
on damage:
    uf_on("rpg") is true
    set {_a} to attacker
    if {_a} is a player:
        set {_r} to uf_skill({_a}, "atk")
        if {_r} > 0:
            set damage to damage * (1 + 0.04 * {_r})
        if uf_skill({_a}, "berserk") > 0:
            if (health of {_a}) <= (max health of {_a}) / 2:
                set damage to damage * 1.3
        set {_r} to uf_skill({_a}, "crit")
        if {_r} > 0:
            if random number between 0 and 100 < 5 * {_r}:
                set damage to damage * 1.5
                play 8 crit at location of victim
        set {_r} to uf_skill({_a}, "drain")
        if {_r} > 0:
            heal {_a} by damage * 0.03 * {_r}
    set {_v} to victim
    if {_v} is a player:
        set {_r} to uf_skill({_v}, "def")
        if {_r} > 0:
            set damage to damage * max(0.2, 1 - 0.04 * {_r})
        if damage cause is fall:
            if uf_skill({_v}, "featherfall") > 0:
                set damage to damage * 0.5
        # 不屈: 倒れるダメージを 1 回だけ耐える（5 分に 1 回）
        if uf_skill({_v}, "endure") > 0:
            if damage >= health of {_v}:
                set {_ok} to true
                set {_t} to {-uf::endure::%uuid of {_v}%}
                if {_t} is set:
                    if difference between {_t} and now < 5 minutes:
                        set {_ok} to false
                if {_ok} is true:
                    set damage to max(0, (health of {_v}) - 0.5)
                    set {-uf::endure::%uuid of {_v}%} to now
                    play sound "item.totem.use" with volume 0.6 at {_v}
                    uf_msg({_v}, "&6不屈！ 倒れずに踏みとどまった（5 分後にまた使える）")

# ------------------------------------------------------------
# いつも効くもの（再生・俊足・採掘の心得・木こりの心得・夜目）
# ------------------------------------------------------------
every 2 seconds:
    uf_on("rpg") is true
    loop all players:
        set {_p} to loop-player
        set {_r} to uf_skill({_p}, "regen")
        if {_r} > 0:
            if health of {_p} < max health of {_p}:
                heal {_p} by 0.15 * {_r}
        set {_r} to uf_skill({_p}, "run")
        if {_r} >= 2:
            apply speed 2 to {_p} for 3 seconds
        else if {_r} >= 1:
            apply speed 1 to {_p} for 3 seconds
        set {_tt} to "%type of tool of {_p}%"
        set {_r} to 0
        if {_tt} ends with "pickaxe":
            set {_r} to uf_skill({_p}, "miner")
        else if {_tt} ends with " axe":
            set {_r} to uf_skill({_p}, "lumber")
        if {_r} >= 2:
            apply haste 2 to {_p} for 3 seconds
        else if {_r} >= 1:
            apply haste 1 to {_p} for 3 seconds
        if uf_skill({_p}, "nightsight") > 0:
            if light level at {_p} < 7:
                apply night vision 1 to {_p} for 15 seconds

# 腹持ち
every 30 seconds:
    uf_on("rpg") is true
    loop all players:
        if uf_skill(loop-player, "hearty") > 0:
            feed loop-player by 1

# 緑の手: まわりの育っていない作物に、ときどき骨粉
every 10 seconds:
    uf_on("rpg") is true
    loop all players:
        if uf_skill(loop-player, "greenhand") > 0:
            loop blocks in radius 4 around loop-player:
                if uf_cropof("%block data of loop-block%") is not "":
                    if random number between 0 and 1 < 0.25:
                        apply bone meal to loop-block

# ------------------------------------------------------------
# 釣り
# ------------------------------------------------------------
on fishing line cast:
    uf_on("rpg") is true
    # 待ち時間は、最小を先に下げてから最大を下げる（最小 > 最大 にならないように）
    if uf_skill(player, "frenzy") > 0:
        set min fishing wait time to 10 ticks
        set max fishing wait time to 40 ticks
    else if uf_skill(player, "angler") >= 2:
        set min fishing wait time to 2 seconds
        set max fishing wait time to 12 seconds
    else if uf_skill(player, "angler") >= 1:
        set min fishing wait time to 3 seconds
        set max fishing wait time to 20 seconds

on fish caught:
    uf_on("rpg") is true
    if uf_skill(player, "bigcatch") > 0:
        if random number between 0 and 100 < 25:
            set {_f::*} to "cod", "cod", "cod", "salmon", "salmon", "pufferfish" and "tropical fish"
            give ((random element out of {_f::*}) parsed as item type) to player
            uf_msg(player, "&b大漁！ もう 1 匹釣れた")
    if uf_skill(player, "fishtreasure") > 0:
        if random number between 0 and 100 < 8:
            set {_t::*} to "name tag|名札", "saddle|鞍", "nautilus shell|オウムガイの殻", "diamond|ダイヤモンド", "emerald|エメラルド" and "bottle o' enchanting|経験値のビン"
            set {_q::*} to split (random element out of {_t::*}) at "|"
            give ({_q::1} parsed as item type) to player
            play sound "entity.player.levelup" with volume 0.6 at player
            uf_msg(player, "&b海の宝！ &f%{_q::2}% &bを釣り上げた")

# ------------------------------------------------------------
# 採掘・農林（置いたブロックは数えない。uf_11_progress.sk の uf_placed）
# ------------------------------------------------------------
# 作物の名前（育つ作物でなければ ""）
function uf_cropof(bd: text) :: text:
    loop "wheat", "carrots", "potatoes", "beetroots" and "nether_wart":
        if {_bd} starts with "minecraft:%loop-value%[":
            return loop-value
    return ""

function uf_cropripe(bd: text) :: boolean:
    if {_bd} contains "age=7":
        return true
    if {_bd} starts with "minecraft:beetroots[" or "minecraft:nether_wart[":
        if {_bd} contains "age=3":
            return true
    return false

on break:
    uf_on("rpg") is true
    set {_b} to event-block
    metadata value "uf_placed" of {_b} is not set
    set {_t} to "%type of {_b}%"
    set {_l} to location of {_b}
    # 鉱脈の勘
    if {_t} ends with "ore":
        if uf_skill(player, "vein") > 0:
            if random number between 0 and 100 < 20:
                drop (drops of {_b} using player's tool) at {_l}
        stop
    # 石の中の宝
    if {_t} is "stone" or "deepslate":
        if uf_skill(player, "stonegem") > 0:
            if random number between 0 and 100 < 2:
                set {_r} to random number between 0 and 100
                if {_r} < 40:
                    drop 3 iron nuggets at {_l}
                else if {_r} < 70:
                    drop 3 gold nuggets at {_l}
                else if {_r} < 85:
                    drop 2 lapis lazuli at {_l}
                else if {_r} < 95:
                    drop 1 emerald at {_l}
                else:
                    drop 1 diamond at {_l}
        stop
    # 豊作・植え直し（育った作物だけ）
    set {_bd} to "%block data of {_b}%"
    set {_crop} to uf_cropof({_bd})
    {_crop} is not ""
    uf_cropripe({_bd}) is true
    if uf_skill(player, "harvest") > 0:
        if random number between 0 and 100 < 25:
            drop (drops of {_b} using player's tool) at {_l}
    if uf_skill(player, "replant") > 0:
        wait 1 tick
        if block at {_l} is air:
            set block at {_l} to ("minecraft:%{_crop}%[age=0]" parsed as block data)

# 鉱脈探知（ツルハシを持ってしゃがんで右クリック。1 分に 1 回）
on right click:
    uf_on("rpg") is true
    player is sneaking
    "%type of player's tool%" ends with "pickaxe"
    uf_skill(player, "oresense") > 0
    set {_t} to {-uf::oresense::%uuid of player%}
    if {_t} is set:
        if difference between {_t} and now < 1 minute:
            stop
    set {-uf::oresense::%uuid of player%} to now
    uf_oredetect(player)
