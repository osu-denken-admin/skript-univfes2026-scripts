# ============================================================
# uf_15_layout.sk : 15号館 2〜9 階の内装・階段・闘技場に合わせたダンジョン設定（自動生成）
#   tools/dungeon の gen.js / gen_arena.js / preset.js で生成。手で編集しない。
#   管理者ツールの「15号館の内装に合わせて全階を設定」で登録される。
#   偶数階は西の階段から入って東の階段へ、奇数階は東から入って西へ進む。
#   壁（ゲート）の種類: mid = 中ボスの壁 / exit = ボスの壁（上り階段）/ block = 使わない上り階段をふさぐ壁
# ============================================================

function uf_layout_loc(x: number, y: number, z: number) :: location:
    return location({_x}, {_y}, {_z}, world({uf::cfg::world::dungeon}))

