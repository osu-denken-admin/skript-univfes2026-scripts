# ライトブロック（Litematica で貼るとライトが置かれず、もとからあったライトも消えないため、ここで置き直す）
#   内装と闘技場の範囲にあるライトを全部消してから、決まった場所に置く
function uf_layout_unlight(a: location, b: location) :: number:
    set {_n} to 0
    loop all blocks within {_a} and {_b}:
        if loop-block is not air:
            if "%block data of loop-block%" contains "minecraft:light[":
                set loop-block to air
                add 1 to {_n}
    return {_n}

function uf_layout_lights(p: player):
    if {uf::cfg::world::dungeon} is not set:
        uf_msg({_p}, "&c先に「ワールドとロビー」で15号館（ダンジョン）のワールドを登録してください")
        stop
    uf_msg({_p}, "&eライトを置き直しています（少し時間がかかります）")
    set {_del} to 0
    # 2F
    add uf_layout_unlight(uf_layout_loc(-267, 73, 87), uf_layout_loc(-204, 76, 125)) to {_del}
    wait 1 tick
    # 3F
    add uf_layout_unlight(uf_layout_loc(-267, 78, 87), uf_layout_loc(-204, 81, 125)) to {_del}
    wait 1 tick
    # 4F
