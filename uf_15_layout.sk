# ============================================================
# uf_15_layout.sk : 15号館 2〜9 階の内装と闘技場に合わせたダンジョン設定（自動生成）
#   tools/gen.js で生成した内装の座標を、管理者ツールのボタン 1 つで登録する。
#   座標は「15号館（ダンジョン）」として登録したワールドに対して設定される。
#   内装を作り直したら、このファイルも作り直すこと（手で編集しない）。
# ============================================================

function uf_layout_loc(x: number, y: number, z: number) :: location:
    return location({_x}, {_y}, {_z}, world({uf::cfg::world::dungeon}))

